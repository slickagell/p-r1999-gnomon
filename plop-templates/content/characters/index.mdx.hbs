---
title: "{{titleCase name}}"
id: "{{dashCase name}}"
code: "{{constantCase name}}"
star: {{star}}
afflatus: "{{afflatus}}"
dmgType: "{{dmgType}}"
version: "{{version}}"
<!-- TODO - Update specialties, if there's a new specialty, please add it to SPECIALTY in data/characters.ts file -->
specialties: []
isLimited: {{isLimited}}
---

import CharacterImg from "@components/CharacterImg.astro";
import CharacterStar from "@components/CharacterStar.astro";
import { AFFLATUS_TYPE, DMG_TYPE, SPECIALTY } from "@data/character";

# {{titleCase name}}

<div class="my-8">
  <CharacterStar star={frontmatter.star} />
</div>

<div class="flex justify-between flex-col-reverse md:flex-row gap-8">
  <div>
    <div class="flex gap-8 items-center justify-center md:justify-start">
      <CharacterImg variant="afflatus" code={AFFLATUS_TYPE[frontmatter.afflatus].assetCode} />
      <div class="flex gap-2 items-center">
        <CharacterImg variant="dmg-type" code={DMG_TYPE[frontmatter.dmgType].assetCode} />
        ##### {DMG_TYPE[frontmatter.dmgType].title}
      </div>
    </div>
    <div class="mt-2 flex gap-x-1 gap-y-2 justify-center md:justify-start items-center flex-wrap">
      {
        frontmatter.specialties.map((specialty) => (
          <div class="badge badge-lg bg-base-content/10">{SPECIALTY[specialty].title}</div>
      ))}
    </div>
    <div class="mt-4">
      <!-- TODO - Add character description -->

      ###### Medium
      <!-- TODO - Add character medium description -->

      ###### Afflatus
      <!-- TODO - Add character afflatus description -->

      ###### Fragrance note
      <!-- TODO - Add character fragrance description -->

      ###### Dimensions
      <!-- TODO - Add character dimension description -->

    </div>
    <div class="mt-4 flex gap-4 justify-center">
      <CharacterImg variant="signature" id={frontmatter.id} />
    </div>

  </div>
  <div class="flex flex-col items-center">
    <CharacterImg variant="portrait" id={frontmatter.id} />
    <div class="mt-5 flex gap-6 justify-center items-end">
      <div class="text-center">
        <CharacterImg variant="udimo" id={frontmatter.id} />
        Udimo
      </div>
      <div class="text-center">
        <CharacterImg variant="chibi" id={frontmatter.id} />
        Chibi
      </div>
    </div>
  </div>
</div>

