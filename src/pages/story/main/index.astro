---
import CustomImage from "@components/CustomImage.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const mainStoryEntries = await getCollection("mainStory", ({ id: entryId }) => {
  return !entryId.includes("/");
});
---

<Layout
  title="Main Story"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Story",
      href: "/story",
    },
    {
      label: "Main Story",
    },
  ]}
>
  <h1>Main Story</h1>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    {
      mainStoryEntries
        .sort((a, b) => a.data.chapterNumber - b.data.chapterNumber)
        .map((eventEntry) => (
          <a href={`/story/main/${eventEntry.id}`}>
            <div class="card card-compact border border-primary">
              <div class="card-body !py-2">
                <div class="flex gap-4 items-center">
                  <CustomImage
                    class="w-1/4"
                    src={`/images/chapter/${eventEntry.data.pic}`}
                    alt={eventEntry.data.title ?? eventEntry.data.pic}
                  />
                  <div>
                    <h5 class="my-0 text-primary-content font-medium">
                      {eventEntry.data.chapterIndex}
                    </h5>
                    <h2 class="card-title">{eventEntry.data.title}</h2>
                    <p>{eventEntry.data.description}</p>
                  </div>
                </div>
              </div>
            </div>
          </a>
        ))
    }
  </div>
</Layout>
