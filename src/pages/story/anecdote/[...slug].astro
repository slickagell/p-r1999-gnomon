---
import StoryContentWrapper from "@components/StoryMarkdown/StoryContentWrapper.astro";
import StoryMarkdownBlockquote from "@components/StoryMarkdown/StoryMarkdownBlockquote.astro";
import StoryMarkdownDiscList from "@components/StoryMarkdown/StoryMarkdownDiscList.astro";
import StoryMarkdownEmphasis from "@components/StoryMarkdown/StoryMarkdownEmphasis.astro";
import StoryMarkdownHighlight from "@components/StoryMarkdown/StoryMarkdownHighlight.astro";
import StoryMarkdownParagraphContent from "@components/StoryMarkdown/StoryMarkdownParagraphContent.astro";
import StoryMarkdownThematicBreak from "@components/StoryMarkdown/StoryMarkdownThematicBreak.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import fs from "fs";

export async function getStaticPaths() {
  const anecdoteFolders = fs.readdirSync("./src/markdown/story/anecdote");
  return anecdoteFolders.map((folder) => ({
    params: { slug: folder },
    props: { id: folder },
  }));
}

const { id } = Astro.props;
const anecdoteEntries = await getCollection(
  "anecdoteStory",
  ({ id: entryId }) => {
    return entryId.includes(id + "/");
  }
);

const sortedAnecdoteEntries = anecdoteEntries.sort((a, b) => {
  return a.data.chapter - b.data.chapter;
});

const anecdoteChapters = sortedAnecdoteEntries.map((entry, idx) => {
  return {
    id: entry.id.split("/").pop() ?? idx + "",
    chapter: entry.data.chapter,
    title: entry.data.title,
    description: entry.data.description,
  };
});
const anecdotePart = await getEntry("anecdoteStory", id)!;
---

<Layout
  title={`${anecdotePart.data.title} | Anecdote`}
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Story",
      href: "/story",
    },
    {
      label: "Anecdote",
      href: "/story/anecdote",
    },
    {
      label: anecdotePart.data.title,
    },
  ]}
>
  <h1>{anecdotePart.data.title}</h1>

  <StoryContentWrapper chapters={anecdoteChapters}>
    <Fragment slot="story-content">
      {
        sortedAnecdoteEntries.map(async (entry, idx) => {
          const { Content } = await render(entry);

          return (
            <template x-if={`activeChapterIdx === ${idx}`}>
              <div>
                <Content
                  components={{
                    p: StoryMarkdownParagraphContent,
                    strong: StoryMarkdownHighlight,
                    ul: StoryMarkdownDiscList,
                    em: StoryMarkdownEmphasis,
                    hr: StoryMarkdownThematicBreak,
                    blockquote: StoryMarkdownBlockquote,
                  }}
                />
              </div>
            </template>
          );
        })
      }
    </Fragment>
  </StoryContentWrapper>
</Layout>
