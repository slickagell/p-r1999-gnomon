---
import EffectItem from "@components/EffectItem.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import { EffectVirtualList } from "@components/VirtualList";
import { EFFECT_TYPE } from "@data/effect";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const effectEntries = await getCollection("effects");
---

<Layout
  title="Effects | Reverse 1999 Gnomon"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Effects",
    },
  ]}
>
  <h1 class="text-center">Effect List</h1>

  <div x-data={"dataset"}>
    <div class="filters">
      <div class="md:grid md:grid-cols-filter">
        <!-- Type -->
        <div class="py-2 md:px-4">Type</div>
        <ul class="hidden md:flex py-2 px-4 gap-1">
          <template x-for="type in types">
            <li>
              <button
                class="btn btn-outline btn-xs"
                :class="type.code === typeFilter ? 'btn-active' : ''"
                @click="filterType(type.code)"
                x-text="type.title"
              >
              </button>
            </li>
          </template>
        </ul>
        <select
          class="md:hidden select select-secondary w-full"
          @change="filterType($event.target.value)"
        >
          <template x-for="type in types">
            <option
              :value="type.code"
              :selected="type.code === typeFilter"
              x-text="type.title"></option>
          </template>
        </select>
        <!-- End Type -->
      </div>
      <input
        type="text"
        placeholder="Search"
        class="mt-6 mb-4 input input-bordered input-secondary w-full"
        x-model="searchText"
        @change.debounce="search($event.target.value)"
      />
    </div>
    <EffectVirtualList client:only="solid-js">
      <div slot="fallback">
        <span class="loading loading-dots text-primary block mx-auto"></span>
      </div>
      <Fragment slot="effects">
        {
          effectEntries.map((effectEntry) => (
            <EffectItem effectEntry={effectEntry} />
          ))
        }
      </Fragment>
    </EffectVirtualList>
  </div>

  <script>
    import { EFFECT_TYPE } from "@data/effect";
    import { nameFilter, typeFilter } from "@stores/effectFilterStore";
    import Alpine from "alpinejs";

    window.Alpine = Alpine;

    Alpine.data("dataset", () => ({
      searchText: "",
      typeFilter: "ALL",
      types: [
        { title: "All", code: "ALL" },
        ...Object.keys(EFFECT_TYPE).map((code) => ({
          title: EFFECT_TYPE[code].title,
          code,
        })),
      ],

      filterType(type) {
        this.typeFilter = type;
        typeFilter.set(type);
      },

      search(searchText) {
        nameFilter.set(searchText);
      },
    }));
  </script>
</Layout>
