---
import EffectItem from "@components/EffectItem.astro";
import { EffectVirtualList } from "@components/VirtualList";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const typesTotal = {};

const effectEntries = await getCollection("effects", ({ data }) => {
  return !data.isSpecific;
}).then((entries) => {
  return entries.map((effectEntry) => {
    if (effectEntry.data.type in typesTotal) {
      typesTotal[effectEntry.data.type] += 1;
    } else {
      typesTotal[effectEntry.data.type] = 1;
    }

    return effectEntry;
  });
});
---

<Layout
  title="Effects"
  description="Common effect list in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Effects",
    },
  ]}
>
  <h1 class="text-center">Effect List</h1>

  <div x-data={"dataset"}>
    <div class="filters">
      <div class="md:grid md:grid-cols-filter">
        <!-- Type -->
        <div class="py-2 md:px-4">Type</div>
        <ul class="hidden md:flex flex-wrap py-2 px-4 gap-1">
          <template x-for="type in types">
            <li>
              <button
                class="btn btn-outline btn-xs"
                :class="type.code === typeFilter ? 'btn-active' : ''"
                @click="filterType(type.code)"
                x-text="type.title"
              >
              </button>
            </li>
          </template>
        </ul>
        <select
          class="md:hidden select select-secondary w-full"
          @change="filterType($event.target.value)"
        >
          <template x-for="type in types">
            <option
              :value="type.code"
              :selected="type.code === typeFilter"
              x-text="type.title"></option>
          </template>
        </select>
        <!-- End Type -->
      </div>
      <input
        type="text"
        placeholder="Search"
        class="mt-6 mb-4 input input-bordered input-secondary w-full"
        x-model="searchText"
        @change.debounce="search($event.target.value)"
      />
    </div>
    <EffectVirtualList client:only="solid-js">
      <div slot="fallback">
        <span class="loading loading-dots text-primary block mx-auto"></span>
      </div>
      <Fragment slot="effects">
        {
          effectEntries.map((effectEntry) => (
            <EffectItem effectEntry={effectEntry} />
          ))
        }
      </Fragment>
    </EffectVirtualList>
  </div>

  <script
    is:inline
    define:vars={{
      typesTotal,
    }}
  >
    document.addEventListener("alpine:init", () => {
      window.Alpine.store("effects", {
        typesTotal,
      });
    });
  </script>

  <script>
    import EFFECT_TYPE from "@data/common/effect/type.json";
    import { nameFilter, typeFilter } from "@stores/effectFilterStore";
    import Alpine from "alpinejs";
    import anchor from "@alpinejs/anchor";

    Alpine.plugin(anchor);

    Alpine.data("dataset", () => ({
      searchText: "",
      typeFilter: "ALL",
      types: [],

      init() {
        this.types = [
          { title: "All", code: "ALL" },
          ...Object.keys(EFFECT_TYPE)
            .filter(
              (code) =>
                !!this.$store.effects.typesTotal[code] &&
                this.$store.effects.typesTotal[code] > 0,
            )
            .map((code) => ({
              title: EFFECT_TYPE[code].title,
              code,
            })),
        ];
      },

      filterType(type) {
        this.typeFilter = type;
        typeFilter.set(type);
      },

      search(searchText) {
        nameFilter.set(searchText);
      },
    }));
  </script>
</Layout>
