---
import CustomImage from "@components/CustomImage.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import Layout from "@layouts/Layout.astro";
import { render } from "astro:content";
import { getEntry } from "astro:content";
import PERIOD_EVENT_DATA from "@data/timeline/period-event.json";
import "@styles/timeline.css";

const timelineContentEntry = await getEntry("timeline", "general")!;

const { Content } = await render(timelineContentEntry);
---

<Layout
  title="Timeline"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Timeline",
    },
  ]}
>
  <h1>Timeline</h1>
  <div
    class="mt-8"
    x-data="timelineChart"
    x-on:resize.window.debounce="onResize"
  >
    <div id="timeline" class="relative bg-base-content/10"></div>
    <span x-text="'Zoom: ' + parseFloat(scale).toFixed(2)"></span>
    <div class="mt-4 collapse collapse-plus border border-primary bg-base-200">
      <input type="checkbox" class="min-h-10" />
      <div
        class="collapse-title py-0 pt-1 min-h-10 text-lg font-medium after:!top-[0.3125rem] after:!w-auto after:!h-auto"
      >
        Option
      </div>
      <div class="collapse-content">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
          <label class="label justify-start gap-2" for="stormLink">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="stormLink"
              name="stormLink"
              :checked="isShow.stormLink"
              @click="toggleShowStormLink"
            />
            Show storm link
          </label>
          <label class="label justify-start gap-2" for="stormNode">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="stormNode"
              name="stormNode"
              :checked="isShow.stormNode"
              @click="toggleShowStormNode"
            />
            Show storm node
          </label>
          <label class="label justify-start gap-2" for="period">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="period"
              name="period"
              :checked="isShow.period"
              @click="toggleShowPeriod"
            />
            Show period
          </label>
          <label class="label justify-start gap-2" for="mainStoryNode">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="mainStoryNode"
              name="mainStoryNode"
              :checked="isShow.mainStoryNode"
              @click="toggleShowMainStoryNode"
            />
            Show main story node
          </label>
          <label class="label justify-start gap-2" for="eventStoryNode">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="eventStoryNode"
              name="eventStoryNode"
              :checked="isShow.eventStoryNode"
              @click="toggleShowEventStoryNode"
            />
            Show event story node
          </label>
          <label class="label justify-start gap-2" for="characterStoryNode">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="characterStoryNode"
              name="characterStoryNode"
              :checked="isShow.characterStoryNode"
              @click="toggleShowCharacterStoryNode"
            />
            Show character story node
          </label>
          <label class="label justify-start gap-2" for="anecdoteNode">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="anecdoteNode"
              name="anecdoteNode"
              :checked="isShow.anecdoteNode"
              @click="toggleShowAnecdoteNode"
            />
            Show anecdote node
          </label>
          <label class="label justify-start gap-2" for="eventNodeGap">
            <input
              type="checkbox"
              class="toggle toggle-primary"
              id="eventNodeGap"
              name="eventNodeGap"
              :checked="isShow.eventNodeGap"
              @click="toggleShowEventNodeGap"
            />
            Show event gap
          </label>
        </div>
      </div>
    </div>
    <dialog id="node-info-modal" class="modal">
      <div class="modal-box">
        <form method="dialog">
          <button
            class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
          >
            ✕
          </button>
        </form>
        {
          PERIOD_EVENT_DATA.map((period) => {
            return (
              <div x-show={`selectedPeriod === '${period.param}'`}>
                <h3 class="text-primary-content">
                  {period.periodText.join(" - ")}
                </h3>
                <div class="md:mt-4 md:grid md:grid-cols-[max-content_1fr] gap-x-2 gap-y-4">
                  {period.events.map((event) => {
                    return (
                      <>
                        {event.year.map((year) => {
                          return (
                            <>
                              <p class="mt-4">{year}</p>
                              <div>
                                {(() => {
                                  switch (event.type) {
                                    case "event-story":
                                      return (
                                        <p class="text-timeline-event-story">
                                          Event Story
                                        </p>
                                      );
                                    case "character-story":
                                      return (
                                        <p class="text-timeline-character-story">
                                          Character Story
                                        </p>
                                      );
                                    case "anecdote":
                                      return (
                                        <p class="text-timeline-anecdote">
                                          Anecdote
                                        </p>
                                      );
                                    default:
                                      return (
                                        <p class="text-timeline-main-story">
                                          Main Story
                                        </p>
                                      );
                                  }
                                })()}
                                {event.label}
                              </div>
                            </>
                          );
                        })}
                      </>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>
    </dialog>
  </div>
  <div class="mt-8">
    <Content
      components={{
        ul: MarkdownDiscList,
        p: MarkdownParagraphContent,
        img: CustomImage,
        em: MarkdownEmphasis,
      }}
    />
  </div>
</Layout>

<script>
  import timelineChart from "@scripts/timeline-chart";
  import Alpine from "alpinejs";
  import resize from "@alpinejs/resize";

  Alpine.plugin(resize);

  Alpine.data("timelineChart", timelineChart);
</script>
