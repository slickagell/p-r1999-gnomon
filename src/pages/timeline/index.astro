<style>
  .node {
    fill: green;
    stroke: steelblue;
  }

  .arrow {
    stroke: black;
    fill: none;
  }
</style>

<script>
  import timelineChart from "@scripts/timeline-chart";
  import Alpine from "alpinejs";
  import resize from "@alpinejs/resize";

  Alpine.plugin(resize);

  window.Alpine = Alpine;

  Alpine.data("timelineChart", timelineChart);
</script>
