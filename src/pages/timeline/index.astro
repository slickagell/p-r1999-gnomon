---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Timeline"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Timeline",
    },
  ]}
>
  <h1>Timeline</h1>
  <div class="mt-8" x-data="timelineChart">
    <div id="timeline" class="relative bg-base-content/10"></div>
    <span x-text="'Zoom: ' + scale"></span>
  </div>
</Layout>
