---
import CustomImage from "@components/CustomImage.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import Layout from "@layouts/Layout.astro";
import { render } from "astro:content";
import { getEntry } from "astro:content";

const timelineContentEntry = await getEntry("timeline", "general");

const { Content } = await render(timelineContentEntry);
---

<Layout
  title="Timeline"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Timeline",
    },
  ]}
>
  <h1>Timeline</h1>
  <div class="mt-8" x-data="timelineChart">
    <div id="timeline" class="relative bg-base-content/10"></div>
    <span x-text="'Zoom: ' + scale"></span>
  </div>
  <div class="mt-8">
    <Content
      components={{
        ul: MarkdownDiscList,
        p: MarkdownParagraphContent,
        img: CustomImage,
        em: MarkdownEmphasis,
      }}
    />
  </div>
</Layout>
<script>
  import timelineChart from "@scripts/timeline-chart";
  import Alpine from "alpinejs";
  import resize from "@alpinejs/resize";

  Alpine.plugin(resize);

  Alpine.data("timelineChart", timelineChart);
</script>
