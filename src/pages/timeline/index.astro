---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Timeline"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Timeline",
    },
  ]}
>
  <h1>Timeline</h1>

  <div x-data={"dataset"}>
    <div
      id="timeline"
      class="aspect-[3/4] md:aspect-video border border-primary/20"
    >
    </div>
  </div>
</Layout>

<script>
  import timeline from "@scripts/timeline";
  import Alpine from "alpinejs";

  Alpine.data("dataset", timeline);
</script>
