---
import CustomImage from "@components/CustomImage.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import MarkdownText from "@components/MarkdownText.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getEntry, render } from "astro:content";

const rhapsodyOfTheMoonEntry = await getEntry(
  "a-series-of-dusks",
  "rhapsody-of-the-moon"
)!;

const { Content } = await render(rhapsodyOfTheMoonEntry);
---

<Layout
  title="Rhapsody of the Moon | A Series of Dusks"
  description="Rhapsody of the Moon is a expansion mode in A Series of Dusks in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Rhapsody of the Moon",
    },
  ]}
>
  <Content
    components={{
      img: CustomImage,
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      text: MarkdownText,
      toc: TableOfContents,
    }}
  />
</Layout>
