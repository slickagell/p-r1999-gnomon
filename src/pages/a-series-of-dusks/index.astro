---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="A Series of Dusks | Reverse 1999 Gnomon"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
    },
  ]}
>
  <main>
    <h1 class="text-6xl font-bold text-center">A Series of Dusks</h1>
    <div class="mt-8 grid grid-cols-2 gap-4">
      <a href="/a-series-of-dusks/artefacts">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Artefacts</h2>
            <p>View info about artefacts</p>
          </div>
        </div>
      </a>
      <a href="/a-series-of-dusks/mechanic">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Mechanic</h2>
            <p>View info about mechanic</p>
          </div>
        </div>
      </a>
    </div>
  </main>
</Layout>
