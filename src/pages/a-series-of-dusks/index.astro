---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="A Series of Dusks"
  description="A Series of Dusks is a roguelike permanent game mode in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
    },
  ]}
>
  <h1>A Series of Dusks</h1>

  <p class="text-center">
    A Series of Dusks is a roguelike permanent game mode in Reverse: 1999.
  </p>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
    <a href="/a-series-of-dusks/artefacts/weapon">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Artefacts</h2>
          <p>Artefacts information</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/artefacts/exchange">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Artefacts Exchange</h2>
          <p>Exchange artefacts list</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/catalysts">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Catalysts</h2>
          <p>Catalysts information</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/mechanism">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Mechanism</h2>
          <p>General gamemode mechanism</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/rhapsody-of-the-moon">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Rhapsody of the Moon</h2>
          <p>Expansion</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/fugue-of-reflections">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">Fugue of Reflections</h2>
          <p>Expansion</p>
        </div>
      </div>
    </a>
    <a href="/a-series-of-dusks/the-effervescent-silence">
      <div class="card card-compact border border-primary">
        <div class="card-body">
          <h2 class="card-title">The Effervescent Silence</h2>
          <p>Expansion</p>
        </div>
      </div>
    </a>
  </div>
</Layout>
