---
import CustomImage from "@components/CustomImage.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import MarkdownText from "@components/MarkdownText.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getEntry, render } from "astro:content";

const fugueOfReflectionsEntry = await getEntry(
  "a-series-of-dusks",
  "fugue-of-reflections"
)!;

const { Content } = await render(fugueOfReflectionsEntry);
---

<Layout
  title="Fugue of Reflections | A Series of Dusks"
  description="Fugue of Reflections is a expansion mode in A Series of Dusks in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Fugue of Reflections",
    },
  ]}
>
  <Content
    components={{
      img: CustomImage,
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      text: MarkdownText,
      toc: TableOfContents,
      em: MarkdownEmphasis,
      ul: MarkdownDiscList,
    }}
  />
</Layout>
