---
import CustomImage from "@components/CustomImage.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getEntry, render } from "astro:content";

const mechanismEntry = await getEntry("a-series-of-dusks", "mechanism")!;

const { Content } = await render(mechanismEntry);
---

<Layout
  title="Mechanic | A Series of Dusks"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Mechanic",
    },
  ]}
>
  <Content
    components={{
      p: MarkdownParagraphContent,
      img: CustomImage,
    }}
  />
</Layout>
