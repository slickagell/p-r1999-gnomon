---
import CustomImage from "@components/CustomImage.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getEntry } from "astro:content";

const mechanicEntry = await getEntry("a-series-of-dusks", "mechanism");

const { Content } = await mechanicEntry.render();
---

<Layout
  title="Mechanic | A Series of Dusks"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Mechanic",
    },
  ]}
>
  <Content
    components={{
      p: MarkdownContent,
      img: CustomImage,
    }}
  />
</Layout>
