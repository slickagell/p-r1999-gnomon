---
import Layout from "@layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const catalystGuideEntry = await getEntry(
  "a-series-of-dusks",
  "catalysts-guide",
)!;

const { Content } = await render(catalystGuideEntry);
---

<Layout
  title="Catalysts Guide"
  description="Catalyst guide in A Series of Dusks in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Catalysts",
      href: "/a-series-of-dusks/catalysts",
    },
    {
      label: "Guide",
    },
  ]}
>
  <Content />
</Layout>
