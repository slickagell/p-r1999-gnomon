---
import CustomImage from "@components/CustomImage.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import Layout from "@layouts/Layout.astro";
import { sortCatalyst } from "@scripts/common";
import { getCollection, render } from "astro:content";

const catalystEntries = await getCollection("catalysts");
---

<Layout
  title="Catalysts"
  description="Catalyst list in A Series of Dusks in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Catalysts",
    },
  ]}
>
  <h1>Catalysts</h1>

  <div class="mt-10">
    {
      catalystEntries.sort(sortCatalyst).map(async (catalystEntry) => {
        const { Content } = await render(catalystEntry);
        return (
          <div class="mt-6">
            <h2
              id={catalystEntry.id}
              class="mt-6 mb-4 text-center md:text-left"
            >
              <a href={`#${catalystEntry.id}`}>{catalystEntry.data.name}</a>
            </h2>
            <div class="flex flex-col md:flex-row gap-8 md:items-start">
              <div class="md:basis-1/4 shrink-0">
                <CustomImage
                  class="w-40 mx-auto"
                  src={`/images/catalysts/${catalystEntry.data.image}`}
                  alt={`${catalystEntry.data.name} icon`}
                />
                <p class="text-center">{catalystEntry.data.description}</p>
              </div>
              <div>
                <Content
                  components={{
                    ul: MarkdownDiscList,
                    img: CustomImage,
                    effect: EffectTooltip,
                  }}
                />
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</Layout>
