---
import CustomImage from "@components/CustomImage.astro";
import { ROUTES } from "@config/routes";
import ARTEFACT_TAG from "@data/common/artefact/tag.json";
import Layout from "@layouts/Layout.astro";
import { sortArtefact } from "@scripts/common";
import { getCollection } from "astro:content";
import matrix from "matrix-js";

const artefactEntries = await getCollection("artefacts");

const exchangeArtefacts = artefactEntries
  .filter((artefactEntry) => artefactEntry.data.canExchange)
  .sort(sortArtefact);
---

<Layout
  title="Artefact Exchange"
  description="Artefact exchange list in A Series of Dusks in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "A Series of Dusks",
      href: "/a-series-of-dusks",
    },
    {
      label: "Artefact Exchange",
    },
  ]}
>
  <h1>Artefact Exchange</h1>
  {
    exchangeArtefacts.map((artefactEntry) => {
      const shape = matrix(artefactEntry.data.shape);
      const shapeSize = shape.size();

      return (
        <div class="mt-8">
          <p id={artefactEntry.id} class="font-bold text-xl mb-4">
            <a href={`#${artefactEntry.id}`}>{artefactEntry.data.name}</a>
          </p>
          <div class="flex flex-col md:flex-row gap-2 md:gap-4">
            <div class="basis-32 lg:basis-48 flex flex-col gap-2 items-center">
              {/* Artefact image */}
              <div class="border border-2 inline-block">
                <a
                  href={
                    ROUTES.A_SERIES_OF_DUSKS_ARTEFACT + `#${artefactEntry.id}`
                  }
                >
                  <CustomImage
                    class="w-20"
                    src={`/images/artefacts/${artefactEntry.data.image}`}
                    alt={`artefact ${artefactEntry.id}`}
                  />
                </a>
              </div>
              {/* Artefact name */}
              <p id={artefactEntry.id} class="text-center">
                <a
                  href={
                    ROUTES.A_SERIES_OF_DUSKS_ARTEFACT + `#${artefactEntry.id}`
                  }
                >
                  {artefactEntry.data.name}
                </a>
              </p>
              {/* Artefact tag */}
              <div class="mt-1 flex gap-1 flex-wrap justify-center">
                {artefactEntry.data.tags.map((tag) => (
                  <span
                    class:list={[
                      "badge font-bold",
                      {
                        "border-support text-support": tag === "SUPPORT",
                        "border-ritual text-ritual": tag === "RITUAL",
                        "border-craft text-craft": tag === "CRAFT",
                        "border-syntony text-syntony": tag === "SYNTONY",
                        "border-resonance text-resonance": tag === "RESONANCE",
                        "border-abundance text-abundance": tag === "ABUNDANCE",
                        "border-extra-action text-extra-action":
                          tag === "EXTRA_ACTION",
                        "border-voltaic text-voltaic": tag === "VOLTAIC",
                      },
                    ]}
                  >
                    {ARTEFACT_TAG[tag].title}
                  </span>
                ))}
              </div>
              {/* Artefact shape */}
              <div class="flex flex-col gap-1">
                {Array.from({ length: shapeSize[0] }).map((_, rowIdx) => (
                  <div class="flex gap-1">
                    {Array.from({ length: shapeSize[1] }).map((_, colIdx) => (
                      <div
                        class:list={[
                          "w-6 h-6",
                          !shape(rowIdx, colIdx)
                            ? "bg-transparent"
                            : {
                                "bg-common/30":
                                  artefactEntry.data.rarity === "COMMON",
                                "bg-rare/30":
                                  artefactEntry.data.rarity === "RARE",
                                "bg-epic/30":
                                  artefactEntry.data.rarity === "EPIC",
                              },
                        ]}
                      />
                    ))}
                  </div>
                ))}
              </div>
            </div>
            <span class="md:mt-5 text-4xl text-center">=</span>
            <div class="flex-1 flex gap-2 md:gap-4 flex-wrap justify-center md:justify-start">
              {artefactEntry.data.combination?.map(
                (combineArtefactCode, combineIdx) => {
                  const combineArtefact = artefactEntries.find(
                    (artefactEntry) =>
                      artefactEntry.data.code === combineArtefactCode,
                  );

                  if (!combineArtefact) return null;

                  const combineArtefactShape = matrix(
                    combineArtefact.data.shape,
                  );
                  const combineArtefactShapeSize = combineArtefactShape.size();

                  return (
                    <Fragment>
                      {combineIdx !== 0 && <span class="mt-5 text-4xl">+</span>}
                      <div class="basis-32 lg:basis-48 flex flex-col gap-2 items-center">
                        {/* Artefact image */}
                        <div class="border border-2 inline-block">
                          <a
                            href={
                              ROUTES.A_SERIES_OF_DUSKS_ARTEFACT +
                              `#${combineArtefact.id}`
                            }
                          >
                            <CustomImage
                              class="w-20"
                              src={`/images/artefacts/${combineArtefact.data.image}`}
                              alt={`artefact ${combineArtefact.id}`}
                            />
                          </a>
                        </div>
                        {/* Artefact name */}
                        <p class="text-center">
                          <a
                            href={
                              ROUTES.A_SERIES_OF_DUSKS_ARTEFACT +
                              `#${combineArtefact.id}`
                            }
                          >
                            {combineArtefact.data.name}
                          </a>
                        </p>
                        {/* Artefact tag */}
                        <div class="mt-1 flex gap-1 flex-wrap">
                          {combineArtefact.data.tags.map((tag) => (
                            <span
                              class:list={[
                                "badge font-bold",
                                {
                                  "border-support text-support":
                                    tag === "SUPPORT",
                                  "border-ritual text-ritual": tag === "RITUAL",
                                  "border-craft text-craft": tag === "CRAFT",
                                  "border-syntony text-syntony":
                                    tag === "SYNTONY",
                                  "border-resonance text-resonance":
                                    tag === "RESONANCE",
                                  "border-abundance text-abundance":
                                    tag === "ABUNDANCE",
                                  "border-extra-action text-extra-action":
                                    tag === "EXTRA_ACTION",
                                  "border-voltaic text-voltaic":
                                    tag === "VOLTAIC",
                                },
                              ]}
                            >
                              {ARTEFACT_TAG[tag].title}
                            </span>
                          ))}
                        </div>
                        {/* Artefact shape */}
                        <div class="flex flex-col gap-1">
                          {Array.from({
                            length: combineArtefactShapeSize[0],
                          }).map((_, rowIdx) => (
                            <div class="flex gap-1">
                              {Array.from({
                                length: combineArtefactShapeSize[1],
                              }).map((_, colIdx) => (
                                <div
                                  class:list={[
                                    "w-6 h-6",
                                    !combineArtefactShape(rowIdx, colIdx)
                                      ? "bg-transparent"
                                      : {
                                          "bg-common/30":
                                            combineArtefact.data.rarity ===
                                            "COMMON",
                                          "bg-rare/30":
                                            combineArtefact.data.rarity ===
                                            "RARE",
                                          "bg-epic/30":
                                            combineArtefact.data.rarity ===
                                            "EPIC",
                                        },
                                  ]}
                                />
                              ))}
                            </div>
                          ))}
                        </div>
                      </div>
                    </Fragment>
                  );
                },
              )}
            </div>
          </div>
        </div>
      );
    })
  }
</Layout>
