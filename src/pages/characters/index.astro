---
import AfflatusIcon from "@components/AfflatusIcon.astro";
import CustomImage from "@components/CustomImage.astro";
import Icon from "@components/Icon.astro";
import Tooltip from "@components/Tooltip.astro";
import AFFLATUS_TYPE from "@data/common/character/afflatus-type.json";
import SPECIALTIES from "@data/common/character/specialty.json";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import dayjs from "dayjs";

const characterEntries = await getCollection("characters");

function sortCharacters(a, b) {
  if (a.data.star !== b.data.star) {
    return -(a.data.star - b.data.star);
  }

  const diffDay = dayjs(a.data.releaseDate).diff(dayjs(b.data.releaseDate));
  if (diffDay > 0) {
    return -1;
  } else if (diffDay < 0) {
    return 1;
  }

  return ("" + a.data.title).localeCompare(b.data.title);
}

const euphorias = [
  ...new Set(characterEntries.map((entry) => entry.data.euphorias + "")),
].sort((a, b) => Number(a ?? 0) - Number(b ?? 0));

const versions = [
  ...new Set(
    characterEntries.map((entry) => {
      if (entry.data.version) return entry.data.version;
    }),
  ),
].sort((a, b) => {
  if (!a || !b) return 0;
  const numA = parseFloat(a);
  const numB = parseFloat(b);
  const aIsNum = !isNaN(numA);
  const bIsNum = !isNaN(numB);

  if (aIsNum && bIsNum) {
    return numB - numA;
  }
  if (aIsNum) return -1;
  if (bIsNum) return 1;
  return a.localeCompare(b);
});

const specialties = [
  ...new Set(characterEntries.map((entry) => entry.data.specialties).flat()),
].sort((a, b) => a.localeCompare(b));

const characters = characterEntries.map((entry) => {
  return {
    ...entry.data,
  };
});
---

<Layout
  title="Characters"
  description="Character list in Reverse: 1999."
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Characters",
    },
  ]}
>
  <h1 class="text-center">Character List</h1>

  <div class="flex flex-wrap justify-end gap-2">
    <a href="/characters/archetype-trait">
      <div class="btn btn-sm btn-outline">Archetype / Trait</div>
    </a>
  </div>

  <div x-data={"dataset"}>
    <div class="filters">
      <div
        class="mt-4 collapse collapse-plus border border-primary bg-base-200"
      >
        <input type="checkbox" class="min-h-10" />
        <div
          class="collapse-title py-0 pt-1 min-h-10 text-lg font-medium after:!top-[0.3125rem] after:!w-auto after:!h-auto"
        >
          Filters
        </div>
        <div class="collapse-content">
          <div
            class="hidden md:grid md:grid-cols-[max-content_1fr] [&>*]:border-t [&>*]:border-base-content/25 [&>*]:py-3 [&>*]:px-2"
          >
            <span class="text-primary-content">Rarity</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="rarity in rarities">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="rarity.code === rarityFilter ? 'btn-active' : ''"
                    @click="filterRarity(rarity.code)"
                    x-text="rarity.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Afflatus</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="afflatusType in afflatusTypes">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="afflatusType.code === afflatusTypeFilter ? 'btn-active' : ''"
                    @click="filterAfflatusType(afflatusType.code)"
                    x-text="afflatusType.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Damage type</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="dmgType in dmgTypes">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="dmgType.code === dmgTypeFilter ? 'btn-active' : ''"
                    @click="filterDmgType(dmgType.code)"
                    x-text="dmgType.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Race</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="raceType in raceTypes">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="raceType.code === raceTypeFilter ? 'btn-active' : ''"
                    @click="filterRaceType(raceType.code)"
                    x-text="raceType.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Gender</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="gender in genders">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="gender.code === genderFilter ? 'btn-active' : ''"
                    @click="filterGender(gender.code)"
                    x-text="gender.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Limited</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="limitedType in limitedTypes">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="limitedType.code === limitedTypeFilter ? 'btn-active' : ''"
                    @click="filterLimitedType(limitedType.code)"
                    x-text="limitedType.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Main piece</span>
            <ul class="flex gap-1 flex-wrap">
              <template x-for="mainPiece in mainPieces">
                <li>
                  <button
                    class="btn btn-outline btn-xs"
                    x-bind:class="mainPiece.code === mainPieceFilter ? 'btn-active' : ''"
                    @click="filterMainPiece(mainPiece.code)"
                    x-text="mainPiece.title"
                  >
                  </button>
                </li>
              </template>
            </ul>
            <span class="text-primary-content">Euphoria</span>
            <div>
              <ul class="flex gap-x-4 gap-y-1 flex-wrap">
                {
                  euphorias.map((euphoria) => {
                    return (
                      <li class="form-control">
                        <label class="label py-1 gap-2 justify-start cursor-pointer">
                          <input
                            type="checkbox"
                            x-bind:checked={`euphoriaFilter.includes('${euphoria}')`}
                            class="checkbox checkbox-xs checkbox-secondary"
                            @change={`toggleEuphoria('${euphoria}')`}
                          />
                          <span class="label-text">{euphoria + ""}</span>
                        </label>
                      </li>
                    );
                  })
                }
              </ul>
              <div class="mt-2 flex gap-2">
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="selectAllEuphorias"
                >
                  All
                </button>
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="clearAllEuphorias"
                >
                  Clear
                </button>
              </div>
            </div>
            <span class="text-primary-content">Specialty</span>
            <div>
              <ul class="grid gap-x-4 gap-y-1 grid-cols-5">
                {
                  specialties.map((specialty) => {
                    return (
                      <li class="form-control">
                        <label class="label py-1 gap-2 justify-start cursor-pointer">
                          <input
                            type="checkbox"
                            x-bind:checked={`specialtyFilter.includes('${specialty}')`}
                            class="checkbox checkbox-xs checkbox-secondary"
                            @change={`toggleSpecialty('${specialty}')`}
                          />
                          <span class="label-text">
                            {SPECIALTIES[specialty].title}
                          </span>
                        </label>
                      </li>
                    );
                  })
                }
              </ul>
              <div class="mt-2 flex gap-2">
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="selectAllSpecialties"
                >
                  All
                </button>
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="clearAllSpecialties"
                >
                  Clear
                </button>
              </div>
            </div>
            <span class="text-primary-content">Version</span>
            <div>
              <ul class="flex gap-x-4 gap-y-1 flex-wrap">
                {
                  versions.map((version) => {
                    return (
                      <li class="form-control">
                        <label class="label py-1 gap-2 justify-start cursor-pointer">
                          <input
                            type="checkbox"
                            x-bind:checked={`versionFilter.includes('${version}')`}
                            class="checkbox checkbox-xs checkbox-secondary"
                            @change={`toggleVersion('${version}')`}
                          />
                          <span class="label-text">{version}</span>
                        </label>
                      </li>
                    );
                  })
                }
              </ul>
              <div class="mt-2 flex gap-2">
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="selectAllVersions"
                >
                  All
                </button>
                <button
                  class="btn btn-outline btn-xs border-base-content/15"
                  @click="clearAllVersions"
                >
                  Clear
                </button>
              </div>
            </div>
          </div>
          <div class="md:hidden">
            <label for="rarityFilter" class="py-2 block">
              Rarity
              <select
                id="rarityFilter"
                class="select select-secondary w-full"
                @change="filterRarity($event.target.value)"
              >
                <template x-for="rarity in rarities">
                  <option
                    x-bind:value="rarity.code"
                    x-bind:selected="rarity.code === rarityFilter"
                    x-text="rarity.title"></option>
                </template>
              </select>
            </label>
            <label for="afflatusFilter" class="py-2 block">
              Afflatus
              <select
                class="select select-secondary w-full"
                @change="filterAfflatusType($event.target.value)"
              >
                <template x-for="afflatusType in afflatusTypes">
                  <option
                    x-bind:value="afflatusType.code"
                    x-bind:selected="afflatusType.code === afflatusTypeFilter"
                    x-text="afflatusType.title"></option>
                </template>
              </select>
            </label>
            <label for="dmgTypeFilter" class="py-2 block">
              Damage type
              <select
                class="select select-secondary w-full"
                @change="filterDmgType($event.target.value)"
              >
                <template x-for="dmgType in dmgTypes">
                  <option
                    x-bind:value="dmgType.code"
                    x-bind:selected="dmgType.code === dmgTypeFilter"
                    x-text="dmgType.title"></option>
                </template>
              </select>
            </label>
            <label for="raceTypeFilter" class="py-2 block">
              Race
              <select
                class="select select-secondary w-full"
                @change="filterRaceType($event.target.value)"
              >
                <template x-for="raceType in raceTypes">
                  <option
                    x-bind:value="raceType.code"
                    x-bind:selected="raceType.code === raceTypeFilter"
                    x-text="raceType.title"></option>
                </template>
              </select>
            </label>
            <label for="genderFilter" class="py-2 block">
              Gender
              <select
                class="select select-secondary w-full"
                @change="filterGender($event.target.value)"
              >
                <template x-for="gender in genders">
                  <option
                    x-bind:value="gender.code"
                    x-bind:selected="gender.code === genderFilter"
                    x-text="gender.title"></option>
                </template>
              </select>
            </label>
            <label for="limitedTypeFilter" class="py-2 block">
              Limited
              <select
                class="select select-secondary w-full"
                @change="filterLimitedType($event.target.value)"
              >
                <template x-for="limitedType in limitedTypes">
                  <option
                    x-bind:value="limitedType.code"
                    x-bind:selected="limitedType.code === limitedTypeFilter"
                    x-text="limitedType.title"></option>
                </template>
              </select>
            </label>
            <label for="mainPieceFilter" class="py-2 block">
              Main piece
              <select
                class="select select-secondary w-full"
                @change="filterMainPiece($event.target.value)"
              >
                <template x-for="mainPiece in mainPieces">
                  <option
                    x-bind:value="mainPiece.code"
                    x-bind:selected="mainPiece.code === mainPieceFilter"
                    x-text="mainPiece.title"></option>
                </template>
              </select>
            </label>
            <div
              class="mt-2 md:mt-0 py-2 md:py-4 flex gap-2 flex-wrap justify-center"
            >
              <Tooltip>
                <button
                  slot="toggle"
                  x-transition
                  class="btn btn-outline btn-sm"
                >
                  <Icon icon="laurel-wreath" />
                  Euphoria
                </button>
                <div>
                  <p class="text-center font-medium">Euphoria</p>
                  <div class="max-h-[30vh] overflow-auto">
                    {
                      euphorias.map((euphoria) => {
                        return (
                          <div class="form-control">
                            <label class="label gap-2 justify-start cursor-pointer">
                              <input
                                type="checkbox"
                                x-bind:checked={`euphoriaFilter.includes('${euphoria}')`}
                                class="checkbox checkbox-sm checkbox-secondary"
                                @change={`toggleEuphoria('${euphoria}')`}
                              />
                              <span class="label-text">{euphoria}</span>
                            </label>
                          </div>
                        );
                      })
                    }
                  </div>
                  <div class="pt-2 mt-2 flex justify-between gap-2">
                    <button
                      class="btn btn-outline btn-sm"
                      @click="selectAllEuphorias"
                    >
                      Select all
                    </button>
                    <button
                      class="btn btn-outline btn-sm"
                      @click="clearAllEuphorias"
                    >
                      Clear
                    </button>
                  </div>
                </div>
              </Tooltip>
              <Tooltip>
                <button
                  slot="toggle"
                  x-transition
                  class="btn btn-outline btn-sm"
                >
                  <Icon icon="chart-radar" />
                  Specialties
                </button>
                <div>
                  <p class="text-center font-medium">Specialty</p>
                  <div class="max-h-[30vh] overflow-auto">
                    {
                      specialties.map((specialty) => {
                        return (
                          <div class="form-control">
                            <label class="label gap-2 justify-start cursor-pointer">
                              <input
                                type="checkbox"
                                x-bind:checked={`specialtyFilter.includes('${specialty}')`}
                                class="checkbox checkbox-sm checkbox-secondary"
                                @change={`toggleSpecialty('${specialty}')`}
                              />
                              <span class="label-text">
                                {SPECIALTIES[specialty].title}
                              </span>
                            </label>
                          </div>
                        );
                      })
                    }
                  </div>
                  <div class="pt-2 mt-2 flex justify-between gap-2">
                    <button
                      class="btn btn-outline btn-sm"
                      @click="selectAllSpecialties"
                    >
                      Select all
                    </button>
                    <button
                      class="btn btn-outline btn-sm"
                      @click="clearAllSpecialties"
                    >
                      Clear
                    </button>
                  </div>
                </div>
              </Tooltip>
              <Tooltip>
                <button
                  slot="toggle"
                  x-transition
                  class="btn btn-outline btn-sm"
                >
                  <Icon icon="version" />
                  Versions
                </button>
                <div>
                  <p class="text-center font-medium">Version</p>
                  <div class="max-h-[30vh] overflow-auto">
                    {
                      versions.map((version) => {
                        return (
                          <div class="form-control">
                            <label class="label gap-2 justify-start cursor-pointer">
                              <input
                                type="checkbox"
                                x-bind:checked={`versionFilter.includes('${version}')`}
                                class="checkbox checkbox-sm checkbox-secondary"
                                @change={`toggleVersion('${version}')`}
                              />
                              <span class="label-text">{version}</span>
                            </label>
                          </div>
                        );
                      })
                    }
                  </div>
                  <div class="pt-2 mt-2 flex justify-between gap-2">
                    <button
                      class="btn btn-outline btn-sm"
                      @click="selectAllVersions"
                    >
                      Select all
                    </button>
                    <button
                      class="btn btn-outline btn-sm"
                      @click="clearAllVersions"
                    >
                      Clear
                    </button>
                  </div>
                </div>
              </Tooltip>
            </div>
          </div>
        </div>
      </div>

      <input
        type="text"
        placeholder="Search"
        class="mt-6 mb-4 input input-bordered input-secondary w-full"
        x-model="searchText"
        @input.debounce="handleSearch"
      />
    </div>
    <p class="my-4 text-right">
      <strong class="text-xl" x-text="numberOfCharacters"></strong>{" "}
      <span x-text="numberOfCharacters === 1 ? 'character' : 'characters'"
      ></span>
    </p>

    <ul class="mt-8 grid grid-cols-2 md:grid-cols-6 gap-4">
      {
        characterEntries.sort(sortCharacters).map((characterEntry) => {
          return (
            <li x-show={`isShowCharacter['${characterEntry.id}']`}>
              <div class="group h-full min-h-80 oveflow-hidden rounded-lg card card-compact bg-base-100 border-base-content/10 border transition-all hover:shadow-md hover:shadow-base-content">
                <a class="h-full" href={`/characters/${characterEntry.id}`}>
                  <div class="h-full relative ">
                    <div class="absolute z-10 -top-1 left-2 w-6 group-hover:-top-2 transition-all">
                      <AfflatusIcon
                        type={
                          characterEntry.data
                            .afflatus as keyof typeof AFFLATUS_TYPE
                        }
                      />
                    </div>
                    <div class="h-full relative overflow-hidden">
                      <CustomImage
                        class="w-full"
                        src={`/images/characters/common/bg-character.png`}
                        alt={`bg-character`}
                      />
                      {characterEntry.data.gameId && (
                        <CustomImage
                          class="absolute top-0 left-0 w-full -z-1"
                          src={`/images/frame/${characterEntry.data.gameId}01.png`}
                          alt={`character-card-${characterEntry.data.id}`}
                        />
                      )}
                      <CustomImage
                        class="absolute bottom-0 left-0 w-full"
                        src={`/images/characters/common/bg-rare-${characterEntry.data.star}.png`}
                        alt={`character-bg-rare-${characterEntry.data.star}`}
                      />

                      <h5 class="absolute bottom-4 left-0 right-0 text-center px-2 text-white font-normal">
                        {characterEntry.data.name}
                      </h5>
                    </div>
                  </div>
                </a>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    versions,
    specialties,
    euphorias,
    characters,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("characterList", {
      versions,
      specialties,
      euphorias,
      characters,
    });
  });
</script>

<script>
  import AFFLATUS_TYPE from "@data/common/character/afflatus-type.json";
  import DMG_TYPE from "@data/common/character/dmg-type.json";
  import RACE from "@data/common/character/race.json";
  import RARITY from "@data/common/character/rarity.json";
  import GENDER from "@data/common/character/gender.json";
  import Alpine from "alpinejs";

  Alpine.data("dataset", () => ({
    searchText: "",
    rarityFilter: "ALL",
    rarities: [
      { title: "All", code: "ALL" },
      ...Object.keys(RARITY).map((code) => ({
        title: RARITY[code].value.toString(),
        code: RARITY[code].value.toString(),
      })),
    ],
    afflatusTypeFilter: "ALL",
    afflatusTypes: [
      { title: "All", code: "ALL" },
      ...Object.keys(AFFLATUS_TYPE).map((code) => ({
        title: AFFLATUS_TYPE[code].title,
        code,
      })),
    ],
    dmgTypeFilter: "ALL",
    dmgTypes: [
      { title: "All", code: "ALL" },
      ...Object.keys(DMG_TYPE).map((code) => ({
        title: DMG_TYPE[code].title,
        code,
      })),
    ],
    raceTypeFilter: "ALL",
    raceTypes: [
      { title: "All", code: "ALL" },
      ...Object.keys(RACE).map((code) => ({
        title: RACE[code].title,
        code,
      })),
    ],
    genderFilter: "ALL",
    genders: [
      { title: "All", code: "ALL" },
      ...Object.keys(GENDER).map((code) => ({
        title: GENDER[code].title,
        code,
      })),
    ],
    limitedTypeFilter: "ALL",
    limitedTypes: [
      { title: "All", code: "ALL" },
      { title: "Limited", code: "true" },
      { title: "Normal", code: "false" },
    ],
    mainPieceFilter: "ALL",
    mainPieces: [
      { title: "All", code: "ALL" },
      { title: "X", code: "x" },
      { title: "U", code: "u" },
      { title: "T", code: "t" },
      { title: "Z", code: "z" },
    ],
    euphoriaFilter: [],
    versionFilter: [],
    specialtyFilter: [],
    isShowCharacter: {},
    numberOfCharacters: 0,

    init() {
      this.versionFilter = this.$store.characterList.versions;
      this.specialtyFilter = this.$store.characterList.specialties;
      this.euphoriaFilter = this.$store.characterList.euphorias;
      this.isShowCharacter = this.$store.characterList.characters.reduce(
        (acc, characterEntry) => {
          acc[characterEntry.id] = true;
          return acc;
        },
        {},
      );
      this.numberOfCharacters = Object.keys(this.isShowCharacter).length;
    },

    filterCharacter({
      star,
      afflatus,
      dmgType,
      name,
      race,
      version,
      gender,
      limited,
      mainPiece,
      euphorias,
      specialties,
    }) {
      const filters =
        (this.afflatusTypeFilter === "ALL" ||
          this.afflatusTypeFilter === afflatus) &&
        (this.rarityFilter === "ALL" || this.rarityFilter === star + "") &&
        (this.dmgTypeFilter === "ALL" || this.dmgTypeFilter === dmgType) &&
        (this.raceTypeFilter === "ALL" || this.raceTypeFilter === race) &&
        (this.genderFilter === "ALL" || this.genderFilter === gender) &&
        (this.limitedTypeFilter === "ALL" ||
          this.limitedTypeFilter === (!!limited ? "true" : "false")) &&
        (this.mainPieceFilter === "ALL" ||
          this.mainPieceFilter === mainPiece) &&
        this.euphoriaFilter.includes(euphorias + "") &&
        this.versionFilter.includes(version) &&
        this.specialtyFilter.some((specialty) =>
          specialties.includes(specialty),
        );

      return !this.searchText
        ? filters
        : filters && name.toLowerCase().includes(this.searchText.toLowerCase());
    },

    handleFilterCharacters() {
      for (const character of this.$store.characterList.characters) {
        const isShow = this.filterCharacter({
          ...character,
        });

        this.isShowCharacter[character.id] = isShow;
      }
      this.numberOfCharacters = Object.keys(this.isShowCharacter).filter(
        (id) => this.isShowCharacter[id],
      ).length;
    },

    handleSearch() {
      this.handleFilterCharacters();
    },

    filterRarity(rarity: string) {
      this.rarityFilter = rarity;
      this.handleFilterCharacters();
    },

    filterAfflatusType(afflatusType: string) {
      this.afflatusTypeFilter = afflatusType;
      this.handleFilterCharacters();
    },

    filterDmgType(dmgType: string) {
      this.dmgTypeFilter = dmgType;
      this.handleFilterCharacters();
    },

    filterRaceType(raceType: string) {
      this.raceTypeFilter = raceType;
      this.handleFilterCharacters();
    },

    filterGender(gender: string) {
      this.genderFilter = gender;
      this.handleFilterCharacters();
    },

    filterLimitedType(limitedType: string) {
      this.limitedTypeFilter = limitedType;
      this.handleFilterCharacters();
    },

    filterMainPiece(mainPiece: string) {
      this.mainPieceFilter = mainPiece;
      this.handleFilterCharacters();
    },

    filterEuphoria(euphoria: string) {
      this.euphoriaFilter = euphoria;
      this.handleFilterCharacters();
    },

    toggleVersion(version: string) {
      if (this.versionFilter.includes(version)) {
        this.versionFilter = this.versionFilter.filter((v) => v !== version);
      } else {
        this.versionFilter.push(version);
      }
      this.handleFilterCharacters();
    },

    selectAllVersions() {
      this.versionFilter = this.$store.characterList.versions;
      this.handleFilterCharacters();
    },

    clearAllVersions() {
      this.versionFilter = [];
      this.handleFilterCharacters();
    },

    toggleSpecialty(specialty: string) {
      if (this.specialtyFilter.includes(specialty)) {
        this.specialtyFilter = this.specialtyFilter.filter(
          (v) => v !== specialty,
        );
      } else {
        this.specialtyFilter.push(specialty);
      }
      this.handleFilterCharacters();
    },

    selectAllSpecialties() {
      this.specialtyFilter = this.$store.characterList.specialties;
      this.handleFilterCharacters();
    },

    clearAllSpecialties() {
      this.specialtyFilter = [];
      this.handleFilterCharacters();
    },

    toggleEuphoria(euphoria: string) {
      if (this.euphoriaFilter.includes(euphoria)) {
        this.euphoriaFilter = this.euphoriaFilter.filter((v) => v !== euphoria);
      } else {
        this.euphoriaFilter.push(euphoria);
      }

      this.handleFilterCharacters();
    },

    selectAllEuphorias() {
      this.euphoriaFilter = this.$store.characterList.euphorias;
      this.handleFilterCharacters();
    },

    clearAllEuphorias() {
      this.euphoriaFilter = [];
      this.handleFilterCharacters();
    },
  }));
</script>
