---
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import ResonanceBoard from "@components/ResonanceBoard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tooltip from "@components/Tooltip.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const characterEntries = await getCollection("characters");
  return characterEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={`${entry.data.title} | Character`}
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Characters",
      href: "/characters",
    },
    {
      label: entry.data.title,
    },
  ]}
>
  <Content
    components={{
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      strong: MarkdownHighlight,
      tooltip: Tooltip,
      resonance: ResonanceBoard,
      toc: TableOfContents,
      em: MarkdownEmphasis,
    }}
  />
</Layout>
