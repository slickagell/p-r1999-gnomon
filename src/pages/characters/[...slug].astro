---
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import ResonanceBoard from "@components/ResonanceBoard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tooltip from "@components/Tooltip.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getCollection, render } from "astro:content";
import { capitalCase } from "change-case";

export async function getStaticPaths() {
  const characterEntries = await getCollection("characters");
  return characterEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Character`}
  description={`${entry.data.title} is a ${capitalCase(entry.data.afflatus)} character released in version ${entry.data.version} in Reverse: 1999.`}
  og={{
    imageUrl: `/images/characters/${entry.id}/headicon.png`,
  }}
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Characters",
      href: "/characters",
    },
    {
      label: entry.data.title,
    },
  ]}
>
  <Content
    components={{
      ul: MarkdownDiscList,
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      strong: MarkdownHighlight,
      tooltip: Tooltip,
      resonance: ResonanceBoard,
      toc: TableOfContents,
      em: MarkdownEmphasis,
    }}
  />
</Layout>
