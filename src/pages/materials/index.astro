---
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import Material from "@components/Material.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const materialEntries = await getCollection("materials");
---

<Layout
  title="Materials | Reverse 1999 Gnomon"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Materials",
    },
  ]}
>
  <h1 class="text-center">Material List</h1>

  <div x-data={"dataset"}>
    <div class="filters">
      <div class="grid grid-cols-filter">
        <div class="py-2 px-4">Rarity</div>
        <ul class="py-2 px-4 flex gap-1">
          <template x-for="rarity in rarities">
            <li>
              <button
                class="btn btn-outline btn-xs"
                :class="rarity.code === rarityFilter ? 'btn-active' : ''"
                @click="filterRarity(rarity)"
                x-text="rarity.title"
              >
              </button>
            </li>
          </template>
        </ul>
      </div>

      <ul class="mt-8 grid grid-cols-2 gap-4">
        {
          materialEntries.map(async (effectEntry) => {
            return (
              <li
                x-show={`filterMaterial({rarity:'${effectEntry.data.rarity}'})`}
              >
                <Material code={effectEntry.data.code} />
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <script>
    import { MATERIAL_RARITY } from "@data/material";
    import Alpine from "alpinejs";

    window.Alpine = Alpine;

    Alpine.data("dataset", () => ({
      rarityFilter: "ALL",
      rarities: [
        { title: "All", code: "ALL" },
        ...Object.keys(MATERIAL_RARITY).map((code) => ({
          title: MATERIAL_RARITY[code].title,
          code: MATERIAL_RARITY[code].value.toString(),
        })),
      ],

      filterMaterial({ rarity }) {
        return this.rarityFilter === "ALL" || this.rarityFilter === rarity;
      },

      filterRarity(rarity) {
        this.rarityFilter = rarity.code;
      },
    }));
  </script>
</Layout>
