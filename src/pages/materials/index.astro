---
import Material from "@components/Material.astro";
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

const materialEntries = await getCollection("materials");
---

<Layout
  title="Materials | Reverse 1999 Gnomon"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Materials",
    },
  ]}
>
  <h1 class="text-center">Material List</h1>

  <div x-data={"dataset"}>
    <div class="filters">
      <div class="md:grid md:grid-cols-filter">
        <!-- Rarity -->
        <div class="py-2 md:px-4">Rarity</div>
        <ul class="hidden md:flex py-2 px-4 gap-1">
          <template x-for="rarity in rarities">
            <li>
              <button
                class="btn btn-outline btn-xs"
                :class="rarity.code === rarityFilter ? 'btn-active' : ''"
                @click="filterRarity(rarity.code)"
                x-text="rarity.title"
              >
              </button>
            </li>
          </template>
        </ul>
        <select
          class="md:hidden select select-secondary w-full"
          @change="filterRarity($event.target.value)"
        >
          <template x-for="rarity in rarities">
            <option
              :value="rarity.code"
              :selected="rarity.code === rarityFilter"
              x-text="rarity.title"></option>
          </template>
        </select>
        <!-- End Rarity -->
      </div>
      <input
        type="text"
        placeholder="Search"
        class="my-4 input input-bordered input-secondary w-full"
        x-model="searchText"
      />

      <ul class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          materialEntries.map(async (effectEntry) => {
            return (
              <li
                x-show={`filterMaterial({rarity:'${effectEntry.data.rarity}', title: '${effectEntry.data.title}'})`}
              >
                <Material code={effectEntry.data.code} />
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>

  <script>
    import { MATERIAL_RARITY } from "@data/material";
    import Alpine from "alpinejs";

    window.Alpine = Alpine;

    Alpine.data("dataset", () => ({
      searchText: "",
      rarityFilter: "ALL",
      rarities: [
        { title: "All", code: "ALL" },
        ...Object.keys(MATERIAL_RARITY).map((code) => ({
          title: MATERIAL_RARITY[code].title,
          code: MATERIAL_RARITY[code].value.toString(),
        })),
      ],

      filterMaterial({ rarity, title }) {
        const filters =
          this.rarityFilter === "ALL" || this.rarityFilter === rarity;

        return !this.searchText
          ? filters
          : filters &&
              title.toLowerCase().includes(this.searchText.toLowerCase());
      },

      filterRarity(rarity) {
        this.rarityFilter = rarity;
      },
    }));
  </script>
</Layout>
