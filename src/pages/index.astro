---
import Icon from "@components/Icon.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import Layout from "@layouts/Layout.astro";
import { getEntry, render } from "astro:content";

const whatsNewEntry = await getEntry("general", "whats-new")!;
const { Content } = await render(whatsNewEntry);
---

<Layout title="Reverse 1999 Gnomon">
  <main>
    <h1>Reverse:1999 Gnomon</h1>
    <h5 class="font-medium text-center">
      A fanmade website about game Reverse:1999
    </h5>
    <div
      class="mt-8 alert gap-2 md:gap-4 border border-primary bg-primary/20 shadow-lg"
      x-data
    >
      <Icon icon="star" />
      <div>
        <h4 class="my-0 text-primary">What's new</h4>
        <div class="text-xs">Updated on {whatsNewEntry.data.lastModified}</div>
      </div>
      <button class="btn btn-sm" @click="whatsNewModal.showModal()">See</button>

      <template x-teleport="body">
        <dialog id="whatsNewModal" class="modal p-4 md:p-8">
          <div
            class="modal-box w-full h-full max-w-screen-md max-h-[75%] border border-primary-content bg-base-100/80 backdrop-blur-sm flex flex-col p-4 md:p-6"
          >
            <form method="dialog">
              <button
                class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
              >
                <Icon icon="x" />
              </button>
            </form>
            <h3 class="my-2 md:mt-4">What's new</h3>
            <div class="flex-1 overflow-y-auto h-full">
              <Content
                components={{
                  ul: MarkdownDiscList,
                  p: MarkdownParagraphContent,
                  strong: MarkdownHighlight,
                  em: MarkdownEmphasis,
                }}
              />
            </div>
            <p class="pt-2 text-xs text-right">
              * Only show 10 latest updated dates
            </p>
          </div>
        </dialog>
      </template>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
      <a href="/characters">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Characters</h2>
            <p>Characters information</p>
          </div>
        </div>
      </a>
      <a href="/materials">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Materials</h2>
            <p>Materials, craft and cheatsheet</p>
          </div>
        </div>
      </a>
      <a href="/effects">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Effects</h2>
            <p>Common effects</p>
          </div>
        </div>
      </a>
      <a href="/a-series-of-dusks">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">A Series of Dusks</h2>
            <p>Roguelike gamemode</p>
          </div>
        </div>
      </a>
      <a href="/mane-bulletin">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Mane's Bulletin</h2>
            <p>Raid event</p>
          </div>
        </div>
      </a>
      <a href="/reveries-in-the-rain">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Reveries in the Rain</h2>
            <p>Gamemode for farming Euphoria materials</p>
          </div>
        </div>
      </a>
      <a href="/guides">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Guides</h2>
            <p>General guides</p>
          </div>
        </div>
      </a>
    </div>
  </main>
</Layout>
