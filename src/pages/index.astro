---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Reverse 1999 Gnomon">
  <main>
    <h1 class="text-6xl font-bold text-center">
      Welcome to <p class="text-primary">Reverse 1999 Gnomon</p>
    </h1>
    <p class="mt-12 text-xl text-center">
      A fanmade website to view info about game Reverse 1999
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4">
      <a href="/characters">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Characters</h2>
            <p>View info about characters</p>
          </div>
        </div>
      </a>
      <a href="/materials">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Materials</h2>
            <p>View info about materials</p>
          </div>
        </div>
      </a>
      <a href="/effects">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">Effects</h2>
            <p>View info about effects</p>
          </div>
        </div>
      </a>
      <a href="/a-series-of-dusks">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">A Series of Dusks</h2>
            <p>View info about A Series of Dusks</p>
          </div>
        </div>
      </a>
      <a href="/dev">
        <div class="card card-compact border border-primary">
          <div class="card-body">
            <h2 class="card-title">For Developer</h2>
            <p>For ones need tools to build</p>
          </div>
        </div>
      </a>
    </div>
  </main>
</Layout>
