---
import Icon from "@components/Icon.astro";
import Layout from "@layouts/Layout.astro";
import { getEntry } from "astro:content";

const whatsNewEntry = await getEntry("general", "whats-new")!;

const MENU = [
  {
    title: "Characters",
    desc: "Characters information",
    href: "/characters",
  },
  {
    title: "Psychubes",
    desc: "Psychubes information",
    href: "/psychubes",
  },
  {
    title: "Materials",
    desc: "Materials, craft and cheatsheet",
    href: "/materials",
  },
  {
    title: "Guides",
    desc: "General guides",
    href: "/guides",
  },
  {
    title: "A Series of Dusks",
    desc: "Roguelike gamemode",
    href: "/a-series-of-dusks",
  },
  {
    title: "Mane's Bulletin",
    desc: "Raid event",
    href: "/mane-bulletin",
  },
  {
    title: "Reveries in the Rain",
    desc: "Gamemode for farming Euphoria materials",
    href: "/reveries-in-the-rain",
  },
  {
    title: "Effects",
    desc: "Common effects",
    href: "/effects",
  },
];
---

<Layout title="Homepage">
  <main>
    <h1>Reverse:1999 Gnomon</h1>
    <h5 class="font-medium text-center">
      A fanmade website about game Reverse:1999
    </h5>
    <div
      class="mt-8 alert gap-2 md:gap-4 border border-primary bg-primary/20 shadow-lg"
      x-data
    >
      <Icon icon="news" />
      <div>
        <h4 class="my-0 text-primary">What's new</h4>
        <div class="text-xs">Updated on {whatsNewEntry.data.lastModified}</div>
      </div>
      <button class="btn btn-sm" @click="whatsNewModal.showModal()">See</button>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        MENU.map(({ title, desc, href }) => (
          <a href={href}>
            <div class="card card-compact border border-primary">
              <div class="card-body">
                <h2 class="card-title">{title}</h2>
                <p>{desc}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
