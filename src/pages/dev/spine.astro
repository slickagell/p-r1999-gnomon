---
import Layout from "@layouts/Layout.astro";
---

<Layout
  title="Dev"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Dev",
    },
  ]}
>
  <h1>Spine</h1>
  <div x-data="spine">
    <canvas id="canvas"></canvas>
    <button class="btn btn-primary text-white" @click="downloadCanvasAsImage">
      Download
    </button>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  import { init, screenshot, setIsScreenShotting } from "@scripts/spine";

  Alpine.data("spine", () => ({
    init() {
      this.loadSpine();
    },

    loadSpine() {
      init();
    },

    downloadCanvasAsImage() {
      setIsScreenShotting(true);

      setTimeout(function () {
        let canvasImage = screenshot;

        let xhr = new XMLHttpRequest();
        xhr.responseType = "blob";
        xhr.onload = function () {
          let a = document.createElement("a");
          a.href = window.URL.createObjectURL(xhr.response);
          a.download = "image_name.png";
          a.style.display = "none";
          document.body.appendChild(a);
          a.click();
          a.remove();
        };
        xhr.open("GET", canvasImage);
        xhr.send();
      }, 300);
    },
  }));
</script>
