---
import ResonateBoard from "@components/ResonateBoard.astro";
import Layout from "@layouts/Layout.astro";

const PIECES = [
  {
    id: "RP-X-01",
    image: "rp-x-01",
    shape: [
      [0, 1, 0],
      [1, 1, 1],
      [0, 1, 0],
    ],
    dimension: [3, 3],
  },
  {
    id: "RP-L-01",
    image: "rp-l-01",
    shape: [
      [1, 0],
      [1, 0],
      [1, 1],
    ],
    dimension: [3, 2],
  },
];
---

<Layout title="Resonate">
  <ResonateBoard maxResonateLevel={15} resonatePieces={PIECES} />
</Layout>
