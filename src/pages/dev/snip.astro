---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Snip">
  <h1>Snip</h1>
  <div x-data="snipImage">
    <div class="tabs">
      <button
        x-on:click="handleChangeActiveTab('stream')"
        class="tab tab-bordered"
        :class="(activeTab === 'stream') && 'tab-active'"
      >
        Stream
      </button>
      <button
        x-on:click="handleChangeActiveTab('upload')"
        class="tab tab-bordered"
        :class="(activeTab === 'upload') && 'tab-active'"
      >
        Upload file
      </button>
    </div>
    <div x-show="activeTab === 'stream'">
      <h2 class="mt-4 mb-2">Capture screen</h2>
      <div class="relative">
        <video
          id="video"
          class="w-full min-h-60"
          x-ref="video"
          autoplay
          @play="videoOnLoad"
        >
        </video>
        <canvas
          class="absolute top-0 left-0 w-full h-full z-10 cursor-pointer border border-primary-content"
          x-ref="videoAreaCanvas"
          @click="initCanvas"
          @mousedown="mouseDownOnCanvas"
          @mousemove="mouseMoveOnCanvas"
          @mouseup="mouseUpOnCanvas"></canvas>
      </div>
    </div>
    <div x-show="activeTab === 'upload'">
      <input
        x-ref="fileInput"
        type="file"
        accept="image/*"
        class="my-4 file-input file-input-bordered w-full cursor-pointer"
        @change="initUploadCanvas"
      />
      <div class="relative inline-block">
        <canvas
          class="w-full h-full pointer-events-none border border-primary-content"
          x-ref="imgCanvas"
        >
        </canvas>
        <canvas
          class="absolute top-0 left-0 w-full h-full z-10 border border-primary-content pointer-events-none"
          :class="!!uploadFile && 'cursor-pointer pointer-events-auto'"
          x-ref="fileAreaCanvas"
          @mousedown="mouseDownOnCanvas"
          @mousemove="mouseMoveOnCanvas"
          @mouseup="mouseUpOnCanvas"></canvas>
      </div>
    </div>
    <div class="mt-2 flex gap-4 flex-wrap justify-between items-start">
      <button class="btn btn-primary text-white" @click="reset">Reset</button>
      <p x-ref="hint" class="italic">
        Draw on the canvas above to select the text area.
      </p>
    </div>

    <div class="flex items-stretch min-h-60">
      <div class="flex-1 flex flex-col">
        <h2 class="mt-4 mb-2">Image</h2>
        <div class="flex-1 border border-primary-content aspect-video">
          <img id="my_img" class="image" x-ref="captureImg" />
        </div>
      </div>
      <div class="flex-1 flex flex-col">
        <h2 class="mt-4 mb-2">Result</h2>
        <div
          class="p-2 border border-primary-content flex-1 overflow-auto aspect-video"
          id="output"
          x-ref="output"
        >
        </div>
      </div>
    </div>
    <h2 class="mt-4 mb-2">Options</h2>
    <div class="p-2 border border-primary-content grid grid-cols-3 gap-2">
      <label class="label justify-start gap-2" for="automode">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="automode"
          name="automode"
          :checked="isAutoMode"
          @click="toggleAutoMode"
        />
        Auto Mode
      </label>
      <label class="label justify-start gap-2" for="showArea">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="showArea"
          name="showArea"
          :checked="isShowArea"
          @click="toggleShowArea"
        />
        Show Area
      </label>
      <label class="label justify-start gap-2" for="preprocess">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="preprocess"
          name="preprocess"
          :checked="isPreprocess"
          @click="togglePreprocess"
        />
        Preprocess Image
      </label>
      <label class="label justify-start gap-2" for="showImage">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="showImage"
          name="showImage"
          :checked="isShowImage"
          @click="toggleShowImage"
        />
        Show Image
      </label>
      <label class="label justify-start gap-2" for="dilate">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="dilate"
          name="dilate"
          :checked="isDilate"
          @click="toggleDilate"
        />
        Dilate
      </label>
      <label class="label justify-start gap-2" for="invertColor">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="invertColor"
          name="invertColor"
          :checked="isInvertColor"
          @click="toggleInvertColor"
        />
        Invert color
      </label>
      <label class="label justify-start gap-2" for="binarize">
        <input
          type="checkbox"
          class="toggle toggle-primary"
          id="binarize"
          name="binarize"
          :checked="isBinarize"
          @click="toggleBinarize"
        />
        Binarize
      </label>
      <label
        class="label justify-start gap-2 flex-wrap gap-2"
        for="blurImageRadius"
      >
        <span>Gaussian Blur</span>
        <input
          id="blurImageRadius"
          type="range"
          class="range range-primary"
          min="0"
          max="100"
          :value="blurImageRadius"
          @change="updateBlurImageRadius"
          @input="onChangeBlurImageRadius"
        />
        <span x-text="blurImageRadius / 100"></span>
      </label>
      <label
        class="label justify-start gap-2 flex-wrap gap-2"
        for="binarizeThreshold"
      >
        <span>Binarize Threshold</span>
        <input
          id="binarizeThreshold"
          type="range"
          class="range range-primary"
          min="0"
          max="100"
          :value="binarizeThreshold"
          @change="updateBinarizeThreshold"
          @input="onChangeBinarizeThreshold"
        />
        <span x-text="binarizeThreshold / 100"></span>
      </label>
    </div>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  import snipImage from "@scripts/snip-image";

  window.Alpine = Alpine;

  Alpine.data("snipImage", snipImage);
</script>
