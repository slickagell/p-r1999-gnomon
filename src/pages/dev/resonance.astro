---
import ResonanceBoard from "@components/ResonanceBoard.astro";
import RESONANCE_PIECES from "@data/resonance/common/pieces.json";
import RESONANCE_PATTERN_PIECES from "@data/resonance/common/pattern-pieces.json";
import Layout from "@layouts/Layout.astro";

const piecesData = Object.values(RESONANCE_PIECES).map((ele) => ({
  id: ele.id,
  total: 4,
  level: 1,
}));

const piecesPatternData = Object.values(RESONANCE_PATTERN_PIECES).map(
  (ele) => ({
    id: ele.id,
    total: 1,
    level: 1,
  }),
);

const allPiecesData = [...piecesData, ...piecesPatternData];

let pieceShapeFilterList: string[] = [];
let pieceBlocksFilterList: string[] = [];

allPiecesData.forEach((piece) => {
  const [pieceType, pieceShape, pieceBlocks, pieceId] = piece.id.split("_");
  if (!pieceShapeFilterList.includes(pieceShape)) {
    pieceShapeFilterList.push(pieceShape);
  }
  if (!pieceBlocksFilterList.includes(pieceBlocks)) {
    pieceBlocksFilterList.push(pieceBlocks);
  }
});

const PIECES: ResonanceInitPiecesType = Array.from(
  Array(allPiecesData.length),
  (_, index) => index + 1,
).reduce((prev, curr) => ({ ...prev, [curr]: allPiecesData }), {});
---

<Layout title="Resonance">
  <Fragment slot="meta"
    ><meta name="robots" content="noindex, nofollow" />
  </Fragment>
  <h1 class="text-6xl font-bold text-center">Resonance Dev</h1>
  <p class="text-2xl text-center my-2 font-bold text-primary">Notice</p>
  <p class="text-2xl text-center my-2">
    This is a dev page. It is only used for testing and fast generate data used
    in character resonance. All data is not accurate excepts data generated in
    textarea below.
    <br />
  </p>
  <ResonanceBoard
    maxResonanceLevel={15}
    resonancePieces={PIECES}
    isDev
    resonanceMainPiece="RP_X_5_01"
    resonancePatternPieces={{}}
    baseStats={{}}
    pieceShapeFilterList={pieceShapeFilterList.sort()}
    pieceBlocksFilterList={pieceBlocksFilterList.sort()}
  />
</Layout>
