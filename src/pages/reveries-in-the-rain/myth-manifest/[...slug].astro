---
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const mythManifestEntries = await getCollection(
    "reveries-in-the-rain",
    ({ id }) => {
      return id.includes("myth-manifest/") && !id.includes("mind-map/");
    }
  );
  return mythManifestEntries.map((entry) => ({
    params: { slug: entry.id.replace("myth-manifest/", "/") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Myth Manifest | Reveries in the Rain`}
  description={`${entry.data.title} is a myth manifest in Reveries in the Rain in Reverse: 1999.`}
  og={{
    imageUrl: `/images/reveries-in-the-rain/${entry.id}.png`,
  }}
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Reveries in the Rain",
      href: "/reveries-in-the-rain",
    },
    {
      label: `${entry.data.title}`,
    },
  ]}
>
  <div class="flex-1">
    <Content
      components={{
        ul: MarkdownDiscList,
        p: MarkdownParagraphContent,
        effect: EffectTooltip,
        strong: MarkdownHighlight,
        em: MarkdownEmphasis,
      }}
    />
  </div>
</Layout>
