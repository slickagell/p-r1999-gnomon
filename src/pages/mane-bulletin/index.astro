---
import AfflatusIcon from "@components/AfflatusIcon.astro";
import CharacterImg from "@components/CharacterMarkdown/CharacterImg.astro";
import CustomImage from "@components/CustomImage.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import MarkdownText from "@components/MarkdownText.astro";
import AFFLATUS_TYPE from "@data/common/character/afflatus-type.json";
import DMG_TYPE from "@data/common/character/dmg-type.json";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getCollection, getEntry, render } from "astro:content";

const maneBulletinEntry = await getEntry("mane-bulletin", "general")!;
const bossEntries = await getCollection("mane-bulletin", ({ id }) => {
  return id !== "general";
}).then((entries) =>
  entries.sort((a, b) => ("" + a.data.title).localeCompare(b.data.title))
);

const { Content } = await render(maneBulletinEntry);
---

<Layout
  title="Mane's Bulletin"
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Mane's Bulletin",
    },
  ]}
>
  <Content
    components={{
      img: CustomImage,
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      text: MarkdownText,
    }}
  />

  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
    {
      bossEntries.map((bossEntry) => (
        <a href={`/mane-bulletin/${bossEntry.id}`}>
          <div class="relative transition group max-w-80 mx-auto hover:-translate-y-2">
            <div class="absolute z-10 -top-2 left-2 w-8">
              <AfflatusIcon
                type={bossEntry.data.afflatus as keyof typeof AFFLATUS_TYPE}
              />
            </div>
            <div class="absolute z-10 -top-2 left-12 w-10 bg-neutral p-1">
              <CharacterImg
                variant="dmg-type"
                code={DMG_TYPE[bossEntry.data.dmgType].assetCode}
              />
            </div>
            <CustomImage
              src={`/images/mane-bulletin/bg_card.png`}
              alt={bossEntry.data.title}
              class="w-full transition"
            />
            <p class="absolute z-10 top-0 h-[17%] left-0 right-0 px-4 flex justify-center items-center text-2xl text-primary-content font-bold text-center transition group-hover:text-primary">
              {bossEntry.data.title}
            </p>
            <div class="absolute z-10 top-[22%] -m-6 left-0 overflow-hidden">
              <CustomImage
                src={`/images/mane-bulletin/${bossEntry.data.id}.png`}
                alt={bossEntry.data.title}
                class="w-full transition"
              />
            </div>
            <p class="absolute z-10 bottom-0 left-0 right-0 h-1/5 p-4 text-black">
              <span class="font-bold">Key unit feature:</span>{" "}
              {bossEntry.data.keyUnitFeature}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</Layout>
