---
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import MarkdownParagraphContent from "@components/MarkdownParagraphContent.astro";
import ResonanceBoard from "@components/ResonanceBoard.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Tooltip from "@components/Tooltip.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/markdown-layout.css";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const materialEntries = await getCollection("mane-bulletin");
  return materialEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={`${entry.data.title} | Mane's Bulletin`}
  breadcrumbs={[
    {
      label: "Home",
      href: "/",
    },
    {
      label: "Mane's Bulletin",
      href: "/mane-bulletin",
    },
    {
      label: entry.data.title,
    },
  ]}
>
  <Content
    components={{
      ul: MarkdownDiscList,
      p: MarkdownParagraphContent,
      effect: EffectTooltip,
      strong: MarkdownHighlight,
      tooltip: Tooltip,
      resonance: ResonanceBoard,
      toc: TableOfContents,
      em: MarkdownEmphasis,
    }}
  />
</Layout>
