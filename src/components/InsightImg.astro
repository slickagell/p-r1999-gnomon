---
import CustomImage from "@components/CustomImage.astro";

interface Props {
  insight?: "1" | "2" | "3";
  classNames?: string;
}

const { insight, classNames = "" } = Astro.props;
---

<Fragment>
  <CustomImage
    class={classNames}
    src={`/images/insight/insight-${insight}.png`}
    alt={`insight-${insight} icon`}
  />
</Fragment>
