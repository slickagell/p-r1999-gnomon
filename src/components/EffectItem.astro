---
import EFFECT_TYPE from "@data/common/effect/type.json";
import { render } from "astro:content";
import EffectTooltip from "./EffectTooltip.astro";
import MarkdownContent from "./MarkdownContent.astro";
import MarkdownHighlight from "./MarkdownHighlight.astro";

interface Props {
  effectEntry: any;
}

const { effectEntry } = Astro.props;
const { Content } = await render(effectEntry);
---

<div
  class="border p-4 flex flex-wrap justify-between md:justify-start"
  data-effect-type={effectEntry.data.type}
  data-effect-name={effectEntry.data.title}
>
  <h6 class="basis-2/3 md:basis-1/3">{effectEntry.data.title}</h6>
  <span class="basis-1/3 md:basis-1/6 px-2">
    {EFFECT_TYPE[effectEntry.data.type].title}
  </span>
  <div class="mt-2 md:mt-0 md:basis-1/2">
    <Content
      components={{
        p: MarkdownContent,
        strong: MarkdownHighlight,
        effect: EffectTooltip,
      }}
    />
  </div>
</div>
