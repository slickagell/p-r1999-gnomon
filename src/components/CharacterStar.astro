---
import CustomImage from "@components/CustomImage.astro";

interface Props {
  star: number;
}

const { star } = Astro.props;
---

<div class="flex justify-center gap-1">
  {
    Array.from({ length: star }).map(() => (
      <div>
        <CustomImage
          presetWidth={40}
          src="/images/characters/common/star.png"
          alt="star icon"
        />
      </div>
    ))
  }
</div>
