---
import { getCollection } from "astro:content";
import CustomImage from "@components/CustomImage.astro";

interface Props {
  code: string;
  size?: "small" | "medium" | "large";
  variant?: ("horizontal" | "vertical" | "tag-link")[];
  require?: number;
  withMetadata?: boolean;
  customClass?: string;
  id?: string;
}

const {
  code,
  size = "small",
  variant = ["horizontal"],
  require,
  withMetadata,
  customClass,
  id,
} = Astro.props;

const materialEntries = await getCollection("materials");

const materials = materialEntries.reduce((prev, curr) => {
  return {
    ...prev,
    slug: curr.id,
    [curr.data.code]: curr,
  };
}, {});

const material = materials[code];
---

{
  material && (
    <div
      class:list={[
        "flex justify-between items-center",
        {
          "flex-row": variant.includes("horizontal"),
          "flex-col": variant.includes("vertical"),
        },
        customClass,
      ]}
      {...(withMetadata && { ["data-rarity"]: material.data.rarity })}
      {...(id && { id })}
    >
      <div
        class:list={[
          "flex items-center",
          {
            "flex-row": variant.includes("horizontal"),
            "flex-col": variant.includes("vertical"),
          },
        ]}
      >
        <a
          href={
            variant.includes("tag-link")
              ? `#${material.id}`
              : `/materials/${material.id}`
          }
        >
          <div
            class:list={[
              "relative shrink-0",
              { "w-14 h-14": size === "small" },
              { "w-20 h-20": size === "medium" },
              { "w-32 h-32": size === "large" },
            ]}
          >
            <div>
              <CustomImage
                class="w-full h-full"
                src={`/images/materials/bg-rare-${material.data.rarity}.png`}
                alt={`material ${material.data.rare}`}
              />
            </div>
            <div
              class:list={[
                "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
                { "w-12": size === "small" },
                { "w-16": size === "medium" },
                { "w-24": size === "large" },
              ]}
            >
              <CustomImage
                src={`/images/materials/${material.data.image}`}
                alt={`material ${material.data.title}`}
              />
            </div>
          </div>
        </a>
        <a
          class:list={[
            "font-medium text-center",
            { "text-sm": size === "small" },
            { "text-base": size === "medium" },
            { "text-lg": size === "large" },
          ]}
          href={
            variant.includes("tag-link")
              ? `#${material.id}`
              : `/materials/${material.id}`
          }
        >
          {material.data.title}
        </a>
      </div>

      {require && (
        <span
          class:list={[
            "shrink-0 text-sm",
            {
              "ml-2": variant.includes("horizontal"),
            },
          ]}
        >
          <span class="text-xs">x</span>{" "}
          {require > 1000 ? `${require / 1000}k` : `${require}`}
        </span>
      )}
    </div>
  )
}
