---
import { getCollection } from "astro:content";
import CustomImage from "@components/CustomImage.astro";

interface Props {
  code: string;
  variant?: "small" | "medium" | "large";
  require?: number;
}

const { code, variant = "small", require } = Astro.props;

const materialEntries = await getCollection("materials");

const materials = materialEntries.reduce((prev, curr) => {
  return {
    ...prev,
    [curr.data.code]: curr,
  };
}, {});

const material = materials[code];
---

{
  material && (
    <div class="flex justify-between items-center">
      <div class="flex items-center">
        <a href={`/materials/${material.slug}`}>
          <div
            class:list={[
              "relative shrink-0",
              { "w-14 h-14": variant === "small" },
              { "w-20 h-20": variant === "medium" },
              { "w-32 h-32": variant === "large" },
            ]}
          >
            <div>
              <CustomImage
                class="w-full h-full"
                src={`/images/materials/bg-rare-${material.data.rarity}.png`}
                alt={`material ${material.data.rare}`}
              />
            </div>
            <div
              class:list={[
                "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
                { "w-12": variant === "small" },
                { "w-16": variant === "medium" },
                { "w-24": variant === "large" },
              ]}
            >
              <CustomImage
                src={`/images/materials/${material.data.image}`}
                alt={`material ${material.data.title}`}
              />
            </div>
          </div>
        </a>
        <a class="text-sm font-medium" href={`/materials/${material.slug}`}>
          {material.data.title}
        </a>
      </div>

      {require && (
        <span class="shrink-0 text-sm ml-2">
          <span class="text-xs">x</span>{" "}
          {require > 1000 ? `${require / 1000}k` : `${require}`}
        </span>
      )}
    </div>
  )
}
