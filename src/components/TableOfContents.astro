---
import Tooltip from "@components/Tooltip.astro";
import Icon from "@components/Icon.astro";

const props = Astro.props;
---

<div {...props} class="table-of-contents">
  <h2>Table of Contents</h2>
  <div id="toc">
    <slot />
  </div>
</div>

<div x-data="tocFloating">
  <template x-teleport="body">
    <div class="fixed bottom-20 right-0 z-40" x-show="isShowToc" x-cloak>
      <Tooltip
        contentCustomClass="table-of-contents list-disc list-inside max-h-[80vh] overflow-y-auto"
      >
        <button
          slot="toggle"
          x-transition
          class="btn btn-secondary rounded-l p-0 w-10 h-10 min-h-min"
        >
          <Icon icon="layout-list" />
        </button>
        <div x-ref="toc" x-effect="handleShow" x-node.clone-children="toc">
        </div>
      </Tooltip>
    </div>
  </template>
</div>

<script>
  import Alpine from "alpinejs";
  import anchor from "@alpinejs/anchor";

  Alpine.plugin(anchor);

  Alpine.data("tocFloating", () => ({
    isShowToc: false,

    handleShow() {
      this.$nextTick(() => {
        if (this.$refs.toc.hasChildNodes()) {
          this.isShowToc = true;
        }
      });
    },
  }));
</script>
