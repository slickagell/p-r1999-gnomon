---
import Icon from "@components/Icon.astro";

type ChapterType = {
  id: string;
  chapter?: number;
  title?: string;
  description?: string;
};

interface Props {
  chapters: ChapterType[];
}

const { chapters } = Astro.props;
---

<div x-data="dataset">
  <select
    class="select select-secondary w-full my-4"
    @change="changeChapter($event.target.value)"
  >
    <template x-for="chapter in chapters">
      <option
        x-text="'Chapter ' + chapter.chapter + ': ' + chapter.title"
        :value="chapter.id"
        :selected="activeChapterIdx === chapter.id"></option>
    </template>
  </select>
  <div class="flex gap-2 justify-center items-center" x-ref="topChapter">
    <button
      :disabled="activeChapterIdx === 0"
      class="disabled:opacity-30"
      @click="prevChapter"
    >
      <Icon icon="chevron-compact-left" />
    </button>
    <div>
      <p class="text-center">
        Chapter <span x-text="activeChapter.chapter"></span>
      </p>
      <p class="text-center" x-text="activeChapter.title"></p>
    </div>
    <button
      :disabled={`activeChapterIdx === ${chapters.length - 1}`}
      class="disabled:opacity-30"
      @click="nextChapter"
    >
      <Icon icon="chevron-compact-right" />
    </button>
  </div>
  <p class="mt-4 text-center italic" x-text="activeChapter.description"></p>
  <div class="divider"></div>

  <!-- Content -->
  <slot name="story-content" />

  <div class="divider"></div>
  <div class="flex gap-2 justify-center items-center">
    <button
      :disabled="activeChapterIdx === 0"
      class="disabled:opacity-30"
      @click="prevChapter"
    >
      <Icon icon="chevron-compact-left" />
    </button>
    <div>
      <p class="text-center">
        Chapter <span x-text="activeChapter.chapter"></span>
      </p>
      <p class="text-center" x-text="activeChapter.title"></p>
    </div>
    <button
      :disabled={`activeChapterIdx === ${chapters.length - 1}`}
      class="disabled:opacity-30"
      @click="nextChapter"
    >
      <Icon icon="chevron-compact-right" />
    </button>
  </div>
</div>

<script
  is:inline
  define:vars={{
    chapters: chapters,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("story", {
      chapters,
    });
  });
</script>

<script>
  import Alpine from "alpinejs";

  Alpine.data("dataset", () => ({
    chapters: [],
    activeChapterIdx: 0,
    activeChapter: {
      id: 0,
      chapter: "",
      title: "",
      description: "",
    },

    init() {
      this.chapters = this.$store.story.chapters.map((chapter, idx) => ({
        id: idx,
        chapter: chapter.chapter,
        title: chapter.title,
        description: chapter.description,
      }));
      this.renderChapter();
    },

    renderChapter() {
      const chapter = this.$store.story.chapters[this.activeChapterIdx];

      if (!chapter) {
        return;
      }

      this.activeChapter = {
        id: this.activeChapterIdx,
        chapter: chapter.chapter,
        title: chapter.title,
        description: chapter.description,
      };

      this.$nextTick(() => {
        this.scrollToTop();
      });
    },

    nextChapter() {
      this.activeChapterIdx++;
      this.renderChapter();
    },

    prevChapter() {
      this.activeChapterIdx--;
      this.renderChapter();
    },

    changeChapter(chapterId) {
      this.activeChapterIdx = +chapterId;
      this.renderChapter();
    },

    scrollToTop() {
      const topChapterPos =
        this.$refs.topChapter.getBoundingClientRect().top + window.scrollY - 72;
      window.scrollTo({ top: topChapterPos, behavior: "smooth" });
    },
  }));
</script>
