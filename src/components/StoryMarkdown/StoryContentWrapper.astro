---
import Icon from "@components/Icon.astro";

type ChapterType = {
  id: string;
  chapter?: number;
  title?: string;
  description?: string;
};

interface Props {
  chapters: ChapterType[];
}

const { chapters } = Astro.props;

const storyThemes = [
  {
    value: "story-default",
    label: "Default",
  },
  {
    value: "story-light",
    label: "Light",
  },
  {
    value: "story-fall",
    label: "Fall",
  },
];
---

<div x-data="story" class="relative -mx-4">
  <div class="px-4" x-ref="topChapter">
    <p class="text-center">
      Chapter <span x-text="activeChapter.chapter"></span>
    </p>
    <p
      class="text-center text-lg font-medium text-primary-content"
      x-text="activeChapter.title"
    >
    </p>
  </div>
  <p class="mt-3 px-4 text-center italic" x-text="activeChapter.description">
  </p>
  <div class="divider"></div>

  <!-- Content -->
  <div x-ref="storyContent" class="pt-1 px-4 pb-4" :data-theme="activeTheme">
    <slot name="story-content" />
  </div>

  <div class="divider"></div>

  <div
    class="sticky z-10 bottom-0 left-0 right-0 bg-base-300 border-t border-b border-primary/50 py-2 px-4 flex justify-between gap-4 items-center"
  >
    <button
      :disabled="activeChapterIdx === 0"
      class="disabled:opacity-30"
      @click="prevChapter"
    >
      <Icon icon="chevron-compact-left" />
    </button>
    <div class="flex-1 flex justify-center gap-2">
      <select
        class="select select-sm max-w-max w-full"
        @change="changeChapter($event.target.value)"
      >
        <template x-for="chapter in chapters">
          <option
            :value="chapter.id"
            :selected="activeChapterIdx === chapter.id"
          >
            <span x-text="'Chapter ' + chapter.chapter"></span>
            <span x-text="': ' + chapter.title"></span>
          </option>
        </template>
      </select>
      <select
        class="select select-sm max-w-max w-full"
        @change="changeTheme($event.target.value)"
      >
        {storyThemes.map((theme) => (
          <option
            value={theme.value}
            :selected=`activeTheme === '${theme.value}'`
          >
            {theme.label}
          </option>
        ))} 
      </select>
    </div>
    <button
      :disabled={`activeChapterIdx === ${chapters.length - 1}`}
      class="disabled:opacity-30"
      @click="nextChapter"
    >
      <Icon icon="chevron-compact-right" />
    </button>
  </div>
</div>

<script
  is:inline
  define:vars={{
    chapters: chapters,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("story", {
      chapters,
    });
  });
</script>

<script>
  import Alpine from "alpinejs";

  Alpine.data("story", () => ({
    activeTheme: "story-default",
    chapters: [],
    activeChapterIdx: 0,
    activeChapter: {
      id: 0,
      chapter: "",
      title: "",
      description: "",
    },

    init() {
      this.chapters = this.$store.story.chapters.map((chapter, idx) => ({
        id: idx,
        chapter: chapter.chapter,
        title: chapter.title,
        description: chapter.description,
      }));
      this.renderChapter();

      this.$nextTick(() => {
        this.$store.layout.goToTop.classList.add("bottom-[3.625rem]");
      });
    },

    renderChapter() {
      const chapter = this.$store.story.chapters[this.activeChapterIdx];

      if (!chapter) {
        return;
      }

      this.activeChapter = {
        id: this.activeChapterIdx,
        chapter: chapter.chapter,
        title: chapter.title,
        description: chapter.description,
      };

      this.$nextTick(() => {
        this.scrollToTop();
      });
    },

    nextChapter() {
      this.activeChapterIdx++;
      this.renderChapter();
    },

    prevChapter() {
      this.activeChapterIdx--;
      this.renderChapter();
    },

    changeChapter(chapterId) {
      this.activeChapterIdx = +chapterId;
      this.renderChapter();
    },

    scrollToTop() {
      const topChapterPos =
        this.$refs.topChapter.getBoundingClientRect().top + window.scrollY - 72;
      window.scrollTo({ top: topChapterPos, behavior: "smooth" });
    },

    changeTheme(theme) {
      this.activeTheme = theme;
    }
  }));
</script>
