---
import CardStar from "@components/CardStar.astro";
import CardType from "@components/CardType.astro";
import CustomImage from "@components/CustomImage.astro";
import CARD_TYPE from "@data/common/character/card-type.json";

interface Props {
  star?: string;
  type: keyof typeof CARD_TYPE;
  note: string;
}

const { star, type, note, ...props } = Astro.props;
---

<div class="paper-texture" {...props}>
  {star && <CardStar star={star} />}
  <slot />
  {
    note && (
      <div class="mt-2 pt-2 flex items-start">
        <CustomImage
          class="shrink-0 mt-1 mr-1 w-3"
          src="/images/card/note.png"
          alt="note icon"
        />
        <div class="text-gray">{note}</div>
      </div>
    )
  }
  <div class="mt-auto w-full pt-4">
    <div class="bg-base-100 w-full flex justify-center py-1">
      <CardType class="w-32" type={type} />
    </div>
  </div>
</div>
