---
import CustomImage from "@components/CustomImage.astro";

interface Props {
  variant:
    | "afflatus"
    | "dmg-type"
    | "signature"
    | "portrait"
    | "udimo"
    | "chibi"
    | "skill-1"
    | "skill-2"
    | "unique";
  id?: string;
  code?: string;
}

const { variant, id = "", code = "" } = Astro.props;
---

<Fragment>
  {
    (() => {
      switch (variant) {
        case "afflatus": {
          if (!code) return null;
          return (
            <CustomImage
              presetWidth={128}
              src={`/images/afflatus/af-${code}.png`}
              alt={`afflatus ${code}`}
            />
          );
        }
        case "dmg-type": {
          if (!code) return null;
          return (
            <CustomImage
              presetWidth={56}
              src={`/images/dmg-type/${code}.png`}
              alt={`damage type ${code}`}
            />
          );
        }
        case "signature": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={256}
              src={`/images/characters/${id}/signature.png`}
              alt="signature"
            />
          );
        }
        case "portrait": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={320}
              loading="eager"
              src={`/images/characters/${id}/portrait.png`}
              alt="portrait"
            />
          );
        }
        case "udimo": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={160}
              src={`/images/characters/${id}/udimo.png`}
              alt="udimo"
            />
          );
        }
        case "chibi": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={96}
              src={`/images/characters/${id}/chibi.png`}
              alt="chibi"
            />
          );
        }
        case "skill-1": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={192}
              src={`/images/characters/${id}/skill-1.png`}
              alt="skill-1"
            />
          );
        }
        case "skill-2": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={192}
              src={`/images/characters/${id}/skill-2.png`}
              alt="skill-2"
            />
          );
        }
        case "unique": {
          if (!id) return null;
          return (
            <CustomImage
              presetWidth={192}
              src={`/images/characters/${id}/unique.png`}
              alt="unique"
            />
          );
        }
        default:
          return null;
      }
    })()
  }
</Fragment>
