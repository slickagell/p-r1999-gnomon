---
import { getCollection } from "astro:content";
import MarkdownContent from "./MarkdownContent.astro";
import MarkdownEmphasis from "./MarkdownEmphasis.astro";
import MarkdownHighlight from "./MarkdownHighlight.astro";
import { EFFECT_TYPE } from "@constants/effect";
interface Props {
  code: string;
}

const { code, ...props } = Astro.props;

const effectEntries = await getCollection("effects");

const effects = effectEntries.reduce((prev, curr) => {
  return {
    ...prev,
    [curr.data.code]: curr,
  };
}, {});

const effect = effects[code];

const { Content } = await effect.render();
---

<span
  {...props}
  x-data="{isShow: false, isToggle: false}"
  class="inline-block relative"
>
  <span
    x-ref="content"
    @click="isToggle = !isToggle"
    @mouseenter="isShow = true"
    @mouseleave="isShow = false"
    class="text-effect cursor-pointer">[{effect.data.title}]</span
  >
  <div
    @mousedown.outside="isToggle = false"
    x-show="isShow || isToggle"
    x-anchor.top="$refs.content"
    class="bg-base-100 w-80 text-base-content border-line-paper border p-2 z-10"
    x-transition:enter="ease duration-300 transition-opacity"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="ease duration-300"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
  >
    <div class="flex justify-between items-center gap-1 mb-1">
      <p class="font-bold">{effect.data.title}</p>
      {
        !["UNKNOWN", "DEFINITION", "GENERAL"].includes(effect.data.type) && (
          <p class="badge badge-neutral shrink-0">
            {EFFECT_TYPE[effect.data.type].title}
          </p>
        )
      }
    </div>
    <Content
      components={{
        p: MarkdownContent,
        strong: MarkdownHighlight,
        em: MarkdownEmphasis,
        effect: Astro.self,
      }}
    />
  </div>
</span>

<script>
  import Alpine from "alpinejs";
  import anchor from "@alpinejs/anchor";

  Alpine.plugin(anchor);
</script>
