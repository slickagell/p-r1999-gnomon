---
import { capitalCase, kebabCase } from "change-case";
import CharacterImg from "./CharacterImg.astro";
import { twMerge } from "@scripts/utils";

interface Props {
  code: string;
  isInline?: boolean;
  customClass?: string;
}

const { code, isInline, customClass } = Astro.props;
---

<div class={twMerge("my-2", isInline && "my-0 inline-block", customClass)}>
  <a
    href={`/characters/${kebabCase(code)}`}
    class="transition hover:opacity-75"
  >
    <CharacterImg variant="headicon" id={kebabCase(code)} class="mr-2" />
    <span>{capitalCase(code)}</span>
  </a>
</div>
