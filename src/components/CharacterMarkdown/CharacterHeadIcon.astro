---
import { twMerge } from "@scripts/utils";
import { getEntry } from "astro:content";
import { kebabCase } from "change-case";
import CharacterImg from "./CharacterImg.astro";

interface Props {
  code: string;
  isInline?: boolean;
  customClass?: string;
  note?: string;
}

const { code, isInline, customClass, note } = Astro.props;

const characterEntry = await getEntry("characters", kebabCase(code))!;
---

<div class={twMerge("my-2", isInline && "my-0 inline-block", customClass)}>
  <a
    href={`/characters/${characterEntry.id}`}
    class="transition hover:opacity-75"
  >
    <CharacterImg variant="headicon" id={characterEntry.id} class="mr-2" />
    <span>{characterEntry.data.title}</span>{" "}
    <span set:html={note} />
    <slot name="note" />
  </a>
</div>
