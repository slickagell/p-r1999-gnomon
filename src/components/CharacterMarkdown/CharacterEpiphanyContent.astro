---
import Material from "@components/Material.astro";
import Tooltip from "@components/Tooltip.astro";

interface Props {
  epiphanyLevel: number;
  materials: {
    code: string;
    require: number;
  }[];
}

const { epiphanyLevel, materials } = Astro.props;
---

<div class="flex items-center justify-between gap">
  <h4>Epiphany {Array(epiphanyLevel).fill("I").join("")}</h4>
  <span class="label-text-alt">
    <Tooltip>
      <p slot="toggle" class="text-base-content flex items-center gap-1">
        Material
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          width="24"
          height="24"
          stroke-width="2"
        >
          <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
          <path d="M12 9h.01"></path>
          <path d="M11 12h1v4h1"></path>
        </svg>
      </p>
      <div>
        {
          materials.map((material) => (
            <Material code={material.code} require={material.require} />
          ))
        }
      </div>
    </Tooltip>
  </span>
</div>
