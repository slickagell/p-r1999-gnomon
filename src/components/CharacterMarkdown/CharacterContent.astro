---
import CharacterImg from "@components/CharacterMarkdown/CharacterImg.astro";
import CharacterStar from "@components/CharacterMarkdown/CharacterStar.astro";
import CustomImage from "@components/CustomImage.astro";
import Icon from "@components/Icon.astro";
import InsightImg from "@components/InsightImg.astro";
import Material from "@components/Material.astro";
import Tooltip from "@components/Tooltip.astro";
import AFFLATUS_TYPE from "@data/common/character/afflatus-type.json";
import DMG_TYPE from "@data/common/character/dmg-type.json";
import RACE from "@data/common/character/race.json";
import SPECIALTY from "@data/common/character/specialty.json";
type Props = {
  id: string;
  star: number;
  afflatus: string;
  dmgType: string;
  race: string;
  version: string;
  specialties: string[];
  isLimited: string;
  euphorias?: {
    code: string;
    name: string;
    materials: {
      [level: string]: {
        code: string;
        require: number;
      }[];
    }
  }[];
  insightMaterials?: {
    [insightLevel: string]: {
      code: string;
      require: number;
    }[];
  };
  resonanceMaterials?: {
    [resonanceLevel: string]: {
      code: string;
      require: number;
    }[];
  };
};

const {
  id,
  star,
  afflatus,
  dmgType,
  race,
  version,
  specialties,
  isLimited,
  euphorias,
  insightMaterials,
  resonanceMaterials,
} = Astro.props;

const hasSkill1Reinforced = Astro.slots.has("skill-1-cards-info-reinforced");
const hasSkill2Reinforced = Astro.slots.has("skill-2-cards-info-reinforced");
const hasTeamSuggestion = Astro.slots.has("team-suggestion-section-title");

const hasInsight3Info = Astro.slots.has("insight-3-info");
const hasInsight3Materials = insightMaterials?.["3"];
---

<div class="my-8">
  <CharacterStar star={star} />
</div>

<div class="flex justify-between flex-col-reverse md:flex-row gap-8">
  <div>
    <div
      class="flex gap-x-8 gap-y-2 items-center justify-center md:justify-start flex-wrap"
    >
      <CharacterImg
        variant="afflatus"
        code={AFFLATUS_TYPE[afflatus].assetCode}
      />

      <div class="flex gap-2 items-center">
        <CharacterImg variant="dmg-type" code={DMG_TYPE[dmgType].assetCode} />

        <h5>{DMG_TYPE[dmgType].title}</h5>
      </div>

      <div class="flex gap-2">
        <div class="badge badge-outline badge-primary">
          {RACE[race].title}
        </div>

        <div class="badge bg-base-content/20">
          {"Version " + version}
        </div>

        {isLimited && <div class="badge badge-primary text-white">Limited</div>}
      </div>
    </div>

    <div
      class="mt-2 flex gap-x-1 gap-y-2 justify-center md:justify-start items-center flex-wrap"
    >
      {
        specialties.map((specialty) => (
          <div class="badge badge-lg badge-outline opacity-80">
            {SPECIALTY[specialty].title}
          </div>
        ))
      }
    </div>

    <div class="mt-4">
      <slot name="info-description" />
      <h6>Medium</h6>
      <slot name="info-medium" />
      <h6>Afflatus</h6>
      <slot name="info-afflatus" />
      <h6>Fragrance note</h6>
      <slot name="info-fragrance-note" />
      <h6>Dimensions</h6>
      <slot name="info-dimensions" />
    </div>

    <div class="mt-4 flex gap-4 justify-center">
      <CharacterImg variant="signature" id={id} />
    </div>
  </div>

  <div class="flex flex-col items-center shrink-0">
    <CharacterImg variant="portrait" id={id} />

    <div class="mt-5 flex gap-6 justify-center items-end">
      <div class="text-center">
        <CharacterImg variant="chibi" id={id} />

        Chibi
      </div>

      <div class="text-center">
        <CharacterImg variant="udimo" id={id} />

        Udimo
      </div>
    </div>
  </div>
</div>

{/* TOC */}
<slot name="toc" />

{/* Arcane Skills */}
<slot name="arcane-skills-section-title" />

{/* Skill 1 */}
<slot name="skill-1-title" />
<div
  class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap lg:flex-nowrap"
  {...hasSkill1Reinforced && { ["x-data"]: "{ reinforced: false }" }}
>
  <div class="basis-full lg:basis-auto shrink-0">
    <CharacterImg variant="skill-1" id={id} />

    {
      hasSkill1Reinforced && (
        <div class="form-control">
          <label class="label w-fit gap-2 cursor-pointer">
            <span class="label-text">Reinforce</span>

            <input
              type="checkbox"
              class="checkbox checkbox-secondary"
              x-model="reinforced"
            />
          </label>
        </div>
      )
    }
  </div>

  {
    hasSkill1Reinforced ? (
      <Fragment>
        <template x-if="!reinforced">
          <div class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap">
            <slot name="skill-1-cards-info" />
          </div>
        </template>
        <template x-if="reinforced">
          <div class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap">
            <slot name="skill-1-cards-info-reinforced" />
          </div>
        </template>
      </Fragment>
    ) : (
      <slot name="skill-1-cards-info" />
    )
  }
</div>

{/* Skill 2 */}
<slot name="skill-2-title" />
<div
  class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap lg:flex-nowrap"
  {...hasSkill2Reinforced && { ["x-data"]: "{ reinforced: false }" }}
>
  <div class="basis-full lg:basis-auto shrink-0">
    <CharacterImg variant="skill-2" id={id} />

    {
      hasSkill2Reinforced && (
        <div class="form-control">
          <label class="label w-fit gap-2 cursor-pointer">
            <span class="label-text">Reinforce</span>

            <input
              type="checkbox"
              class="checkbox checkbox-secondary"
              x-model="reinforced"
            />
          </label>
        </div>
      )
    }
  </div>

  {
    hasSkill2Reinforced ? (
      <Fragment>
        <template x-if="!reinforced">
          <div class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap">
            <slot name="skill-2-cards-info" />
          </div>
        </template>
        <template x-if="reinforced">
          <div class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap">
            <slot name="skill-2-cards-info-reinforced" />
          </div>
        </template>
      </Fragment>
    ) : (
      <slot name="skill-2-cards-info" />
    )
  }
</div>

{/* Ultimate */}
<slot name="ultimate-title" />

<div
  class="flex gap-5 flex-col md:flex-row items-center md:items-stretch flex-wrap"
>
  <div class="basis-full lg:basis-auto shrink-0">
    <CharacterImg variant="ultimate" id={id} />
  </div>

  <slot name="ultimate-card-info" />
</div>
{/* Extra Cards */}
<slot name="extra-cards" />

{/* Inheritance */}
<slot name="inheritance-section-title" />

<slot name="inheritance-title" />

<div class="mt-4 flex items-center">
  <InsightImg classNames="w-8 mr-2" insight="1" />

  <h5 id="insight-1">Insight 1</h5>
</div>

<slot name="insight-1-info" />

<div class="mt-4 flex items-center">
  <InsightImg classNames="w-8 mr-2" insight="2" />

  <h5 id="insight-2">Insight 2</h5>
</div>

<slot name="insight-2-info" />

{
  hasInsight3Info && (
    <Fragment>
      <div class="mt-4 flex items-center">
        <InsightImg classNames="w-8 mr-2" insight="3" />

        <h5 id="insight-3">Insight 3</h5>
      </div>

      <slot name="insight-3-info" />
    </Fragment>
  )
}

{/* Portray */}
<slot name="portray-section-title" />

<span class="text-2xl mr-2">Lv. 1:</span>
<slot name="portray-1-info" />

<span class="text-2xl mr-2">Lv. 2:</span>
<slot name="portray-2-info" />

<span class="text-2xl mr-2">Lv. 3:</span>
<slot name="portray-3-info" />

<span class="text-2xl mr-2">Lv. 4:</span>
<slot name="portray-4-info" />

<span class="text-2xl mr-2">Lv. 5:</span>
<slot name="portray-5-info" />

{/* Resonance */}
<slot name="resonance-section-title" />

<slot name="resonance-board" />

{/* Psychube */}
<slot name="psychube-section-title" />

<slot name="psychube-content" />

{/* Euphoria */}
{
  euphorias && euphorias.length > 0 && (
    <>
      <slot name="euphoria-section-title" />
      <div x-data={`{active: '${euphorias[0].code}'}`}>
        <div class="tabs tabs-boxed">
          {euphorias?.map((euphoria, idx) => (
            <button
              @click={`active = '${euphoria.code}'`}
              class="tab"
              :class={`(active === '${euphoria.code}') && 'tab-active !text-white'`}
            >
              {euphoria.name}
            </button>
          ))}
        </div>
        <div class="mt-4 flex flex-col md:flex-row gap-4 md:gap-10">
          <div class="shrink-0 md:basis-1/3" >
            {euphorias?.map((euphoria, idx) => (
              <div x-show={`active === '${euphoria.code}'`} x-cloak>
                <div class="border rounded border-primary/25 relative mb-4">
                <CustomImage
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
                    src={`/images/euphoria/bg.png`}
                    alt="euphoria bg"
                  />
                  <CustomImage
                    class="relative w-full z-10"
                    src={`/images/euphoria/${euphoria.code}.png`}
                    alt="udimo"
                  />
                </div>
                <span class="label-text-alt">
                  <Tooltip>
                    <p slot="toggle" class="text-base-content flex items-center gap-1">
                      Unlock Material
                      <Icon icon="info-circle" />
                    </p>
                    <div>
                      {
                        euphoria.materials[0].map((material) => (
                          <Material code={material.code} require={material.require} />
                        ))
                      }
                    </div>
                  </Tooltip>
                </span>
              </div>
            ))}
          </div>
          <div>      
            <slot name="euphoria-content" />
          </div>
        </div>
      </div>
    </>
  )
}

{/* How to play */}
<slot name="how-to-play-section-title" />

<slot name="how-to-play-content" />

{/* Team suggestion */}
<slot name="team-suggestion-section-title" />

{hasTeamSuggestion && (
  <div class="mb-6 md:grid md:grid-cols-3">
    <div>
      <slot name="team-suggestion-dps" />
    </div>

    <div>
      <slot name="team-suggestion-support" />
    </div>

    <div>
      <slot name="team-suggestion-sustain" />
    </div>
  </div>

  <slot name="team-suggestion-exception" />
)}

{/* Insight Materials */}
{
  insightMaterials && (
    <div x-data="{isShowTotal: false}">
      <slot name="insight-materials-section-title" />

      <div class="flex items-center justify-end">
        <label class="cursor-pointer label gap-2">
          <span class="label-text">Total</span>
          <input
            type="checkbox"
            class="toggle toggle-primary"
            x-model="isShowTotal"
          />
        </label>
      </div>

      <template x-if="!isShowTotal">
        <div class="flex flex-col md:flex-row flex-wrap justify-center">
          <div
            class:list={[
              "md:basis-1/2  md:px-2",
              { "lg:basis-1/3": hasInsight3Materials },
            ]}
          >
            <div class="flex items-center">
              <InsightImg classNames="w-6 mr-2" insight="1" />

              <h5 id="insight-1">Insight 1</h5>
            </div>

            {insightMaterials["1"].map((material) => (
              <Material code={material.code} require={material.require} />
            ))}
          </div>

          <div
            class:list={[
              "md:basis-1/2  md:px-2",
              { "lg:basis-1/3": hasInsight3Materials },
            ]}
          >
            <div class="flex items-center">
              <InsightImg classNames="w-6 mr-2" insight="2" />

              <h5 id="insight-2">Insight 2</h5>
            </div>
            {insightMaterials["2"].map((material) => (
              <Material code={material.code} require={material.require} />
            ))}
          </div>

          {hasInsight3Materials && (
            <div class="md:basis-1/2 lg:basis-1/3 md:px-2">
              <div class="flex items-center">
                <InsightImg classNames="w-6 mr-2" insight="3" />

                <h5 id="insight-3">Insight 3</h5>
              </div>

              {insightMaterials["3"].map((material) => (
                <Material code={material.code} require={material.require} />
              ))}
            </div>
          )}
        </div>
      </template>

      <template x-if="isShowTotal">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2"
          x-data="sortMaterials"
        >
          {insightMaterials &&
            Object.values(
              JSON.parse(JSON.stringify(insightMaterials)) as {
                [insightLevel: string]: {
                  code: string;
                  require: number;
                }[];
              }
            )
              .reduce((accumulator, currentValue) => {
                currentValue.forEach((material) => {
                  if (accumulator.some((m) => m.code === material.code)) {
                    const index = accumulator.findIndex(
                      (m) => m.code === material.code
                    );
                    accumulator[index].require += material.require;
                  } else {
                    accumulator.push(material);
                  }
                });
                return accumulator;
              }, [])
              .map((material) => (
                <Material
                  code={material.code}
                  require={material.require}
                  withMetadata
                />
              ))}
        </div>
      </template>
    </div>
  )
}

{/* Resonance Materials */}
{
  resonanceMaterials && (
    <div x-data="{isShowTotal: false}">
      <slot name="resonance-materials-section-title" />

      <div class="flex items-center justify-end">
        <label class="cursor-pointer label gap-2">
          <span class="label-text">Total</span>
          <input
            type="checkbox"
            class="toggle toggle-primary"
            x-model="isShowTotal"
          />
        </label>
      </div>

      <template x-if="!isShowTotal">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 md:gap-x-5">
          {Object.entries(resonanceMaterials).map(
            ([resonanceLevel, materials]) => (
              <div>
                <h5>Lv. {resonanceLevel}</h5>
                {materials.map((material) => (
                  <Material code={material.code} require={material.require} />
                ))}
              </div>
            )
          )}
        </div>
      </template>

      <template x-if="isShowTotal">
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2"
          x-data="sortMaterials"
        >
          {Object.values(
            JSON.parse(JSON.stringify(resonanceMaterials)) as {
              [resonanceLevel: string]: {
                code: string;
                require: number;
              }[];
            }
          )
            .reduce((accumulator, currentValue) => {
              currentValue.forEach((material) => {
                if (accumulator.some((m) => m.code === material.code)) {
                  const index = accumulator.findIndex(
                    (m) => m.code === material.code
                  );
                  accumulator[index].require += material.require;
                } else {
                  accumulator.push(material);
                }
              });
              return accumulator;
            }, [])
            .map((material) => (
              <Material
                code={material.code}
                require={material.require}
                withMetadata
              />
            ))}
        </div>
      </template>
    </div>
  )
}

<script>
  import Alpine from "alpinejs";

  Alpine.data("sortMaterials", () => ({
    init() {
      const sorted = Array.from(this.$el.children as HTMLCollection).sort(
        (a, b) => {
          return (a.getAttribute("data-rarity") ?? 0) >
            (b.getAttribute("data-rarity") ?? 0)
            ? 1
            : -1;
        }
      );

      this.$el.replaceChildren(...sorted);
    },
  }));
</script>
