---
import CustomImage from "@components/CustomImage.astro";
import Tooltip from "@components/Tooltip.astro";

interface Props {
  id?: string;
  gameId?: string;
  variant: "skill-1" | "skill-2" | "ultimate";
}

const { id, gameId, variant } = Astro.props;
---

<Tooltip contentCustomClass="w-24">
  <slot slot="toggle" />
  {
    (() => {
      switch (variant) {
        case "skill-1": {
          if (!gameId) return null;
          return (
            <CustomImage
              class={"w-24"}
              src={`/images/skill/${gameId}0111.png`}
              alt="skill-1"
            />
          );
        }
        case "skill-2": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-24"
              src={`/images/skill/${gameId}0121.png`}
              alt="skill-2"
            />
          );
        }
        case "ultimate": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-24"
              src={`/images/skill/${gameId}0131.png`}
              alt="ultimate"
            />
          );
        }
        default:
          return null;
      }
    })()
  }
</Tooltip>
