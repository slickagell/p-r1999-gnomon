---
import CustomImage from "@components/CustomImage.astro";
import { twMerge } from "@scripts/utils";

interface Props {
  variant:
    | "afflatus"
    | "dmg-type"
    | "signature"
    | "portrait"
    | "udimo"
    | "chibi"
    | "skill-1"
    | "skill-2"
    | "ultimate"
    | "headicon"
    | "infographic";
  id?: string;
  code?: string;
  class?: string;
}

const { variant, id = "", code = "", class: customClass } = Astro.props;
---

<Fragment>
  {
    (() => {
      switch (variant) {
        case "afflatus": {
          if (!code) return null;
          return (
            <CustomImage
              class={twMerge("w-32", customClass)}
              src={`/images/afflatus/af-${code}.png`}
              alt={`afflatus ${code}`}
            />
          );
        }
        case "dmg-type": {
          if (!code) return null;
          return (
            <CustomImage
              class="w-14"
              src={`/images/dmg-type/${code}.png`}
              alt={`damage type ${code}`}
            />
          );
        }
        case "signature": {
          if (!id) return null;
          return (
            <CustomImage
              class="w-64"
              src={`/images/characters/${id}/signature.png`}
              alt="signature"
            />
          );
        }
        case "portrait": {
          if (!id) return null;
          return (
            <CustomImage
              class="w-80"
              loading="eager"
              src={`/images/characters/${id}/portrait.png`}
              alt="portrait"
            />
          );
        }
        case "udimo": {
          if (!id) return null;
          return (
            <CustomImage
              class="w-40"
              src={`/images/characters/${id}/udimo.png`}
              alt="udimo"
            />
          );
        }
        case "chibi": {
          if (!id) return null;
          return (
            <CustomImage
              class="w-24"
              src={`/images/characters/${id}/chibi.png`}
              alt="chibi"
            />
          );
        }
        case "skill-1": {
          if (!id) return null;
          return (
            <CustomImage
              class={twMerge("w-48", customClass)}
              src={`/images/characters/${id}/skill-1.png`}
              alt="skill-1"
            />
          );
        }
        case "skill-2": {
          if (!id) return null;
          return (
            <CustomImage
              class={twMerge("w-48", customClass)}
              src={`/images/characters/${id}/skill-2.png`}
              alt="skill-2"
            />
          );
        }
        case "ultimate": {
          if (!id) return null;
          return (
            <CustomImage
              class={twMerge("w-48", customClass)}
              src={`/images/characters/${id}/ultimate.png`}
              alt="ultimate"
            />
          );
        }
        case "headicon": {
          if (!id) return null;
          return (
            <CustomImage
              class={twMerge("w-12 inline-block", customClass)}
              src={`/images/characters/${id}/headicon.png`}
              alt="headicon"
            />
          );
        }
        case "infographic": {
          if (!id) return null;
          return (
            <div x-data class={twMerge("w-full", customClass)}>
              <CustomImage
                x-zoomable
                src={`/images/characters/${id}/infographic.jpg`}
                alt="infographic"
              />
            </div>
          );
        }
        default:
          return null;
      }
    })()
  }
</Fragment>

<script>
  import Alpine from "alpinejs";
  import { Zoomable } from "@scripts/plugin";

  Alpine.plugin(Zoomable);
</script>
