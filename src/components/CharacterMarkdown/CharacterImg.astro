---
import CustomImage from "@components/CustomImage.astro";
import { twMerge } from "@scripts/utils";

interface Props {
  variant:
    | "afflatus"
    | "dmg-type"
    | "signature"
    | "portrait"
    | "udimo"
    | "chibi"
    | "skill-1"
    | "skill-2"
    | "ultimate"
    | "headicon"
    | "infographic";
  gameId?: string;
  customImgGameId?: string;
  id?: string;
  code?: string;
  class?: string;
}

const {
  variant,
  id = "",
  gameId = "",
  customImgGameId = "",
  code = "",
  class: customClass,
} = Astro.props;
---

<Fragment>
  {
    (() => {
      switch (variant) {
        case "afflatus": {
          if (!code) return null;
          return (
            <CustomImage
              class={twMerge("w-32", customClass)}
              src={`/images/afflatus/af-${code}.png`}
              alt={`afflatus ${code}`}
            />
          );
        }
        case "dmg-type": {
          if (!code) return null;
          return (
            <CustomImage
              class="w-14"
              src={`/images/dmg-type/${code}.png`}
              alt={`damage type ${code}`}
            />
          );
        }
        case "signature": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-64"
              src={`/images/signature/${gameId}.png`}
              alt="signature"
            />
          );
        }
        case "portrait": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-80"
              loading="eager"
              src={
                customImgGameId
                  ? `/images/portrait/${customImgGameId}.png`
                  : `/images/portrait/${gameId}01.png`
              }
              alt="portrait"
            />
          );
        }
        case "udimo": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-40"
              src={
                customImgGameId
                  ? `/images/udimo/${customImgGameId}.png`
                  : `/images/udimo/${gameId}01.png`
              }
              alt="udimo"
            />
          );
        }
        case "chibi": {
          if (!gameId) return null;
          return (
            <CustomImage
              class="w-24"
              src={
                customImgGameId
                  ? `/images/chibi/${customImgGameId}.png`
                  : `/images/chibi/${gameId}01.png`
              }
              alt="chibi"
            />
          );
        }
        case "skill-1": {
          if (!gameId) return null;
          return (
            <div class="skill-card-border">
              <CustomImage
                class={twMerge(" w-48", customClass)}
                src={`/images/skill/${gameId}0111.png`}
                alt="skill-1"
              />
            </div>
          );
        }
        case "skill-2": {
          if (!gameId) return null;
          return (
            <div class="skill-card-border">
              <CustomImage
                class={twMerge("w-48", customClass)}
                src={`/images/skill/${gameId}0121.png`}
                alt="skill-2"
              />
            </div>
          );
        }
        case "ultimate": {
          if (!gameId) return null;
          return (
            <div class="ultimate-card-border">
              <CustomImage
                class={twMerge("w-48", customClass)}
                src={`/images/skill/${gameId}0131.png`}
                alt="ultimate"
              />
            </div>
          );
        }
        case "headicon": {
          if (!gameId) return null;
          return (
            <CustomImage
              class={twMerge("w-9 md:w-12 inline-block", customClass)}
              src={`/images/headicon/${gameId}01.png`}
              alt="headicon"
            />
          );
        }
        case "infographic": {
          if (!gameId) return null;
          return (
            <div x-data class={twMerge("w-full", customClass)}>
              <CustomImage
                x-zoomable
                src={`/images/infographic/${gameId}.jpg`}
                alt="infographic"
              />
            </div>
          );
        }
        default:
          return null;
      }
    })()
  }
</Fragment>

<script>
  import Alpine from "alpinejs";
  import { Zoomable } from "@scripts/plugin";

  Alpine.plugin(Zoomable);
</script>
