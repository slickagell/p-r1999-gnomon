---
import CustomImage from "@components/CustomImage.astro";
import { getEntry } from "astro:content";
import { kebabCase } from "change-case";

interface Props {
  param: string;
  size?: "small" | "medium" | "large";
  variant?: ("horizontal" | "vertical")[];
  customClass?: string;
}

const {
  param,
  size = "medium",
  variant = ["vertical"],
  customClass,
} = Astro.props;

const psychubeEntry = await getEntry("psychubes", param)!;
---

<div
  class:list={[
    "flex items-center",
    {
      "flex-row": variant.includes("horizontal"),
      "flex-col": variant.includes("vertical"),
    },
    customClass,
  ]}
>
  <a href={`/psychubes/${psychubeEntry.id}`}>
    <div
      class:list={[
        "relative shrink-0 mx-auto",
        { "w-20": size === "small" },
        { "w-28": size === "medium" },
        { "w-32": size === "large" },
      ]}
    >
      <CustomImage
        src={"/images/psychubes/icons/" + psychubeEntry.data.image}
        alt={psychubeEntry.data.title}
      />
    </div>
  </a>
  <a href={`/psychubes/${psychubeEntry.id}`}>
    <span class="text-base-content">
      {psychubeEntry.data.title}
    </span>
  </a>
</div>
