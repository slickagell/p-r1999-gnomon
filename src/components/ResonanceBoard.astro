---
import InsightImg from "./InsightImg.astro";

const BLOCK_SIZE = 40;
const BOARD_X = 40;
const BOARD_Y = 40;
const DEFAULT_RESONATE_LEVEL = 10;

interface Props {
  maxResonanceLevel: number;
  resonancePieces: ResonanceInitPiecesType;
  recommendedResonanceList?: ResonanceRecommendedListType;
  isDev?: boolean;
}

const { maxResonanceLevel, resonancePieces, recommendedResonanceList, isDev } =
  Astro.props;

const initialActiveResonanceLevel =
  maxResonanceLevel > DEFAULT_RESONATE_LEVEL
    ? DEFAULT_RESONATE_LEVEL
    : maxResonanceLevel;
---

<div x-data="dataset">
  <div class="flex flex-col md:flex-row gap-4 items-end mb-4">
    <div class="w-full">
      <div
        id="attributes"
        x-data="attributes"
        class="p-4 md:p-6 border basis-1/2 flex gap-4"
      >
        <div class="basis-1/3">
          <div class="flex gap-2 items-center">
            <p class="text-primary-content">Level:</p>
            <p class="text-base-content text-xl" x-text="level"></p>
          </div>
          <div class="flex gap-2 items-center">
            <p class="text-primary-content">Insight:</p>
            <InsightImg classNames="w-10" insight="3" />
          </div>
        </div>
        <div class="basis-2/3">
          <div class="flex gap-2 items-center justify-between">
            <p class="text-primary-content" x-text="baseStats.HP.label"></p>
            <p class="text-base-content" x-text="baseStats.HP.value"></p>
          </div>
          <div class="flex gap-2 items-center justify-between">
            <p class="text-primary-content" x-text="baseStats.ATTACK.label"></p>
            <p class="text-base-content" x-text="baseStats.ATTACK.value"></p>
          </div>
          <div class="flex gap-2 items-center justify-between">
            <p
              class="text-primary-content"
              x-text="baseStats.REALITY_DEFENSE.label"
            >
            </p>
            <p
              class="text-base-content"
              x-text="baseStats.REALITY_DEFENSE.value"
            >
            </p>
          </div>
          <div class="flex gap-2 items-center justify-between">
            <p
              class="text-primary-content"
              x-text="baseStats.MENTAL_DEFENSE.label"
            >
            </p>
            <p
              class="text-base-content"
              x-text="baseStats.MENTAL_DEFENSE.value"
            >
            </p>
          </div>
          <div class="flex gap-2 items-center justify-between">
            <p
              class="text-primary-content"
              x-text="baseStats.CRITICAL_TECHNIQUE.label"
            >
            </p>
            <p
              class="text-base-content"
              x-text="baseStats.CRITICAL_TECHNIQUE.value"
            >
            </p>
          </div>
        </div>
      </div>
      <div class="mt-4 flex basis-1/2 overflow-auto">
        <template x-for="i in $store.resonance.maxResonanceLevel">
          <button
            class="btn btn-outline shrink-0"
            :class="i === activeResonanceLevel?'btn-outline btn-primary':''"
            @click="changeResonanceLevel(i)"
            x-text="i"></button>
        </template>
      </div>
    </div>
    <div
      id="generalStats"
      x-data="generalStats"
      class="p-4 md:p-6 border w-full md:basis-1/2"
    >
      <template x-for="[, stat] in Object.entries(stats)">
        <div
          class="flex gap-2 items-center justify-between"
          :class="stat.value > 0 ? 'opacity-100' : 'opacity-30'"
        >
          <p x-text="stat.label" class="text-primary-content"></p>
          <p x-text="'+'+stat.value+stat.unit"></p>
        </div>
      </template>
    </div>
  </div>
  <div
    class="resonance relative z-10 flex flex-col md:flex-row gap-4 md:h-[80vh] w-full"
    @mousemove="onMouseMove"
    @mousedown="onMouseDown"
    @mouseup="onMouseUp"
    @touchmove="onMouseMove"
    @touchstart="onMouseDown"
    @touchend="onMouseUp"
  >
    <div class="flex-1">
      <canvas
        x-ref="canvas"
        class="border w-full h-full absolute top-0 left-0 bg-white/10 -z-10"
      ></canvas>
      <canvas x-ref="boardCanvas" class="absolute top-0 left-0 -z-20"></canvas>

      <div
        :style="{padding: boardY + 'px' + ' ' + boardX + 'px', width: (boardCol * blockSize + boardX * 2) + 'px', height: (boardRow * blockSize + boardY * 2) + 'px'}"
      >
      </div>

      <template x-for="block in blocks" :key="block.id">
        <div
          x-bind:data-block-id="block.id"
          x-data="{ x: block.pos.x, y: block.pos.y, size: block.size, isDragOver: false}"
          class="border absolute select-none"
          x-bind:class="(block.isNotValid ? 'bg-error' : '') || (block.isCollided ? 'bg-secondary/20 cursor-grab' : '') || (isDragOver ? 'bg-primary' : '')"
          x-bind:style="{ left: x + 'px', top: y + 'px', width: size + 'px', height: size + 'px' }"
        >
        </div>
      </template>

      <div class="mx-4">
        <label
          x-show="recommendedOptions.length"
          x-ref="recommendedSelect"
          id="recommendedSelect"
        >
          Recommended
        </label>
        <select
          id="recommendedSelect"
          class="select select-secondary select-bordered flex w-full"
          @change="changeRecommended($event.target.value)"
        >
          <template x-for="resonance in recommendedOptions">
            <option
              x-text="resonance.label"
              :value="resonance.value"
              :selected="resonance.value === selectedRecommended"></option>
          </template>
        </select>
      </div>
    </div>

    <div
      class="p-4 h-full basis-1/2 overflow-auto flex flex-row md:flex-col gap-6"
    >
      <template x-for="item in activeResonancePieces">
        <div
          x-data={`piece({ id: item.id, total: item.total, orientation: item.orientation, level: item.level, stats: item.stats })`}
          class="flex flex-col md:flex-row gap-4"
        >
          <div>
            <div class="relative" :style="{ minWidth: 4 * blockSize + 'px' }">
              <div
                class="touch-none"
                :data-piece-id="item.id"
                :class="quantity>0?'cursor-pointer':''"
                :style={`{width: item.dimension[1] * blockSize + 'px', height: item.dimension[0] * blockSize + 'px'}`}
              >
              </div>
              <img
                :data-piece-img-id="item.id"
                :style={`{width: item.dimension[1] * blockSize + 'px', height: item.dimension[0] * blockSize + 'px', top: '0px',left: '0px'}`}
                :src="'/data/resonance/pieces/' + item.image"
                :alt="item.id"
                class={`absolute pointer-events-none select-none rotate-0 max-w-max`}
              />
            </div>
            <p
              class="mt-1 flex gap-2 justify-end pointer-events-none select-none"
            >
              {isDev && <span class="badge select-text" x-text="item.id" />}
              <span
                x-text="quantity"
                :class="quantity === 0 ? 'text-error' : ''"></span>
              /
              <span x-text="total"></span>
            </p>
          </div>

          <div class="md:flex-1">
            <p
              x-text="'Lv. ' + item.level"
              x-effect="updateCurrentStats(item.level)"
              class="text-primary text-xl"
            >
            </p>
            <template x-for="[,stat] in Object.entries(currentStats)">
              <div class="flex gap-2 items-center justify-between">
                <p x-text="stat.label" class="text-primary-content"></p>
                <p x-text="'+'+stat.value+stat.unit"></p>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>
  {
    isDev && (
      <textarea
        rows="10"
        class="textarea textarea-secondary w-full"
        x-model="printResonanceGeoJsonList()"
      />
    )
  }
</div>

<script
  define:vars={{
    resonancePieces,
    maxResonanceLevel,
    initialActiveResonanceLevel,
    blockSize: BLOCK_SIZE,
    boardX: BOARD_X,
    boardY: BOARD_Y,
    defaultResonanceLevel: DEFAULT_RESONATE_LEVEL,
    recommendedResonanceList,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("resonance", {
      resonancePieces,
      maxResonanceLevel,
      initialActiveResonanceLevel,
      blockSize,
      boardX,
      boardY,
      defaultResonanceLevel,
      recommendedResonanceList,
    });
  });
</script>

<script>
  import { STATS } from "@data/character";
  import resonanceDataSet from "@scripts/resonance-data-set";
  import resonancePiece from "@scripts/resonance-piece";
  import resonanceGeneralStats from "@scripts/resonance-general-stats";
  import Alpine from "alpinejs";

  window.Alpine = Alpine;

  Alpine.data("dataset", resonanceDataSet);
  Alpine.data("piece", resonancePiece);
  Alpine.data("attributes", () => ({
    level: 60,
    insight: 3,
    baseStats: {
      HP: {
        label: STATS["HP"].label,
        value: 5543,
      },
      ATTACK: {
        label: STATS["ATTACK"].label,
        value: 1199,
      },
      REALITY_DEFENSE: {
        label: STATS["REALITY_DEFENSE"].label,
        value: 505,
      },
      MENTAL_DEFENSE: {
        label: STATS["MENTAL_DEFENSE"].label,
        value: 582,
      },
      CRITICAL_TECHNIQUE: {
        label: STATS["CRITICAL_TECHNIQUE"].label,
        value: 436,
      },
    },
  }));
  Alpine.data("generalStats", resonanceGeneralStats);
</script>
