---
import CustomImage from "@components/CustomImage.astro";
import InsightImg from "@components/InsightImg.astro";
import Material from "@components/Material.astro";
import Tooltip from "@components/Tooltip.astro";
import { RESONANCE_PATTERN } from "@constants/resonance";
import RESONANCE_PATTERN_PIECES from "@data/resonance/common/pattern-pieces.json";

const DEFAULT_RESONATE_LEVEL = 10;

interface Props {
  maxResonanceLevel: number;
  resonancePieces: ResonanceInitPiecesType;
  recommendedResonancePattern?: string;
  recommendedResonanceList?: ResonanceRecommendedListType;
  resonanceMainPiece: string;
  resonancePatternPieces: {
    [pattern: string]: {
      materials: {
        code: string;
        require: number;
      }[];
      baseStats: ResonancePieceStatsGeneralType;
    };
  };
  isDev?: boolean;
  pieceShapeFilterList?: string[];
  pieceBlocksFilterList?: string[];
  baseStats: {
    [insightLevel: string]: {
      [stat: string]: {
        value: number;
      };
    };
  };
}

const {
  maxResonanceLevel,
  resonancePieces,
  recommendedResonanceList,
  recommendedResonancePattern = "PLACIDITY",
  resonanceMainPiece,
  resonancePatternPieces,
  isDev,
  pieceShapeFilterList,
  pieceBlocksFilterList,
  baseStats,
} = Astro.props;

const initialActiveResonanceLevel =
  maxResonanceLevel > DEFAULT_RESONATE_LEVEL
    ? DEFAULT_RESONATE_LEVEL
    : maxResonanceLevel;

const mainPieceCode = resonanceMainPiece?.replace("RP_", "");

const patternPieces = Object.entries(RESONANCE_PATTERN_PIECES).reduce(
  (
    prev: [
      {
        id: string;
        image?: string;
        stats?: any;
        materials?: { code: string; require?: number }[];
      },
    ],
    patternPiece
  ) => {
    if (patternPiece[0].includes(mainPieceCode)) {
      return [
        ...prev,
        {
          ...patternPiece[1],
        },
      ];
    }
    return prev;
  },
  [
    {
      id: `RPP_${mainPieceCode}_PLACIDITY`,
    },
  ]
);

const patternOptions = patternPieces.map((ele) => {
  const pattern = ele.id.replace(`RPP_${mainPieceCode}_`, "");

  if (pattern === "PLACIDITY") {
    return {
      value: pattern,
      label: RESONANCE_PATTERN[pattern].title,
    };
  }

  return {
    value: pattern,
    label:
      RESONANCE_PATTERN[`${mainPieceCode}_${pattern}`].title +
      (pattern === recommendedResonancePattern &&
      recommendedResonancePattern !== "PLACIDITY"
        ? " (Recommended)"
        : ""),
  };
});

const patternTagsList = patternPieces.map((ele) => {
  const pattern = ele.id.replace(`RPP_${mainPieceCode}_`, "");

  if (pattern === "PLACIDITY") {
    return {
      id: pattern,
      tags: RESONANCE_PATTERN[pattern].tags,
    };
  }

  return {
    id: pattern,
    tags: RESONANCE_PATTERN[`${mainPieceCode}_${pattern}`].tags,
  };
});

const patternMaterialsList = patternPieces.map((ele) => {
  const pattern = ele.id.replace(`RPP_${mainPieceCode}_`, "");

  return {
    id: pattern,
    image: ele.image,
    stats: ele.stats,
    materials: resonancePatternPieces?.[pattern]?.["materials"] ?? [],
  };
});
---

<div x-data="dataset">
  <div
    class="flex flex-col md:flex-row gap-4 items-end mb-4 [&_*]:min-w-0 [&_*]:min-h-0"
  >
    <div class="flex-1 min-w-0 w-full">
      <div class="p-4 md:p-6 border">
        <p class="text-lg font-medium text-primary-content mb-1">
          Maximum stats
        </p>
        <div
          id="attributes"
          x-data="attributes"
          class="flex flex-wrap md:flex-nowrap justify-between gap-4"
        >
          <div class="w-full md:basis-1/3">
            <div class="flex gap-2 items-center">
              <p class="text-primary-content">Level:</p>
              <p class="text-base-content text-xl" x-text="level"></p>
            </div>
            <div class="flex gap-2 items-center">
              <p class="text-primary-content">Insight:</p>
              <template x-if={`insight === 3`}>
                <InsightImg classNames="w-10" insight="3" />
              </template>
              <template x-if={`insight === 2`}>
                <InsightImg classNames="w-10" insight="2" />
              </template>
            </div>
          </div>
          <div class="w-full md:basis-2/3">
            <div class="flex gap-2 items-center justify-between">
              <p class="text-primary-content" x-text="baseStats.HP.label"></p>
              <p class="text-base-content" x-text="baseStats.HP.value"></p>
            </div>
            <div class="flex gap-2 items-center justify-between">
              <p class="text-primary-content" x-text="baseStats.ATTACK.label">
              </p>
              <p class="text-base-content" x-text="baseStats.ATTACK.value"></p>
            </div>
            <div class="flex gap-2 items-center justify-between">
              <p
                class="text-primary-content"
                x-text="baseStats.REALITY_DEFENSE.label"
              >
              </p>
              <p
                class="text-base-content"
                x-text="baseStats.REALITY_DEFENSE.value"
              >
              </p>
            </div>
            <div class="flex gap-2 items-center justify-between">
              <p
                class="text-primary-content"
                x-text="baseStats.MENTAL_DEFENSE.label"
              >
              </p>
              <p
                class="text-base-content"
                x-text="baseStats.MENTAL_DEFENSE.value"
              >
              </p>
            </div>
            <div class="flex gap-2 items-center justify-between">
              <p
                class="text-primary-content"
                x-text="baseStats.CRITICAL_TECHNIQUE.label"
              >
              </p>
              <p
                class="text-base-content"
                x-text="baseStats.CRITICAL_TECHNIQUE.value"
              >
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-4 flex overflow-auto">
        <template x-for="i in $store.resonance.maxResonanceLevel">
          <button
            class="btn btn-outline shrink-0"
            :class="i === activeResonanceLevel?'btn-outline btn-primary':''"
            @click="changeResonanceLevel(i)"
            x-text="i"></button>
        </template>
      </div>
    </div>
    <div
      id="generalStats"
      x-data="generalStats"
      class="p-4 md:p-6 border w-full md:basis-1/3"
    >
      <template x-for="[, stat] in Object.entries(stats)">
        <div
          class="flex gap-2 items-center justify-between"
          :class="stat.value > 0 ? 'opacity-100' : 'opacity-30'"
        >
          <p x-text="stat.label" class="text-primary-content"></p>
          <p x-text="'+'+stat.value+stat.unit"></p>
        </div>
      </template>
    </div>
  </div>
  {
    isDev && (
      <div class="md:grid md:grid-rows-2 md:grid-flow-col gap-2 my-5">
        <span class="text-2xl">Shape:</span>
        <div class="flex-1 flex overflow-auto">
          <button
            class="btn btn-outline shrink-0"
            x-bind:class="pieceShapeFilter === '' ? 'btn-primary' : ''"
            x-on:click="pieceShapeFilter = ''"
          >
            All
          </button>
          {pieceShapeFilterList?.map((pieceShape) => (
            <button
              class="btn btn-outline shrink-0"
              x-bind:class={`pieceShapeFilter === '${pieceShape}' ? 'btn-primary' : ''`}
              x-on:click={`pieceShapeFilter = '${pieceShape}'`}
            >
              {pieceShape}
            </button>
          ))}
        </div>
        <span class="text-2xl">Number of blocks:</span>
        <div class="flex-1 flex overflow-auto">
          <button
            class="btn btn-outline shrink-0"
            x-bind:class="pieceBlocksFilter === '' ? 'btn-primary' : ''"
            x-on:click="pieceBlocksFilter = ''"
          >
            All
          </button>
          {pieceBlocksFilterList?.map((pieceBlocks) => (
            <button
              class="btn btn-outline shrink-0"
              x-bind:class={`pieceBlocksFilter === '${pieceBlocks}' ? 'btn-primary' : ''`}
              x-on:click={`pieceBlocksFilter = '${pieceBlocks}'`}
            >
              {pieceBlocks}
            </button>
          ))}
        </div>
      </div>
    )
  }
  <div
    class="resonance relative flex flex-col md:flex-row gap-4 w-full"
    @pointerdown="onPointerDown"
    @pointermove="onPointerMove"
    @pointerup="onPointerUp"
    @resize.window.debounce="onResizeWindow()"
    x-resize="onResize({width: $width, height: $height})"
  >
    <div class="flex-1 md:basis-1/2 md:min-h-96">
      <canvas
        x-ref="canvas"
        class="border w-full h-full absolute top-0 left-0 bg-white/10 z-10"
      ></canvas>
      <!-- Board -->
      <div
        class="inline-block relative"
        :style="{margin: boardMarginVertical + 'px' + ' ' + boardMarginHorizontal + 'px'}"
      >
        <button
          class="absolute top-0 left-0 btn btn-ghost p-0 border-0 z-20"
          @click="clearBoard"
        >
          <CustomImage
            class="w-12"
            src="/images/resonance/common/clear.png"
            alt="resonance-clear"
          />
        </button>
        <canvas
          x-ref="boardCanvas"
          class="absolute pointer-events-auto z-20"
          :style="{top: boardRelativeY + 'px', left: boardRelativeX + 'px'}"
        ></canvas>
        <CustomImage
          loading="eager"
          class="w-64 md:w-72 select-none pointer-events-none -z-20"
          x-ref="boardImg"
          src="/images/resonance/common/board.png"
          alt="resonance-board"
        />
        <template x-for="block in blocks" :key="block.id">
          <div
            x-bind:data-block-id="block.id"
            class="border border-base-content/50 absolute select-none touch-none z-20"
            x-bind:class="(block.isNotValid ? 'bg-error' : '') || (block.isCollided ? 'bg-secondary/20 cursor-grab' : '')"
            x-bind:style="{ left: block.pos.x + boardRelativeX + 'px', top: block.pos.y + boardRelativeY + 'px', width: block.size + 'px', height: block.size + 'px' }"
          >
          </div>
        </template>
      </div>
      <!-- End Board -->
      <div class="md:mb-10">
        <!-- Recommended -->
        <div class="mx-4 z-20 relative" x-show="recommendedOptions.length">
          <label
            x-ref="recommendedSelect"
            id="recommendedSelect"
            class="select-none label"
          >
            Recommended
          </label>
          <select
            id="recommendedSelect"
            class="select select-secondary select-bordered flex w-full"
            @change="changeRecommended($event.target.value)"
          >
            <template x-for="resonance in recommendedOptions">
              <option
                x-text="resonance.label"
                :value="resonance.value"
                :selected="resonance.value === selectedRecommended"></option>
            </template>
          </select>
          <label class="label">
            <span class="label-text-alt text-sm opacity-50">
              Source of recommended: To be updated
            </span>
          </label>
        </div>
        <!-- End Recommended -->
        <!-- Resonance Pattern -->
        {
          !isDev && (
            <div class="mx-4 z-20 relative" x-show="activeResonanceLevel>=10">
              <label
                x-ref="patternSelect"
                id="patternSelect"
                class="select-none label"
              >
                Pattern
              </label>
              <select
                x-model="selectedPattern"
                id="patternSelect"
                class="select select-secondary select-bordered flex w-full"
                @change="changePattern($event.target.value)"
              >
                {patternOptions.map((pattern) => (
                  <option value={pattern.value}>{pattern.label}</option>
                ))}
              </select>
              <label class="label gap-2 items-start">
                <div class="label-text">
                  {patternTagsList.map((ele) => (
                    <template x-if={`'${ele.id}' === selectedPattern`}>
                      <div class="flex gap-1 flex-wrap">
                        {ele.tags.map((tag) => (
                          <span class="badge badge-outline">{tag}</span>
                        ))}
                      </div>
                    </template>
                  ))}
                </div>
                <span
                  class="label-text-alt"
                  x-show="selectedPattern !== 'PLACIDITY'"
                >
                  <Tooltip>
                    <p
                      slot="toggle"
                      class="text-base-content flex items-center gap-1"
                    >
                      Material
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        width="24"
                        height="24"
                        stroke-width="2"
                      >
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                        <path d="M12 9h.01" />
                        <path d="M11 12h1v4h1" />
                      </svg>
                    </p>
                    <div>
                      {patternMaterialsList.map((ele) => (
                        <template x-if={`'${ele.id}' === selectedPattern`}>
                          <div>
                            {ele.materials.map((material) => (
                              <Material
                                code={material.code}
                                require={material.require}
                              />
                            ))}
                          </div>
                        </template>
                      ))}
                    </div>
                  </Tooltip>
                </span>
              </label>
              <span class="text-sm opacity-50">
                Source of recommended: CN (to be updated)
              </span>
            </div>
          )
        }
        <!-- End Resonance Pattern -->
      </div>
    </div>
    {/* Pieces */}
    <div class="flex-1 md:basis-1/2 relative z-10">
      <div
        class="md:absolute md:top-0 md:left-0 w-full h-full overflow-auto p-4 flex flex-row md:flex-col gap-6"
      >
        <template
          x-for="item in activeResonancePieces"
          :key="item.id+item.level+item.total+item.pattern"
        >
          <div
            x-data={`piece({ id: item.id, total: item.total, orientation: item.orientation, level: item.level, stats: item.stats, isMainPiece: item.isMainPiece })`}
            class="flex flex-col md:flex-row gap-4 select-none"
            {...isDev && {
              ["x-show"]: "filterShowPieces(item.id)",
            }}
          >
            <div>
              <div
                class="flex justify-center items-center"
                @resize.window.debounce="pieceOnResizeWindow()"
                :style="{width: maxPieceWidth, height: maxPieceHeight}"
              >
                <div
                  class="relative touch-none"
                  :data-piece-id="item.id"
                  :class="quantity>0?'cursor-pointer':''"
                  :style={`{width: item.dimension[1] * blockSize + 'px', height: item.dimension[0] * blockSize + 'px'}`}
                >
                  <img
                    loading="lazy"
                    :data-piece-img-id="item.id"
                    :src="((item.pattern&&item.pattern!=='') ? '/images/resonance/pattern-pieces/' : '/images/resonance/pieces/') + item.image"
                    :alt="item.id"
                    class={`absolute pointer-events-none rotate-0 max-w-max top-0 left-0`}
                    :style={`{width: item.dimension[1] * blockSize + 'px', height: item.dimension[0] * blockSize + 'px'}`}
                  />
                </div>
              </div>
              <p class="mt-2 flex gap-2 justify-center select-none">
                {isDev && <span class="badge select-text" x-text="item.id" />}
                <span
                  x-text="quantity"
                  :class="quantity === 0 ? 'text-error' : ''"></span>
                /
                <span x-text="total"></span>
              </p>
            </div>

            <div class="md:flex-1">
              <p
                x-text="'Lv. ' + item.level"
                x-effect="updateCurrentStats(item.level)"
                class="text-primary text-xl"
              >
              </p>
              <template x-for="[statKey,stats] in Object.entries(currentStats)">
                <div class="flex gap-2 items-center justify-between">
                  <p x-text="stats.label" class="text-primary-content"></p>
                  <p x-text="showPieceStat(statKey,stats)"></p>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>
  {
    isDev && (
      <textarea
        rows="10"
        class="textarea textarea-secondary w-full"
        x-model="printResonanceGeoJsonList()"
      />
    )
  }
</div>

<script
  is:inline
  define:vars={{
    resonancePieces,
    maxResonanceLevel,
    initialActiveResonanceLevel,
    defaultResonanceLevel: DEFAULT_RESONATE_LEVEL,
    recommendedResonanceList,
    recommendedResonancePattern,
    resonancePatternPieces,
    mainPieceCode,
    baseStats,
    patternPieces: patternMaterialsList,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("resonance", {
      resonancePieces,
      maxResonanceLevel,
      initialActiveResonanceLevel,
      defaultResonanceLevel,
      recommendedResonanceList,
      recommendedResonancePattern,
      resonancePatternPieces,
      mainPieceCode,
      baseStats,
      patternPieces,
    });
  });
</script>

<script>
  import { STATS } from "@constants/character";
  import resonanceDataSet from "@scripts/resonance-data-set";
  import resonancePiece from "@scripts/resonance-piece";
  import resonanceGeneralStats from "@scripts/resonance-general-stats";
  import Alpine from "alpinejs";
  import resize from "@alpinejs/resize";

  Alpine.plugin(resize);

  window.Alpine = Alpine;

  Alpine.data("dataset", resonanceDataSet);
  Alpine.data("piece", resonancePiece);
  Alpine.data("attributes", () => ({
    level: 1,
    insight: 1,
    baseStats: {
      HP: {
        label: STATS["HP"].label,
        value: 0,
      },
      ATTACK: {
        label: STATS["ATTACK"].label,
        value: 0,
      },
      REALITY_DEFENSE: {
        label: STATS["REALITY_DEFENSE"].label,
        value: 0,
      },
      MENTAL_DEFENSE: {
        label: STATS["MENTAL_DEFENSE"].label,
        value: 0,
      },
      CRITICAL_TECHNIQUE: {
        label: STATS["CRITICAL_TECHNIQUE"].label,
        value: 0,
      },
    },

    init() {
      if (this.$store.resonance.maxResonanceLevel === 10) {
        this.level = 50;
        this.insight = 2;
      } else {
        this.level = 60;
        this.insight = 3;
      }
      const baseStatsData = this.$store.resonance.baseStats;
      const baseStats = baseStatsData[`maxBaseStats`];

      Object.entries(baseStats).forEach(
        ([statKey, stats]: [string, { value: number }]) => {
          this.baseStats[statKey] = {
            ...this.baseStats[statKey],
            ...stats,
          };
        }
      );
    },
  }));
  Alpine.data("generalStats", resonanceGeneralStats);
</script>
