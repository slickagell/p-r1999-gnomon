---
import Material from "@components/Material.astro";
import { getEntry } from "astro:content";
import * as changeCase from "change-case";

interface Props {
  code: string;
  recommendAction?: string;
  stages?: {
    stage: string;
    stamina: number;
    otherMaterials: {
      code: string;
      dropRate: string;
    }[];
  }[];
}

const { code, recommendAction, stages } = Astro.props;

const materialEntry = await getEntry("materials", changeCase.kebabCase(code))!;
---

<div class="flex flex-col items-center my-4">
  <Material code={code} size={"large"} variant={["vertical"]} />
  <div
    class:list={[
      "badge  rounded-full mt-2",
      {
        "badge-success": !recommendAction || recommendAction === "farm-craft",
        "badge-info": recommendAction === "farm",
        "badge-warning": recommendAction === "craft",
      },
    ]}
  >
    {
      (() => {
        switch (recommendAction) {
          case "farm":
            return "Farm";
          case "craft":
            return "Craft";
          default:
            return "Farm/Craft";
        }
      })()
    }
  </div>
</div>

{
  stages && (
    <div class="collapse collapse-plus bg-primary-content/10">
      <input type="checkbox" checked={recommendAction !== "craft"} />
      <div class="collapse-title text-xl font-medium">Farming stages</div>
      <div class="collapse-content">
        <div class="flex flex-wrap">
          {stages.map((item) => (
            <div class="flex-1 basis-full md:basis-1/2 flex flex-col">
              <div class="border border-primary bg-primary/30 text-base-content p-2">
                <p class="text-lg text-center">Stage {item.stage}</p>
                <p class="text-center font-normal">
                  <b>{item.stamina}</b> stamina
                </p>
              </div>
              <div class="flex-1 border p-2">
                <p class="pb-2 font-bold text-primary-content text-center">
                  Other materials
                </p>
                <div class="flex justify-center flex-wrap gap-4 md:gap-6">
                  {item.otherMaterials
                    .filter((material) => material.dropRate !== "possible")
                    .map((material) => (
                      <div class="relative text-center">
                        <Material code={material.code} variant={["vertical"]} />
                        <p class="capitalize badge badge-sm text-[0.625rem]  bg-neutral border-none">
                          {material.dropRate}
                        </p>
                      </div>
                    ))}
                </div>
                <div class="mt-2 collapse collapse-plus">
                  <input type="checkbox" />
                  <div class="collapse-title text-center font-medium text-primary-content">
                    Other possible materials
                  </div>
                  <div class="collapse-content">
                    <div class="flex justify-center flex-wrap gap-4 md:gap-6">
                      {item.otherMaterials
                        .filter((material) => material.dropRate === "possible")
                        .map((material) => (
                          <div class="relative text-center">
                            <Material
                              code={material.code}
                              variant={["vertical"]}
                            />
                            <p class="capitalize badge badge-sm text-[0.625rem] bg-neutral border-none">
                              {material.dropRate}
                            </p>
                          </div>
                        ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )
}

<div class="mt-4 collapse collapse-plus bg-primary-content/10">
  <input type="checkbox" checked={recommendAction !== "farm"} />
  <div class="collapse-title text-xl font-medium">Craft</div>
  <div class="collapse-content">
    <div class="flex flex-wrap justify-center">
      {
        materialEntry.data.craftMaterials.map((material) => (
          <div class="basis-1/3 md:basis-1/5 flex justify-center">
            <Material
              code={material.code}
              variant={["vertical"]}
              require={material.require}
            />
          </div>
        ))
      }
    </div>
  </div>
</div>
