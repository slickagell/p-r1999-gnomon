---
interface Props {
  mindmap: { nodes: { id: string }[]; links: { id: string }[] };
}

export interface MythManifestMindMapType {
  nodes: { id: string }[];
  links: { id: string }[];
}

const { mindmap } = Astro.props;
---

<div x-data="mindmap">
  <div id="mindmap-graph" class="relative max-w-full md:max-w-3xl mx-auto">
  </div>
  <p class="text-xs">* Click on a node to see its content</p>
  <template x-if="selectedNode">
    <div class="mt-4 card card-compact bg-primary-content/10">
      <div class="card-body">
        <div class="flex gap-10">
          <p class="card-title" x-text="selectedNode.title"></p>
          <div class="card-actions">
            <button class="btn btn-square btn-sm" @click="selectedNode = null">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path></svg
              >
            </button>
          </div>
        </div>
        <p class="card-content" x-html="selectedNode.description"></p>
      </div>
    </div>
  </template>
</div>

<script>
  import mythManifestMindMap from "@scripts/myth-manifest-mindmap";
  import Alpine from "alpinejs";

  Alpine.data("mindmap", mythManifestMindMap);
</script>

<script
  is:inline
  define:vars={{
    mindmap,
  }}
>
  document.addEventListener("alpine:init", () => {
    window.Alpine.store("mythManifest", {
      mindmap,
    });
  });
</script>
