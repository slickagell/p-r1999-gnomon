---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;

const hasTeamSuggestion = Astro.slots.has("team-suggestion-section-title");
---

<h1>{title}</h1>

<p class="text-xl font-medium">Recommended</p>

<slot name="recommended-content" />

<p class="mt-4 text-xl font-medium">Stage environment</p>

<slot name="stage-environment-content" />

<slot name="enemy-info-title" />

<slot name="enemy-info-content" />

<slot name="stage-info-title" />

<slot name="stage-info-content" />

<slot name="strategy-and-tips-title" />

<slot name="strategy-and-tips-content" />

{/* Team suggestion */}
<slot name="team-suggestion-section-title" />

{
  hasTeamSuggestion && (
    <>
      <div class="mb-6 md:grid md:grid-cols-3">
        <div>
          <slot name="team-suggestion-dps" />
        </div>

        <div>
          <slot name="team-suggestion-support" />
        </div>

        <div>
          <slot name="team-suggestion-sustain" />
        </div>
      </div>

      <slot name="team-suggestion-exception" />
    </>
  )
}
