---
import AfflatusIcon from "@components/AfflatusIcon.astro";
import CustomImage from "@components/CustomImage.astro";
import Icon from "@components/Icon.astro";
import Tooltip from "@components/Tooltip.astro";
import AFFLATUS_TYPE from "@data/common/character/afflatus-type.json";
import { getCollection } from "astro:content";

interface Props {}

const {} = Astro.props;

const mythManifestEntries = await getCollection(
  "reveries-in-the-rain",
  ({ id }) => {
    return id.includes("myth-manifest/") && !id.includes("mind-map/");
  }
);
---

<slot name="toc" />

<slot name="depths-of-myth-title" />

<slot name="depths-of-myth-content" />

<slot name="trance-title" />

<slot name="trance-content" />

<slot name="zone-info-title" />

<ul class="timeline">
  <li
    class="bg-euphotic-zone/20 before:!bg-euphotic-zone after:!bg-gradient-to-b after:!from-euphotic-zone after:!to-mesophotic-zone"
  >
    <p class="text-xl font-bold italic text-euphotic-zone">Euphotic Zone</p>

    <div class="mt-2 flex flex-wrap gap-5">
      {
        [
          { level: "10m" },
          { level: "20m" },
          { level: "30m" },
          { level: "40m" },
          { level: "50m" },
          { level: "60m" },
          { level: "70m" },
          { level: "80m" },
          { level: "90m" },
          { level: "100m-i" },
          { level: "100m-ii" },
          { level: "100m-iii" },
        ].map((depth) => (
          <div>
            <a href={`/reveries-in-the-rain/zone/${depth.level}`}>
              <span class="uppercase custom-link !text-base-content text-shadow shadow-euphotic-zone">
                {depth.level}
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </li>

  <li
    class="bg-mesophotic-zone/20 before:!bg-mesophotic-zone after:!bg-gradient-to-b after:!from-mesophotic-zone after:!to-bathyal-zone"
  >
    <p class="text-xl font-bold italic text-mesophotic-zone">Mesophotic Zone</p>

    <div class="mt-2 flex flex-wrap gap-5">
      {
        [
          { level: "110m" },
          { level: "120m" },
          { level: "130m" },
          { level: "140m" },
          { level: "150m" },
          { level: "160m" },
          { level: "170m" },
          { level: "180m" },
          { level: "190m", hasGuide: true },
          { level: "200m-i", hasGuide: true },
          { level: "200m-ii", hasGuide: true },
          { level: "200m-iii", hasGuide: true },
        ].map((depth) => (
          <div>
            <a href={`/reveries-in-the-rain/zone/${depth.level}`}>
              <span class="uppercase custom-link !text-base-content text-shadow shadow-mesophotic-zone inline-flex gap-1 items-center">
                {depth.level}
              </span>
              {depth.hasGuide && (
                <Tooltip contentCustomClass="p-1 bg-neutral/80 w-auto">
                  <Icon
                    slot="toggle"
                    icon="flag-spark"
                    customClass="w-4 h-4 !text-primary"
                  />
                  <span class="text-sm">Has info & suggestions</span>
                </Tooltip>
              )}
            </a>
          </div>
        ))
      }
    </div>
  </li>

  <li
    class="bg-bathyal-zone/20 before:!bg-bathyal-zone after:!bg-gradient-to-b after:!from-bathyal-zone after:!to-abyssal-zone"
  >
    <p class="text-xl font-bold italic text-bathyal-zone">Bathyal Zone</p>

    <div class="mt-2 flex flex-wrap gap-5">
      {
        [
          { level: "210m" },
          { level: "220m" },
          { level: "230m", hasGuide: true },
          { level: "240m" },
          { level: "250m-i", hasGuide: true },
          { level: "250m-ii", hasGuide: true },
          { level: "260m" },
          { level: "270m" },
          { level: "280m", hasGuide: true },
          { level: "290m", hasGuide: true },
          { level: "300m-i", hasGuide: true },
          { level: "300m-ii", hasGuide: true },
          { level: "300m-iii", hasGuide: true },
        ].map((depth) => (
          <div>
            <a href={`/reveries-in-the-rain/zone/${depth.level}`}>
              <span class="uppercase custom-link !text-base-content text-shadow shadow-bathyal-zone">
                {depth.level}
              </span>
              {depth.hasGuide && (
                <Tooltip contentCustomClass="p-1 bg-neutral/80 w-auto">
                  <Icon
                    slot="toggle"
                    icon="flag-spark"
                    customClass="w-4 h-4 !text-primary"
                  />
                  <span class="text-sm">Has info & suggestions</span>
                </Tooltip>
              )}
            </a>
          </div>
        ))
      }
    </div>
  </li>

  <li
    class="bg-abyssal-zone/20 before:!bg-abyssal-zone after:!bg-gradient-to-b after:!from-abyssal-zone after:!to-hadal-zone"
  >
    <p class="text-xl font-bold italic text-abyssal-zone">Abyssal Zone</p>

    <p class="mt-2 text-base-content text-shadow shadow-abyssal-zone">
      Not yet unlocked
    </p>
  </li>

  <li class="bg-hadal-zone/20 before:!bg-hadal-zone">
    <p class="text-xl font-bold italic text-hadal-zone">Hadal Zone</p>

    <p class="mt-2 text-base-content text-shadow shadow-hadal-zone">
      Not yet unlocked
    </p>
  </li>
</ul>

<slot name="isle-of-echoes-title" />

<slot name="isle-of-echoes-content" />

<slot name="myth-manifests-title" />

<slot name="myth-manifests-content" />

<h4>Myth Manifest</h4>

<div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-8">
  {
    mythManifestEntries.map((mythManifest) => (
      <a href={`/reveries-in-the-rain/${mythManifest.id}`}>
        <div class="relative transition group max-w-80 mx-auto hover:-translate-y-2 aspect-[2/3]">
          <div class="absolute z-20 -top-2 left-2 w-8">
            <AfflatusIcon
              type={mythManifest.data.afflatus as keyof typeof AFFLATUS_TYPE}
            />
          </div>
          <div class="relative w-full h-full overflow-hidden">
            <CustomImage
              src={`/images/reveries-in-the-rain/card-bg.png`}
              alt={mythManifest.data.title}
              class="absolute top-0 left-0 w-full h-full object-cover opacity-75"
            />
            <div class="absolute top-0 left-0 w-full h-full bg-white/50 z-10" />
            <CustomImage
              src={`/images/reveries-in-the-rain/card-circle.png`}
              alt={mythManifest.data.title}
              class="absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 w-[120%] z-10 max-w-max"
            />
            <p class="absolute z-20 top-0 h-[20%] left-0 right-0 px-4 flex justify-center items-center text-2xl font-medium text-center transition group-hover:text-primary text-black text-shadow shadow-white">
              {mythManifest.data.title}
            </p>
            <div class="absolute z-20 top-[20%] -m-6 left-0 overflow-hidden">
              <CustomImage
                src={`/images/reveries-in-the-rain/${mythManifest.data.id}.png`}
                alt={mythManifest.data.title}
                class="w-full transition"
              />
            </div>
          </div>
        </div>
      </a>
    ))
  }
</div>

<slot name="vibrations-of-volatility-title" />

<slot name="vibrations-of-volatility-content" />
