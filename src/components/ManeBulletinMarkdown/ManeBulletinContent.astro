---
import CharacterImg from "@components/CharacterMarkdown/CharacterImg.astro";
import CustomImage from "@components/CustomImage.astro";
import { AFFLATUS_TYPE, DMG_TYPE } from "@constants/character";

interface Props {
  id: string;
  title: string;
  afflatus: string;
  dmgType: string;
}

const { id, title, afflatus, dmgType } = Astro.props;
---

<div class="flex items-center">
  <CustomImage
    src={`/images/mane-bulletin/${id}-skew.png`}
    alt={title}
    class="w-[30rem]"
  />
  <div class="-ml-20">
    <h1>{title}</h1>
  </div>
</div>

<div class="flex gap-5">
  <CharacterImg variant="afflatus" code={AFFLATUS_TYPE[afflatus].assetCode} />

  <div class="flex gap-2 items-center">
    <CharacterImg variant="dmg-type" code={DMG_TYPE[dmgType].assetCode} />

    <h5>{DMG_TYPE[dmgType].title}</h5>
  </div>
</div>

<slot name="stage-mechanism-title" />

<slot name="stage-mechanism-content" />

<slot name="strategy-and-tips-title" />

<slot name="strategy-and-tips-content" />

<slot name="team-suggestions-title" />

<div class="md:grid md:grid-cols-3">
  <div>
    <slot name="team-suggestions-dps" />
  </div>

  <div>
    <slot name="team-suggestions-support" />
  </div>

  <div>
    <slot name="team-suggestions-sustain" />
  </div>
</div>
