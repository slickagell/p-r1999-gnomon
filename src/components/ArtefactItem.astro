---
import CustomImage from "@components/CustomImage.astro";
import EffectTooltip from "@components/EffectTooltip.astro";
import MarkdownContent from "@components/MarkdownContent.astro";
import MarkdownDiscList from "@components/MarkdownDiscList.astro";
import MarkdownEmphasis from "@components/MarkdownEmphasis.astro";
import MarkdownHighlight from "@components/MarkdownHighlight.astro";
import { ROUTES } from "@config/routes";
import ARTEFACT_RARITY from "@data/common/artefact/rarity.json";
import ARTEFACT_TAG from "@data/common/artefact/tag.json";
import ARTEFACT_TYPE from "@data/common/artefact/type.json";
import { render } from "astro:content";
import matrix from "matrix-js";

interface Props {
  artefactEntry: any;
}

const { artefactEntry } = Astro.props;

const { Content } = await render(artefactEntry);

const shape = matrix(artefactEntry.data.shape);
const shapeSize = shape.size();
---

<div
  class="flex flex-col md:flex-row gap-4"
  data-artefact-slug={artefactEntry.slug}
  data-artefact-name={artefactEntry.data.name}
  data-artefact-rarity={artefactEntry.data.rarity}
  data-artefact-type={artefactEntry.data.type}
  data-artefact-tags={artefactEntry.data.tags}
>
  <div>
    <p id={artefactEntry.slug} class="w-48 text-lg font-bold">
      <a href={`#${artefactEntry.slug}`}>{artefactEntry.data.name}</a>
    </p>
    <div class="flex gap-4">
      <CustomImage
        class="w-20"
        src={`/images/artefacts/${artefactEntry.data.image}`}
        alt={`artefact ${artefactEntry.slug}`}
      />
      <div class="flex flex-col gap-1">
        {
          Array.from({ length: shapeSize[0] }).map((_, rowIdx) => (
            <div class="flex gap-1">
              {Array.from({ length: shapeSize[1] }).map((_, colIdx) => (
                <div
                  class:list={[
                    "w-6 h-6",
                    !shape(rowIdx, colIdx)
                      ? "bg-transparent"
                      : {
                          "bg-common/30":
                            artefactEntry.data.rarity === "COMMON",
                          "bg-rare/30": artefactEntry.data.rarity === "RARE",
                          "bg-epic/30": artefactEntry.data.rarity === "EPIC",
                          "bg-fabled/30":
                            artefactEntry.data.rarity === "FABLED",
                        },
                  ]}
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="flex-1">
    <div class="flex justify-between items-start">
      <div>
        <div class="flex gap-1">
          <span
            class:list={[
              "badge font-medium border-transparent",
              {
                "text-common bg-common/20":
                  artefactEntry.data.rarity === "COMMON",
                "text-rare bg-rare/20": artefactEntry.data.rarity === "RARE",
                "text-epic bg-epic/20": artefactEntry.data.rarity === "EPIC",
                "text-fabled bg-fabled/20":
                  artefactEntry.data.rarity === "FABLED",
              },
            ]}
          >
            {ARTEFACT_RARITY[artefactEntry.data.rarity].title}
          </span>
          <span class="badge font-medium border-transparent bg-base-content/20">
            {ARTEFACT_TYPE[artefactEntry.data.type].title}
          </span>
        </div>
        <div class="mt-1 flex gap-1">
          {
            artefactEntry.data.tags.map((tag) => (
              <span
                class:list={[
                  "badge font-bold",
                  {
                    "border-support text-support": tag === "SUPPORT",
                    "border-ritual text-ritual": tag === "RITUAL",
                    "border-craft text-craft": tag === "CRAFT",
                    "border-syntony text-syntony": tag === "SYNTONY",
                    "border-resonance text-resonance": tag === "RESONANCE",
                    "border-abundance text-abundance": tag === "ABUNDANCE",
                    "border-extra-action text-extra-action":
                      tag === "EXTRA_ACTION",
                    "border-voltaic text-voltaic": tag === "VOLTAIC",
                    "border-stress text-stress": tag === "STRESS",
                    "border-guide text-guide": tag === "GUIDE",
                  },
                ]}
              >
                {ARTEFACT_TAG[tag].title}
              </span>
            ))
          }
        </div>
      </div>
      {
        artefactEntry.data.canExchange && (
          <a
            class="btn btn-sm btn-ghost text-primary"
            href={
              ROUTES.A_SERIES_OF_DUSKS_ARTEFACT_EXCHANGE +
              `#${artefactEntry.id}`
            }
          >
            Exchange
          </a>
        )
      }
    </div>
    <div class="mt-2">
      <Content
        components={{
          ul: MarkdownDiscList,
          p: MarkdownContent,
          strong: MarkdownHighlight,
          effect: EffectTooltip,
          em: MarkdownEmphasis,
        }}
      />
    </div>
  </div>
</div>
