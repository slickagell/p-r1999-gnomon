---

---

<div
  class="resonate relative z-10"
  x-data="dataset"
  @mousemove="onDrag"
  @mousedown="onDragStart"
  @mouseup="onDragEnd"
  style={`min-width: ${600}px; min-height: ${600}px`}
>
  <button class="btn absolute bottom-0" @click="changeBoardSize(6)"> 6 </button>
  <button class="btn absolute bottom-0 left-20" @click="changeBoardSize(10)">
    10
  </button>

  <canvas
    x-ref="canvas"
    class="border w-full h-full absolute top-0 left-0 bg-white/10 -z-10"
  ></canvas>
  <canvas
    x-ref="boardCanvas"
    class="border absolute top-0 left-0 bg-success/10 -z-20"></canvas>

  <template x-for="block in blocks" :key="block.id">
    <div
      x-data="{ x: block.pos.x, y: block.pos.y, isDragOver: false}"
      class="w-10 h-10 border absolute"
      :class="(block.isNotValid ? 'bg-error' : '') || (block.isCollided ? 'bg-primary/50' : '') || (isDragOver ? 'bg-primary' : '')"
      :style="{ left: x + 'px', top: y + 'px' }"
    >
    </div>
  </template>

  <div class="mt-10"></div>
  <div data-block-id="1" class="w-10 h-20 border absolute right-0 top-0"></div>
  <div data-block-id="2" class="w-20 h-10 border absolute right-0 top-20"></div>
  <div data-block-id="5" class="w-20 h-20 border absolute right-0 top-40"></div>
  <div data-block-id="6" class="w-20 h-20 border absolute right-0 top-60"></div>
</div>

<script>
  import { centroid } from "@turf/centroid";
  import { polygon } from "@turf/helpers";
  import Alpine from "alpinejs";
  import type { Feature, MultiPolygon, Polygon, Position } from "geojson";
  import { intersection, union } from "martinez-polygon-clipping";
  import matrix from "matrix-js";

  const BLOCK_SIZE = 40;
  const BOARD_COL = 10;
  const BOARD_ROW = 10;

  window.Alpine = Alpine;
  const BLOCKS = new Map([
    [
      "1",
      {
        shape: [[1], [1]],
      },
    ],
    [
      "2",
      {
        shape: [[1, 1]],
      },
    ],
    [
      "5",
      {
        shape: [
          [0, 1, 0],
          [1, 1, 1],
        ],
      },
    ],
    [
      "6",
      {
        shape: [
          [1, 0, 1, 0],
          [1, 0, 0, 1],
        ],
      },
    ],
  ]);

  interface BlockType {
    id: string;
    col: number;
    row: number;
    pos: {
      x: number;
      y: number;
    };
    size: number;
    isCollided?: boolean;
    isNotValid?: boolean;
  }

  Alpine.data("dataset", () => ({
    boardCol: BOARD_COL,
    boardRow: BOARD_ROW,
    boardX: 0,
    boardY: 0,

    initDragPoly: null,
    dragPoly: null,
    dragShapeDimension: null,

    ctx: null,
    canvas: null,
    boardCtx: null,
    boardCanvas: null,

    resonateGeoJson: null,
    itemOnBoardGeoJson: null,
    resonateGeoJsonList: [],

    initBlocks: [],
    blocks: [],
    blockSize: BLOCK_SIZE,

    lastMouseX: 0,
    lastMouseY: 0,
    isDragging: false,

    //* Init board canvas and blocks array
    initCanvas() {
      this.canvas = this.$refs.canvas;
      this.boardCanvas = this.$refs.boardCanvas;
      this.ctx = this.$refs.canvas.getContext("2d");
      this.boardCtx = this.$refs.boardCanvas.getContext("2d");

      let initBlocks: BlockType[] = [];
      for (let row = 0; row < this.boardRow; row++) {
        for (let col = 0; col < this.boardCol; col++) {
          initBlocks.push({
            id: `${col}-${row}`,
            col: col,
            row: row,
            pos: {
              x: this.boardX + col * this.blockSize,
              y: this.boardY + row * this.blockSize,
            },
            size: this.blockSize,
            isCollided: false,
          });
        }
      }

      this.initBlocks = JSON.parse(JSON.stringify(initBlocks));
      this.blocks = JSON.parse(JSON.stringify(initBlocks));

      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
      this.boardCanvas.width = this.boardCol * this.blockSize;
      this.boardCanvas.height = this.boardRow * this.blockSize;
    },

    init() {
      this.initCanvas();
    },

    drawPoly(coords: Position[], ctx, fill: string) {
      if (!ctx) return;
      ctx.fillStyle = fill;

      ctx.beginPath();
      ctx.moveTo(coords[0][0], coords[0][1]);
      coords.forEach((point) => {
        ctx.lineTo(point[0], point[1]);
      });
      ctx.closePath();
      ctx.fill();
    },

    drawGeoJson(geoJsonData: Feature, ctx, fill: string) {
      if (geoJsonData.geometry.type === "Polygon") {
        this.drawPoly(geoJsonData.geometry.coordinates[0], ctx, fill);
      }

      if (geoJsonData.geometry.type === "MultiPolygon") {
        geoJsonData.geometry.coordinates.forEach((coords) => {
          this.drawPoly(coords[0], ctx, fill);
        });
      }
    },

    onInitDragGeoJson(blockId) {
      const blockData = BLOCKS.get(blockId);

      if (!blockData) return;

      this.isDragging = true;

      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;

      const blockShapeMatrix = matrix(blockData.shape);
      const blockShapeDimension = blockShapeMatrix.size();
      this.dragShapeDimension = JSON.parse(JSON.stringify(blockShapeDimension));
      const shapeRow = blockShapeDimension[0];
      const shapeCol = blockShapeDimension[1];

      let itemBlocks: Position[][] = [];

      for (let row = 0; row < shapeRow; row++) {
        for (let col = 0; col < shapeCol; col++) {
          if (blockShapeMatrix(row, col)) {
            const x = col * this.blockSize;
            const y = row * this.blockSize;

            const itemBlock = [
              [x, y],
              [(col + 1) * this.blockSize, y],
              [(col + 1) * this.blockSize, (row + 1) * this.blockSize],
              [x, (row + 1) * this.blockSize],
            ];

            itemBlocks.push(itemBlock);
          }
        }
      }

      let itemGeometry;
      itemBlocks.forEach((element) => {
        const eleBlock = {
          type: "Feature",
          geometry: {
            type: "Polygon",
            coordinates: [[...element, element[0]]],
          },
        } as Feature<Polygon>;

        if (!itemGeometry) {
          itemGeometry = eleBlock;
        } else {
          const newPolyBlockCoords = union(
            itemGeometry.geometry.coordinates,
            eleBlock.geometry.coordinates
          );

          itemGeometry = {
            type: "Feature",
            geometry: {
              type: "MultiPolygon",
              coordinates: newPolyBlockCoords,
            },
          };
        }
      });

      this.initDragPoly = itemGeometry;
    },

    onDragStart(event) {
      let rect = this.canvas.getBoundingClientRect();
      this.lastMouseX = event.clientX - rect.left;
      this.lastMouseY = event.clientY - rect.top;

      if (!event.target.attributes["data-block-id"]) return;
      const blockId = event.target.attributes["data-block-id"].value;
      this.onInitDragGeoJson(blockId);
    },

    onDrag(event) {
      if (!this.isDragging) return;

      let rect = this.canvas.getBoundingClientRect();

      this.lastMouseX = event.clientX - rect.left;
      this.lastMouseY = event.clientY - rect.top;

      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      const drawPoly = Object.assign(this.initDragPoly, {}) as Feature;

      if (drawPoly.geometry.type === "Polygon") {
        const coords = drawPoly.geometry.coordinates[0];
        let delta = {
          x: this.lastMouseX - coords[0][0],
          y: this.lastMouseY - coords[0][1],
        };
        const transformCoords = coords[0].map((point) => {
          return [point[0] + delta.x, point[1] + delta.y];
        });
        this.dragPoly = {
          ...drawPoly,
          geometry: {
            coordinates: [[transformCoords]],
          },
        } as Feature;
      } else if (drawPoly.geometry.type === "MultiPolygon") {
        const startPolyPoint = drawPoly.geometry.coordinates[0][0][0];
        const centroidPoint = centroid(drawPoly);
        const startPoint = {
          x: this.lastMouseX - centroidPoint.geometry.coordinates[0],
          y: this.lastMouseY - centroidPoint.geometry.coordinates[1],
        };

        const tranformDragPoly = drawPoly.geometry.coordinates.reduce(
          (prevPolysCoords, polys) => {
            const transformPolys = polys.reduce((prev: Position[], coords) => {
              let delta = {
                x: startPoint.x - startPolyPoint[0],
                y: startPoint.y - startPolyPoint[1],
              };
              const transformCoords = coords.map((point) => {
                return [point[0] + delta.x, point[1] + delta.y] as Position;
              });
              return [...prev, transformCoords];
            }, []);
            return [...prevPolysCoords, transformPolys];
          },
          []
        );

        this.dragPoly = {
          ...drawPoly,
          geometry: {
            ...drawPoly.geometry,
            coordinates: tranformDragPoly,
          },
        } as Feature;
      }

      this.drawGeoJson(this.dragPoly, this.ctx, "rgba(233,220,205,0.5)");
      this.blocks = JSON.parse(JSON.stringify(this.initBlocks));
      this.processCheckCollision(this.dragPoly, this.blocks);
    },

    onDragEnd(event) {
      //* If we're currently dragging a block
      if (this.isDragging) {
        this.isDragging = false;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

        const isItemInsideBoard = this.itemOnBoardGeoJson.geometry.coordinates
          .flat(2)
          .every(
            (point: Position) =>
              point[0] <= this.blockSize * this.boardCol &&
              point[1] <= this.blockSize * this.boardRow
          );

        if (!isItemInsideBoard) {
          this.blocks = this.initBlocks;
          return;
        }

        const blocks = JSON.parse(JSON.stringify(this.blocks)) as BlockType[];

        const invalidBlock = blocks.find((ele) => ele.isNotValid);
        if (!invalidBlock) {
          this.initBlocks = this.blocks;
          const unionGeoJson = !this.resonateGeoJson
            ? this.itemOnBoardGeoJson
            : {
                type: "Feature",
                geometry: {
                  coordinates: union(
                    this.resonateGeoJson.geometry.coordinates,
                    this.itemOnBoardGeoJson.geometry.coordinates
                  ),
                },
              };

          this.resonateGeoJson = unionGeoJson;
          this.resonateGeoJsonList.push(this.itemOnBoardGeoJson);
          this.resonateGeoJsonList.forEach((geoJson) => {
            this.drawGeoJson(geoJson, this.boardCtx, "rgba(219,111,57,0.7)");
          });
        } else {
          this.blocks = this.initBlocks;
        }
        return;
      }

      //* If user click on the board
      let rect = this.canvas.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      if (
        x > this.blockSize * this.boardCol ||
        y > this.blockSize * this.boardRow
      )
        return;

      const delta = 5;
      const diffX = Math.abs(x - this.lastMouseX);
      const diffY = Math.abs(y - this.lastMouseY);

      if (diffX > delta || diffY > delta) return;

      this.onBoardClick(x, y);
    },

    onBoardClick(x: number, y: number) {
      const column = Math.floor(x / this.blockSize);
      const row = Math.floor(y / this.blockSize);

      let selectGeoJson;

      this.resonateGeoJsonList.some((geoJson) => {
        if (geoJson.properties.blocks.includes(`${column}-${row}`)) {
          selectGeoJson = geoJson;
          return true;
        }

        return false;
      });
      if (selectGeoJson) {
      }
    },

    distanceBetween(
      point1: { x: number; y: number },
      point2: { x: number; y: number }
    ) {
      const dx = point2.x - point1.x;
      const dy = point2.y - point1.y;
      return Math.sqrt(dx * dx + dy * dy);
    },

    checkCollision(item: Feature<MultiPolygon>, block: BlockType) {
      const BLOCK_OFFSET = 10;

      const blockStartPoint = [
        block.pos.x + BLOCK_OFFSET,
        block.pos.y + BLOCK_OFFSET,
      ];

      const blockSize = block.size - BLOCK_OFFSET * 2;

      const blockPoly = polygon([
        [
          [blockStartPoint[0], blockStartPoint[1]],
          [blockSize + blockStartPoint[0], blockStartPoint[1]],
          [blockSize + blockStartPoint[0], blockSize + blockStartPoint[1]],
          [blockStartPoint[0], blockSize + blockStartPoint[1]],
          [blockStartPoint[0], blockStartPoint[1]],
        ],
      ]);

      //* Draw potential collide block
      this.drawGeoJson(blockPoly, this.ctx, "rgba(220,220,220,1)");

      const intersectionPoly = {
        type: "Feature",
        geometry: {
          type: "Polygon",
          coordinates: intersection(
            item.geometry.coordinates,
            blockPoly.geometry.coordinates
          ),
        },
      };

      if (
        !intersectionPoly.geometry.coordinates ||
        !intersectionPoly.geometry.coordinates?.[0]
      ) {
        return false;
      }

      return true; // Collision detected
    },

    processCheckCollision(item: Feature, blocks: BlockType[]) {
      const bufferRadius =
        this.blockSize * (Math.max(...this.dragShapeDimension) / 2 + 1); // (slightly larger than the sweepRadius) is the maximum distance between the item's position and a block's position that is considered "far enough" to warrant pruning the block from the search space

      if (item.geometry.type !== "MultiPolygon") return;

      const itemPosX = item.geometry.coordinates[0][0][0][0];
      const itemPosY = item.geometry.coordinates[0][0][0][1];

      const column = Math.floor(itemPosX / this.blockSize);
      const row = Math.floor(itemPosY / this.blockSize);

      const startPoint = item.geometry.coordinates[0][0][0];
      const tranformDragPoly = item.geometry.coordinates.reduce(
        (prevPolysCoords, polys) => {
          const transformPolys = polys.reduce((prev: Position[], coords) => {
            let delta = {
              x: column * this.blockSize - startPoint[0],
              y: row * this.blockSize - startPoint[1],
            };
            const transformCoords = coords.map((point) => {
              return [point[0] + delta.x, point[1] + delta.y] as Position;
            });
            return [...prev, transformCoords];
          }, []);
          return [...prevPolysCoords, transformPolys];
        },
        []
      );

      const transformGeoJson = {
        ...item,
        geometry: {
          ...item.geometry,
          coordinates: tranformDragPoly,
        },
        properties: {
          blocks: [],
        },
      } as Feature;

      for (const block of blocks) {
        const idx = blocks.indexOf(block);
        const centroidPoint = centroid(transformGeoJson);

        const distance = this.distanceBetween(
          {
            x: centroidPoint.geometry.coordinates[0],
            y: centroidPoint.geometry.coordinates[1],
          },
          {
            x: block.pos.x + this.blockSize / 2,
            y: block.pos.y + this.blockSize / 2,
          }
        );

        if (distance > bufferRadius) continue;

        //* Draw item on canvas
        this.drawGeoJson(transformGeoJson, this.ctx, "rgba(0,255,0,0.3)");

        const collision = this.checkCollision(transformGeoJson, block);

        if (collision) {
          if (blocks[idx].isCollided) {
            blocks[idx].isNotValid = true;
          } else {
            blocks[idx].isCollided = true;
            transformGeoJson.properties?.blocks.push(blocks[idx].id);
          }
          // return true; // Collision detected, return true
        }
      }

      this.itemOnBoardGeoJson = transformGeoJson;

      return false; // No collision detected
    },

    changeBoardSize(size: number) {
      this.boardCol = size;
      this.boardRow = size;

      this.initCanvas();
    },
  }));
</script>
