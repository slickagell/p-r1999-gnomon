---

---

<div
  class="resonate relative z-10"
  x-data="dataset"
  @mousemove="onDrag"
  @mousedown="onDragStart"
  @mouseup="onDragEnd"
  style={`min-width: ${600}px; min-height: ${600}px`}
>
  <button class="btn absolute bottom-0" @click="changeBoardSize(6)"> 6 </button>
  <button class="btn absolute bottom-0 left-20" @click="changeBoardSize(10)">
    10
  </button>

  <canvas
    x-ref="canvas"
    class="border w-full h-full absolute top-0 left-0 bg-white/10 -z-10"
  ></canvas>

  <template x-for="block in blocks" :key="block.id">
    <div
      x-data="{ x: block.pos.x, y: block.pos.y, isDragOver: false}"
      class="w-10 h-10 border absolute"
      :class="(block.isCollided ? 'bg-primary/50' : '') || (isDragOver ? 'bg-primary' : '')"
      :style="{ left: x + 'px', top: y + 'px' }"
    >
    </div>
  </template>

  <div class="mt-10"></div>
  <div data-block-id="1" class="w-10 h-20 border absolute right-0 top-0"></div>
  <div data-block-id="2" class="w-20 h-10 border absolute right-0 top-20"></div>
  <div data-block-id="5" class="w-20 h-20 border absolute right-0 top-40"></div>
  <div data-block-id="6" class="w-20 h-20 border absolute right-0 top-60"></div>
</div>

<script>
  import { centroid } from "@turf/centroid";
  import { polygon } from "@turf/helpers";
  import Alpine from "alpinejs";
  import type { Feature, Polygon, Position } from "geojson";
  import { intersection, union } from "martinez-polygon-clipping";
  import matrix from "matrix-js";

  const BLOCK_SIZE = 40;
  const BOARD_COL = 10;
  const BOARD_ROW = 10;

  window.Alpine = Alpine;
  const BLOCKS = new Map([
    [
      "1",
      {
        shape: [[1], [1]],
      },
    ],
    [
      "2",
      {
        shape: [[1, 1]],
      },
    ],
    [
      "5",
      {
        shape: [
          [0, 1, 0],
          [1, 1, 1],
        ],
      },
    ],
    [
      "6",
      {
        shape: [
          [1, 0, 1, 0],
          [1, 0, 0, 1],
        ],
      },
    ],
  ]);

  Alpine.data("dataset", () => ({
    boardCol: BOARD_COL,
    boardRow: BOARD_ROW,
    dragItem: null,
    dragPoly: null,
    dragShapeDimension: null,

    canvas: null,
    ctx: null,
    initBlocks: [],
    blocks: [],
    afterDragBlocks: [],
    boardX: 0,
    boardY: 0,

    lastMouseX: 0,
    lastMouseY: 0,
    isDragging: false,

    //* Init board canvas and blocks array
    initCanvas() {
      this.canvas = this.$refs.canvas;
      this.ctx = this.$refs.canvas.getContext("2d");

      let initBlocks: any[] = [];
      for (let row = 0; row < this.boardRow; row++) {
        for (let col = 0; col < this.boardCol; col++) {
          initBlocks.push({
            id: `${this.boardX + col * BLOCK_SIZE}-${this.boardY + row * BLOCK_SIZE}`,
            col: col,
            row: row,
            pos: {
              x: this.boardX + col * BLOCK_SIZE,
              y: this.boardY + row * BLOCK_SIZE,
            },
            size: BLOCK_SIZE,
            isCollided: false,
          });
        }
      }

      this.initBlocks = JSON.parse(JSON.stringify(initBlocks));
      this.blocks = JSON.parse(JSON.stringify(initBlocks));

      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
    },

    init() {
      this.initCanvas();
    },

    drawPoly(coords, fill) {
      if (!this.ctx) return;
      this.ctx.fillStyle = fill;

      this.ctx.beginPath();
      this.ctx.moveTo(coords[0][0], coords[0][1]);
      coords.forEach((point) => {
        this.ctx.lineTo(point[0], point[1]);
      });
      this.ctx.closePath();
      this.ctx.fill();
    },

    drawGeoJson(geoJsonData: Feature, fill) {
      if (geoJsonData.geometry.type === "Polygon") {
        this.drawPoly(geoJsonData.geometry.coordinates[0], fill);
      }

      if (geoJsonData.geometry.type === "MultiPolygon") {
        geoJsonData.geometry.coordinates.forEach((coords) => {
          this.drawPoly(coords[0], fill);
        });
      }
    },

    onDragStart(event) {
      if (!event.target.attributes["data-block-id"]) return;
      const blockId = event.target.attributes["data-block-id"].value;
      const blockData = BLOCKS.get(blockId);

      if (!blockData) return;

      this.isDragging = true;
      this.lastMouseX = event.clientX;
      this.lastMouseY = event.clientY;

      this.canvas.width = this.canvas.offsetWidth;
      this.canvas.height = this.canvas.offsetHeight;
      this.dragItem = event.target;

      const blockShapeMatrix = matrix(blockData.shape);
      const blockShapeDimension = blockShapeMatrix.size();
      this.dragShapeDimension = blockShapeDimension;
      const shapeRow = blockShapeDimension[0];
      const shapeCol = blockShapeDimension[1];

      let itemBlocks: Position[][] = [];

      for (let row = 0; row < shapeRow; row++) {
        for (let col = 0; col < shapeCol; col++) {
          if (blockShapeMatrix(row, col)) {
            const x = col * BLOCK_SIZE;
            const y = row * BLOCK_SIZE;

            const itemBlock = [
              [x, y],
              [(col + 1) * BLOCK_SIZE, y],
              [(col + 1) * BLOCK_SIZE, (row + 1) * BLOCK_SIZE],
              [x, (row + 1) * BLOCK_SIZE],
            ];

            itemBlocks.push(itemBlock);
          }
        }
      }

      let itemGeometry;
      itemBlocks.forEach((element) => {
        const eleBlock = {
          type: "Feature",
          geometry: {
            type: "Polygon",
            coordinates: [[...element, element[0]]],
          },
        } as Feature<Polygon>;

        if (!itemGeometry) {
          itemGeometry = eleBlock;
        } else {
          const newPolyBlockCoords = union(
            itemGeometry.geometry.coordinates,
            eleBlock.geometry.coordinates
          );

          itemGeometry = {
            type: "Feature",
            geometry: {
              type: "MultiPolygon",
              coordinates: newPolyBlockCoords,
            },
          };
        }
      });

      this.initDragPoly = itemGeometry;
    },

    onDrag(event) {
      if (!this.isDragging) return;

      let rect = this.canvas.getBoundingClientRect();

      this.lastMouseX = event.clientX - rect.left;
      this.lastMouseY = event.clientY - rect.top;

      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

      const drawPoly = Object.assign(this.initDragPoly, {}) as Feature;

      if (drawPoly.geometry.type === "Polygon") {
        const coords = drawPoly.geometry.coordinates[0];
        let delta = {
          x: this.lastMouseX - coords[0][0],
          y: this.lastMouseY - coords[0][1],
        };
        const transformCoords = coords[0].map((point) => {
          return [point[0] + delta.x, point[1] + delta.y];
        });
        this.dragPoly = {
          ...drawPoly,
          geometry: {
            coordinates: [[transformCoords]],
          },
        } as Feature;
      } else if (drawPoly.geometry.type === "MultiPolygon") {
        const startPolyPoint = drawPoly.geometry.coordinates[0][0][0];
        const centroidPoint = centroid(drawPoly);
        const startPoint = {
          x: this.lastMouseX - centroidPoint.geometry.coordinates[0],
          y: this.lastMouseY - centroidPoint.geometry.coordinates[1],
        };

        const tranformDrawPoly = drawPoly.geometry.coordinates.reduce(
          (prevPolysCoords, polys) => {
            const transformPolys = polys.reduce((prev: Position[], coords) => {
              let delta = {
                x: startPoint.x - startPolyPoint[0],
                y: startPoint.y - startPolyPoint[1],
              };
              const transformCoords = coords.map((point) => {
                return [point[0] + delta.x, point[1] + delta.y] as Position;
              });
              return [...prev, transformCoords];
            }, []);
            return [...prevPolysCoords, transformPolys];
          },
          []
        );

        this.dragPoly = {
          ...drawPoly,
          geometry: {
            ...drawPoly.geometry,
            coordinates: tranformDrawPoly,
          },
        } as Feature;
      }

      this.drawGeoJson(this.dragPoly, "rgba(255,0,0,1)");
      this.blocks = JSON.parse(JSON.stringify(this.initBlocks));
      this.sweepAndPrune(this.dragPoly, this.blocks);
    },

    onDragEnd(event) {
      let rect = this.canvas.getBoundingClientRect();

      const delta = 6;
      const diffX = Math.abs(event.clientX - rect.left - this.lastMouseX);
      const diffY = Math.abs(event.clientY - rect.top - this.lastMouseY);
      if (diffX < delta && diffY < delta) {
        this.initBlocks = this.blocks;
        this.isDragging = false;
        // this.initDragPoly.pos.x = event.clientX;
        // this.initDragPoly.pos.y = event.clientY;
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      }
    },

    distanceBetween(point1, point2) {
      const dx = point2.x - point1.x;
      const dy = point2.y - point1.y;
      return Math.sqrt(dx * dx + dy * dy);
    },

    checkCollision(item, block) {
      const BLOCK_OFFSET = 10;

      const blockStartPoint = [
        block.pos.x + BLOCK_OFFSET,
        block.pos.y + BLOCK_OFFSET,
      ];

      const blockSize = block.size - BLOCK_OFFSET * 2;

      const blockPoly = polygon([
        [
          [blockStartPoint[0], blockStartPoint[1]],
          [blockSize + blockStartPoint[0], blockStartPoint[1]],
          [blockSize + blockStartPoint[0], blockSize + blockStartPoint[1]],
          [blockStartPoint[0], blockSize + blockStartPoint[1]],
          [blockStartPoint[0], blockStartPoint[1]],
        ],
      ]);

      this.drawGeoJson(blockPoly, "rgba(220,220,220,1)");

      const intersectionPoly = {
        type: "Feature",
        geometry: {
          type: "Polygon",
          coordinates: intersection(
            item.geometry.coordinates,
            blockPoly.geometry.coordinates
          ),
        },
      };

      if (
        !intersectionPoly.geometry.coordinates ||
        !intersectionPoly.geometry.coordinates?.[0]
      ) {
        return false;
      }

      return true; // Collision detected
    },

    sweepAndPrune(item: Feature, blocks) {
      const dimension = JSON.parse(JSON.stringify(this.dragShapeDimension));
      const sweepRadius = BLOCK_SIZE * (Math.max(...dimension) / 2 + 1); // (slightly larger than the block size) is the maximum distance between the item's position and a block's position that is considered "close enough" to warrant a collision check
      const pruneRadius = BLOCK_SIZE * (Math.max(...dimension) / 2 + 1.5); // (slightly larger than the sweepRadius) is the maximum distance between the item's position and a block's position that is considered "far enough" to warrant pruning the block from the search space

      if (item.geometry.type !== "MultiPolygon") return;

      const itemPosX = item.geometry.coordinates[0][0][0][0];
      const itemPosY = item.geometry.coordinates[0][0][0][1];

      const column = Math.floor(itemPosX / BLOCK_SIZE);
      const row = Math.floor(itemPosY / BLOCK_SIZE);

      const startPoint = item.geometry.coordinates[0][0][0];
      const tranformDrawPoly = item.geometry.coordinates.reduce(
        (prevPolysCoords, polys) => {
          const transformPolys = polys.reduce((prev: Position[], coords) => {
            let delta = {
              x: column * BLOCK_SIZE - startPoint[0],
              y: row * BLOCK_SIZE - startPoint[1],
            };
            const transformCoords = coords.map((point) => {
              return [point[0] + delta.x, point[1] + delta.y] as Position;
            });
            return [...prev, transformCoords];
          }, []);
          return [...prevPolysCoords, transformPolys];
        },
        []
      );

      const transformGeoJson = {
        ...item,
        geometry: {
          ...item.geometry,
          coordinates: tranformDrawPoly,
        },
      } as Feature;

      for (const block of blocks) {
        const idx = blocks.indexOf(block);
        const centroidPoint = centroid(transformGeoJson);

        const distance = this.distanceBetween(
          {
            x: centroidPoint.geometry.coordinates[0],
            y: centroidPoint.geometry.coordinates[1],
          },
          {
            x: block.pos.x + BLOCK_SIZE / 2,
            y: block.pos.y + BLOCK_SIZE / 2,
          }
        );

        if (distance > sweepRadius) continue; // Sweep blocks that are too far away

        this.drawGeoJson(transformGeoJson, "rgba(0,255,0,1)");

        const collision = this.checkCollision(transformGeoJson, block);

        if (collision) {
          blocks[idx].isCollided = true;
          // return true; // Collision detected, return true
        }

        if (distance > pruneRadius) continue; // Prune blocks that are too far away
      }

      return false; // No collision detected
    },

    changeBoardSize(size: number) {
      this.boardCol = size;
      this.boardRow = size;

      this.initCanvas();
    },
  }));
</script>
