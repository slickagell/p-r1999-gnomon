---
import { processSearchResult } from "@scripts/common";
import PagefindSearch from "astro-pagefind/components/Search";

interface Props {}

const {} = Astro.props;
---

<div x-data>
  <button
    class="btn btn-outline btn-secondary btn-sm"
    onclick="searchModal.showModal()"
  >
    Search
  </button>

  <template x-teleport="body">
    <dialog id="searchModal" class="modal">
      <div
        class="modal-box w-full h-full max-w-full max-h-screen bg-base-100/80 backdrop-blur-sm flex flex-col overflow-y-visible"
      >
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
            >✕</button
          >
        </form>
        <h3>Search</h3>
        <PagefindSearch
          id="search"
          className="pagefind-ui-root"
          uiOptions={{
            autofocus: true,
            showImages: false,
            processResult: (result) => processSearchResult(result),
          }}
        />
      </div>
    </dialog>
  </template>
</div>
