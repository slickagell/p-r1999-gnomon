---
import "@styles/layout.css";
import CustomImage from "@components/CustomImage.astro";
import Icon from "@components/Icon.astro";
import Footer from "@layouts/Footer.astro";
import GoToTop from "@layouts/GoToTop.astro";
import Search from "@components/Search.astro";

interface Props {
  title: string;
  breadcrumbs?: {
    href?: string;
    label: string;
  }[];
}

const { title, breadcrumbs } = Astro.props;

const menu = [
  {
    title: "Characters",
    href: "/characters",
  },
  {
    title: "Materials",
    href: "/materials",
  },
  {
    title: "A Series of Dusks",
    href: "/a-series-of-dusks",
  },
  {
    title: "Mane's Bulletin",
    href: "/mane-bulletin",
  },
  {
    title: "Reveries in the Rain",
    href: "/reveries-in-the-rain",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Reverse:1999 Gnomon is a fanmade website for turn-based RPG, Reverse:1999, a game developed by Bluepoch"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-pagefind-meta="title">{`${title} | Reverse:1999 Gnomon`}</title>
  </head>
  <body>
    <div class="drawer min-h-screen">
      <input id="sidebar" type="checkbox" class="drawer-toggle" />
      <div class="main-background drawer-content flex flex-col">
        <!-- Navbar -->
        <div
          id="header"
          class="w-full navbar bg-base-300 h-16 sticky top-0 z-40 shadow-md shadow-primary"
        >
          <div class="flex-none lg:hidden">
            <label
              for="sidebar"
              aria-label="open sidebar"
              class="btn btn-square btn-ghost"
            >
              <Icon icon="hamburger" />
            </label>
          </div>
          <div class="flex-1 mx-2">
            <a href="/" class="flex items-center">
              <CustomImage
                class="mr-2 w-10"
                src="/layout/logo.png"
                alt="logo"
              />
              <span class="text-xl text-primary italic">
                Reverse:1999 Gnomon
              </span>
            </a>
          </div>
          <div class="flex-none hidden lg:block">
            <ul class="menu menu-horizontal py-1 items-center">
              <!-- Navbar menu content here -->
              {
                menu.map((item) => (
                  <li>
                    <a href={item.href}>{item.title}</a>
                  </li>
                ))
              }
              <Search />
            </ul>
          </div>
        </div>
        <main class="container flex-1 pt-6 pb-20">
          <!-- Page content here -->
          {
            breadcrumbs && (
              <div class="text-sm breadcrumbs mb-4">
                <ul>
                  {breadcrumbs.map((ele) => {
                    if (!ele.href) return <li>{ele.label}</li>;
                    return (
                      <li>
                        <a href={ele.href}>{ele.label}</a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            )
          }
          <slot />
        </main>
        <Footer />
      </div>
      <div class="drawer-side z-50">
        <label for="sidebar" aria-label="close sidebar" class="drawer-overlay"
        ></label>
        <div class="menu p-4 w-80 min-h-full bg-base-200 justify-between">
          <ul class="flex-1">
            <!-- Sidebar content here -->
            {
              menu.map((item) => (
                <li>
                  <a href={item.href}>{item.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <GoToTop />
  </body>
</html>
