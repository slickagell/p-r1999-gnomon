---
import CustomImage from "@components/CustomImage.astro";
import Icon from "@components/Icon.astro";
---

<footer x-data="footer" x-ref="footer" class="border-t border-primary">
  <div
    class="footer container gap-y-4 place-items-center md:place-items-start items-center p-4"
  >
    <aside class="items-center grid-flow-col">
      <a href="/" class="flex items-center">
        <CustomImage class="mr-2 w-10" src="/layout/logo.png" alt="logo" />
        <span class="text-xl text-primary italic"> Reverse:1999 Gnomon </span>
      </a>
    </aside>
    <nav class="grid-flow-col gap-2 md:place-self-center md:justify-self-end">
      <a href="/about">
        <div class="tooltip" data-tip="About">
          <div class="btn btn-ghost">
            <Icon icon="info-square" />
          </div>
        </div>
      </a>
      <a href="https://github.com/xREMAGIx/p-r1999-gnomon" target="_blank">
        <div class="tooltip" data-tip="Github">
          <div class="btn btn-ghost">
            <Icon icon="github" />
          </div>
        </div>
      </a>
    </nav>
  </div>
  <aside class="footer footer-center bg-base-content/20 py-4 px-2 text-xs">
    Reverse:1999 Gnomon is a fanmade website and not affiliated with Bluepoch
    and Official Reverse:1999.<br />All images and data belongs to their
    respective owners.
  </aside>
</footer>

<script>
  import Alpine from "alpinejs";

  Alpine.data("footer", () => ({
    init() {
      Alpine.store("layout", {
        footer: this.$refs.footer,
      });
    },
  }));
</script>
