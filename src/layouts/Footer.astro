---
import CustomImage from "@components/CustomImage.astro";
---

<footer x-data="footer" x-ref="footer" class="border-t border-primary">
  <div
    class="footer container gap-y-4 place-items-center md:place-items-start items-center p-4"
  >
    <aside class="items-center grid-flow-col">
      <a href="/" class="flex items-center">
        <CustomImage class="mr-2 w-10" src="/layout/logo.png" alt="logo" />
        <span class="text-xl text-primary italic"> Reverse:1999 Gnomon </span>
      </a>
    </aside>
    <nav class="grid-flow-col gap-2 md:place-self-center md:justify-self-end">
      <a href="/about">
        <div class="btn btn-ghost">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-info-square"
            ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
              d="M12 9h.01"></path><path
              d="M3 5a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14z"
            ></path><path d="M11 12h1v4h1"></path></svg
          >
        </div>
      </a>
      <a href="https://github.com/xREMAGIx/p-r1999-gnomon" target="_blank">
        <div class="btn btn-ghost">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="24"
            height="24"
            stroke-width="2"
          >
            <path
              d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5"
            ></path>
          </svg>
        </div>
      </a>
    </nav>
  </div>
  <aside class="footer footer-center bg-base-content/20 py-4 px-2 text-xs">
    Reverse:1999 Gnomon is a fanmade website and not affiliated with Bluepoch
    and Official Reverse:1999.<br />All images and data belongs to their
    respective owners.
  </aside>
</footer>

<script>
  import Alpine from "alpinejs";

  Alpine.data("footer", () => ({
    init() {
      Alpine.store("layout", {
        footer: this.$refs.footer,
      });
    },
  }));
</script>
