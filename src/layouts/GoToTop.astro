---
import Icon from "@components/Icon.astro";

interface Props {}

const {} = Astro.props;
---

<div x-data="goToTop" @scroll.window="handleScroll">
  <button
    x-show="isShow"
    x-cloak
    x-transition
    @click="handleScrollToTop"
    x-ref="goToTop"
    class="fixed bottom-4 right-4 btn btn-primary rounded-full text-white p-0 z-40 w-10 h-10 min-h-min"
  >
    <Icon icon="chevron-up" />
  </button>
</div>

<script>
  import Alpine from "alpinejs";
  Alpine.data("goToTop", () => ({
    isShow: false,

    handleScroll() {
      this.isShow = window.scrollY > 200;

      const footStartPos =
        this.$store.layout.footer?.getBoundingClientRect().y ?? 0;

      if (window.innerHeight >= footStartPos) {
        this.$refs.goToTop.style.bottom = `${(window.innerHeight - footStartPos + 16) / 16}rem`;
      } else {
        this.$refs.goToTop.style.removeProperty("bottom");
      }
    },

    handleScrollToTop() {
      window.scrollTo({ top: 0, behavior: "smooth" });
      this.isShow = false;
    },
  }));
</script>
